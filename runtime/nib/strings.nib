# Owned strings (section 13): building, joining and comparing them, and
# copying a view into one.

import buffers

# `text` with `count` more bytes after it; it may move.
pub fn append_bytes(text: *near mut u8, bytes: *far u8, count: u16) -> *near mut u8:
    unsafe:
        let length = *buffers.length(text)
        let grown = buffers.reserve(text, length + count, 1)
        buffers.copy(grown.offset(length), bytes, count)
        *buffers.length(grown) = length + count
        grown[length + count] = 0
        return grown

@export(name="N$TAPP")
fn append(text: *near mut u8, more: *near mut u8) -> *near mut u8:
    unsafe:
        return append_bytes(text, more.far(), *buffers.length(more))

@export(name="N$TCAT")
fn concat(left: *near mut u8, right: *near mut u8) -> *near mut u8:
    unsafe:
        let length = *buffers.length(left)
        let joined = buffers.allocate(length + *buffers.length(right), 1)
        buffers.copy(joined, left.far(), length)
        *buffers.length(joined) = length
        return append(joined, right)

# An owned copy of a `&string` view.
@export(name="N$VCPY")
fn view_copy(text: &string) -> *near mut u8:
    let copy = buffers.allocate(text.len, 1)
    unsafe:
        let data: *far char = &text
        buffers.copy(copy, data.cast[u8](), text.len)
        copy[text.len] = 0
        *buffers.length(copy) = text.len
    return copy

# -1, 0 or 1 as `left` sorts before, with or after `right`, byte by byte.
# Owned strings are compared through views of them.
@export(name="N$VCMP")
fn compare(left: &string, right: &string) -> i8:
    let shorter = left.len < right.len ? left.len : right.len
    unsafe:
        let first: *far char = &left
        let second: *far char = &right
        for at in 0..shorter:
            if first[at] != second[at]:
                return first[at] < second[at] ? -1 : 1
    if left.len == right.len:
        return 0
    return left.len < right.len ? -1 : 1
