# A dict's slots (section 13): a vec's descriptor whose length word counts
# the slots, a power of two, and whose capacity word the entries. A slot is
# `size` bytes, its hash first; a zero hash marks it free.

import buffers

# `table` with room for one more entry, at most three quarters full: a
# new table of twice the slots, each entry moved by its stored hash.
@export(name="N$DRES")
fn reserve(table: *near mut u8, size: u16) -> *near mut u8:
    unsafe:
        let slots = *buffers.length(table)
        let count = *buffers.capacity(table)
        if (count + 1) * 4 <= slots * 3:
            return table
        let grown: u16 = slots < 8 ? 8 : slots * 2
        let mask = grown - 1
        let copy = buffers.allocate(grown, size)
        for at in range(0, grown * size):
            copy[at] = 0
        for slot in range(0, slots):
            let entry = table.offset(slot * size)
            let hash = *entry.cast[u16]()
            if hash == 0:
                continue
            let mut at = hash & mask
            while *copy.offset(at * size).cast[u16]() != 0:
                at = (at + 1) & mask
            buffers.copy(copy.offset(at * size), entry.far(), size)
        *buffers.length(copy) = grown
        *buffers.capacity(copy) = count
        buffers.drop(table)
        return copy
