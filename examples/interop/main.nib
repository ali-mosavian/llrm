# flags: -O2 --cpu 486 | -O2 --cpu 486 --target x86-code32
# link: geometry.c
# Calls a C library through the target's C convention ("c": cdecl16 or cdecl32), and exports the
# rule it calls back. The arrays are static: a near pointer reaches only static data on code16.

@repr("c", pack=1)
struct CPoint:
    x: i16
    y: i16

@extern("c")
fn checksum(data: *u8, count: u16) -> u16
@extern("c")
fn weighted_sum(values: *i16, count: u16) -> i32
@extern("c")
fn centroid(points: *CPoint, count: u16, out: *mut CPoint) -> void

@export("c")
fn weight(value: i16) -> i16:
    if value < 0:
        return -value * 3
    return value

var bytes: u8[4] = [0x51, 0x42, 0x2A, 0x07]
var samples: i16[5] = [3, -1, 4, -1, 5]
var corners: CPoint[3] = [CPoint(x=0, y=0), CPoint(x=30, y=6), CPoint(x=6, y=30)]
var middle: CPoint = CPoint(x=0, y=0)

fn main() -> i16:
    unsafe:
        print(f"checksum {checksum(&bytes, 4)}")
        print(f"weighted {weighted_sum(&samples, 5)}")
        centroid(&corners, 3, &mut middle)
    print(f"centroid {middle.x},{middle.y}")
    return 0
