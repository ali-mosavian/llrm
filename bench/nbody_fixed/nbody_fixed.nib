# Six-body Q9 fixed-point integrator, 1000 steps; plain i32. Nib has no truncating
# integer divide ('//' floors), so tdiv() truncates toward zero as BASIC and C do.
const BODIES: i32 = 6
const ONE: i32 = 512

var pos_x: i32[6] = [0, 0, 0, 0, 0, 0]
var pos_y: i32[6] = [0, 0, 0, 0, 0, 0]
var vel_x: i32[6] = [0, 0, 0, 0, 0, 0]
var vel_y: i32[6] = [0, 0, 0, 0, 0, 0]

fn tdiv(a: i32, b: i32) -> i32:
    return (a - a % b) // b

fn bench_nbody_fixed() -> i32:
    for body in 0..BODIES:
        pos_x[body] = (body * 7 - 15) * ONE
        pos_y[body] = (body * 5 - 12) * ONE
        vel_x[body] = 0
        vel_y[body] = 0
    for _step in 0..1000:
        for body in 0..BODIES:
            let mut acc_x: i32 = 0
            let mut acc_y: i32 = 0
            for other in 0..BODIES:
                if other != body:
                    let delta_x = pos_x[other] - pos_x[body]
                    let delta_y = pos_y[other] - pos_y[body]
                    let dist2 = delta_x * delta_x + delta_y * delta_y + ONE * ONE
                    let falloff = tdiv(ONE, tdiv(dist2, ONE * ONE) + 1)
                    acc_x += tdiv(delta_x * falloff, ONE)
                    acc_y += tdiv(delta_y * falloff, ONE)
            vel_x[body] += acc_x
            vel_y[body] += acc_y
            vel_x[body] -= tdiv(vel_x[body], 16)
            vel_y[body] -= tdiv(vel_y[body], 16)
        for body in 0..BODIES:
            pos_x[body] += vel_x[body]
            pos_y[body] += vel_y[body]
    let mut sum: i32 = 0
    for body in 0..BODIES:
        sum += (body + 1) * (pos_x[body] + 3 * pos_y[body] + 5 * vel_x[body] + 7 * vel_y[body])
    return sum

fn main() -> i16:
    print(bench_nbody_fixed())
    return 0
