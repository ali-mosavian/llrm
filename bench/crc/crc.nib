fn bench_crc(salt: u32) -> u32:
    let data: u8[9] = [49, 50, 51, 52, 53, 54, 55, 56, 57]
    let mut crc: u32 = 4294967295 ^ salt
    for i in 0..9:
        crc ^= data[i]
        for bit in 0..8:
            crc = (crc >> 1) ^ (3988292384 & (0 - (crc & 1)))
    return crc ^ 4294967295

fn main() -> i16:
    print(i32(bench_crc(0)))
    return 0
