# Same algorithm as bintree.c.

fn insert(t: &mut [i16], at: i16, node: i16) -> void:
    let mut side: i16 = 2
    if t[3 * node] < t[3 * at]:
        side = 1
    if t[3 * at + side] == 0:
        t[3 * at + side] = node
    else:
        insert(t, t[3 * at + side], node)

fn walk(t: &[i16], at: i16, depth: i16) -> i32:
    if at == 0:
        return 0
    return walk(t, t[3 * at + 1], depth + 1) + i32(t[3 * at]) * i32(depth) + walk(t, t[3 * at + 2], depth + 1)

fn bench_bintree(seed: u16) -> i32:
    let mut t: i16[903] = [0] * 903
    let mut x: u32 = u32(seed)
    for i in 1..301:
        x = (x * 25173 + 13849) & 0xFFFF
        t[3 * i] = i16(x & 0xFFF)
        if i > 1:
            insert(t, 1, i)
    return walk(t, 1, 1)

fn main() -> i16:
    print(bench_bintree(1))
    return 0
