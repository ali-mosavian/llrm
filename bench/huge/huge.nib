# 200x201 i16 array (80400 bytes) in huge memory; mirrors huge.c.
huge var h: i16[200, 201] = [[0] * 201] * 200

fn bench_huge() -> i32:
    let mut t: i32 = 0
    for r in 0..200:
        for c in 0..201:
            h[r, c] = i16((i32(r) * 201 + i32(c)) % 251)
    for r in 0..200:
        for c in 0..201:
            t += i32(h[r, c])
    return t

fn main() -> i16:
    print(bench_huge())
    return 0
