# targets: x86-code16   (writes the text screen at B800:0000, a real-mode segment address)
# Text screen at B800:0000 through a far pointer.

fn fill(ch: i16, at: i16) -> void:
    unsafe:
        let screen: *far mut u8 = 0xB8000000
        let mut o: i16 = 0
        while o <= 3998:
            screen[o] = ch + (o & 15)
            screen[o + 1] = at
            o += 2

fn checksum() -> i32:
    let mut s: i32 = 0
    unsafe:
        let screen: *far u8 = 0xB8000000
        for o in 0..4000:
            s += screen[o]
    return s

fn bench_textfill() -> i32:
    fill(65, 31)
    return checksum()

fn main() -> i16:
    print(bench_textfill())
    return 0
