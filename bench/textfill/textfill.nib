# Text screen through a pointer the OS layer makes of the machine's physical address.
import os

fn fill(ch: i16, at: i16) -> void:
    unsafe:
        let screen = os.text_screen()
        let mut o: i16 = 0
        while o <= 3998:
            screen[o] = ch + (o & 15)
            screen[o + 1] = at
            o += 2

fn checksum() -> i32:
    let mut s: i32 = 0
    unsafe:
        let screen = os.text_screen()
        for o in 0..4000:
            s += screen[o]
    return s

fn bench_textfill() -> i32:
    fill(65, 31)
    return checksum()

fn main() -> i16:
    print(bench_textfill())
    return 0
