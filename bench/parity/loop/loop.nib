# Parity kernel; i16 parameters by value (the C original passes pointers).
fn parity_loop(count: i16, seed: i16) -> i32:
    let mut total: i32 = i32(seed)
    let mut index: i16 = 0
    while index < count:
        total += i32(index) * i32(seed) + 3
        index += 1
    return total

fn bench_loop() -> i32:
    return parity_loop(7, 5) * 1000 + parity_loop(4, -3)

fn main() -> i16:
    print(bench_loop())
    return 0
