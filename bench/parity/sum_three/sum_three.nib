fn sum_three(first: &[i16], second: &[i16], third: &[i16]) -> i16:
    let mut total: i16 = 0
    # Unchecked: the loop's codegen is what the tests measure.
    for index in 0..first.len:
        unsafe:
            total += first[index]
            total += second[index]
            total += third[index]
    return total

fn bench_sum_three() -> i16:
    let first: i16[4] = [1, 2, 3, 4]
    let second: i16[4] = [10, 20, 30, 40]
    let third: i16[4] = [100, 200, 300, 400]
    return sum_three(&first, &second, &third)

fn main() -> i16:
    print(bench_sum_three())
    return 0
