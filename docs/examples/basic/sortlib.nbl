# A library for a QuickBASIC 4.5 program, scores.bas: it sorts BASIC's own
# INTEGER array, upper-cases a BASIC string in place, and returns a DOUBLE,
# an INTEGER of a 2-D array and a string, calling back into BASIC for one.
# Indexing is unchecked, in `unsafe:`: a check's panic is the Nib
# runtime's, which a library for BASIC does not have.

import abi.qb45 as qb

export "qb45":
    # SUB SortScores (scores() AS INTEGER, count AS INTEGER): the first
    # `count` scores, highest first.
    fn SortScores(scores: qb.ArrayRef[i16], count: qb.Ref[i16]) -> void:
        let n = u16(count)
        let mut i: u16 = 1
        while i < n:
            unsafe:
                let score = scores[i]
                let mut j = i
                while j > 0 && scores[j - 1] < score:
                    scores[j] = scores[j - 1]
                    j -= 1
                scores[j] = score
            i += 1

    # SUB Upper (text$)
    fn Upper(text: qb.StringRef) -> void:
        let mut at: u16 = 0
        while at < text.len:
            unsafe:
                let c = text[at]
                if 'a' <= c <= 'z':
                    text[at] = char(u8(c) - 32)
            at += 1

    # FUNCTION Average# (scores() AS INTEGER, count AS INTEGER): the mean of
    # the first `count` scores, which scores.bas's own Mean# divides out.
    fn Average(scores: qb.ArrayRef[i16], count: qb.Ref[i16]) -> f64:
        let mut total: i16 = 0
        let mut n = count
        let mut i: u16 = 0
        while i < u16(n):
            unsafe:
                total += scores[i]
            i += 1
        unsafe:
            return Mean(&mut total, &mut n)

    # FUNCTION RowTotal% (grid() AS INTEGER, row AS INTEGER): the sum of a
    # row of a 2-D array, 0 being its first. BASIC's first subscript varies
    # fastest, so the view's first index is BASIC's last.
    fn RowTotal(grid: qb.ArrayRef[i16, 2], row: qb.Ref[i16]) -> i16:
        let mut total: i16 = 0
        let mut column: u16 = 0
        while column < grid.dim[0]:
            unsafe:
                total += grid[column, u16(row)]
            column += 1
        return total

    # FUNCTION Initials$ (person$): the first letters of its first two words.
    fn Initials(person: qb.StringRef) -> &string:
        let mut letters: char[2] = ['?', '?']
        let mut count: u16 = 0
        let mut start = true
        for letter in person:
            if letter == ' ':
                start = true
            else:
                if start && count < 2:
                    unsafe:
                        letters[count] = letter
                    count += 1
                start = false
        return &letters

# scores.bas's own FUNCTION Mean# (total AS INTEGER, count AS INTEGER).
extern "qb45":
    fn Mean(total: qb.Ref[i16], count: qb.Ref[i16]) -> f64
