diff --git a/crates/opt/llrm-transforms/src/lcssa_tests.rs b/crates/opt/llrm-transforms/src/lcssa_tests.rs
index ab90a3ae0..99ed9f53b 100644
--- a/crates/opt/llrm-transforms/src/lcssa_tests.rs
+++ b/crates/opt/llrm-transforms/src/lcssa_tests.rs
@@ -277,3 +277,53 @@ fn test_the_pass_keeps_what_the_function_returns() {
     assert!(printed(&module).contains("%carried.lcssa = phi"));
     assert_eq!(results(&module, inputs), expected);
 }
+
+/// A one-input phi in a loop exit that names a value defined outside the loop
+/// (a parameter, or a load served from before the loop) closes nothing. It
+/// stayed through every round and each pass after it carried it: 3.6% to 4.0%
+/// of the d_faces compile, with the code unchanged.
+#[test]
+fn test_an_exit_phi_of_a_value_defined_outside_the_loop_is_the_value() {
+    assert_eq!(
+        closed_once(
+            "define i16 @f(i16 %seed, i16 %n) {
+b0:
+  br label %b1
+
+b1:
+  %carried = phi i16 [ %seed, %b0 ], [ %stepped, %b2 ]
+  %more = icmp ult i16 %carried, %n
+  br i1 %more, label %b2, label %b3
+
+b2:
+  %stepped = add i16 %carried, 1
+  br label %b1
+
+b3:
+  %limit = phi i16 [ %n, %b1 ]
+  %answer = add i16 %carried, %limit
+  ret i16 %answer
+}
+"
+        ),
+        "define i16 @f(i16 %seed, i16 %n) {
+b0:
+  br label %b1
+
+b1:
+  %carried = phi i16 [ %seed, %b0 ], [ %stepped, %b2 ]
+  %more = icmp ult i16 %carried, %n
+  br i1 %more, label %b2, label %b3
+
+b2:
+  %stepped = add i16 %carried, 1
+  br label %b1
+
+b3:
+  %carried.lcssa = phi i16 [ %carried, %b1 ]
+  %answer = add i16 %carried.lcssa, %n
+  ret i16 %answer
+}
+"
+    );
+}
