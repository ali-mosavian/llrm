kind: graph
dir: right
title: What one count covers
node src "source" fill=a
node llrm "llrm-c" fill=b
node hir "HIR"
node mir "MIR passes"
node isel "isel"
node ra "regalloc"
node omf "OMF" fill=c
edge src -> llrm
edge llrm -> hir
edge hir -> mir
edge mir -> isel
edge isel -> ra
edge ra -> omf
group one "llrm-c: one process, one perf count": llrm hir mir isel ra
