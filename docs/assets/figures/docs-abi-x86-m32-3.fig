kind: lanes
title: A call and its return on x86-m32
lane c "caller"
lane f "callee"
tick 1 "push"
tick 2 "registers"
tick 3 "call"
tick 4 "enter"
tick 5 "body"
tick 6 "return"
tick 7 "after"
mark c 1 "push the arguments that\nfit no register, last first"
mark c 2 "watcall32: mov eax,a0;\nedx,a1; ebx,a2; ecx,a3"
msg c f 3 "call f" kind=call
mark f 4 "[push ebp ; mov ebp, esp]\npush saved registers used"
mark f 5 "result in EAX, EDX:EAX\nor st(0)"
msg f c 6 "pop saved registers,\n[pop ebp]; ret n (watcall32,\nn = stack bytes) or ret\n(cdecl32, sysv32)" kind=ret
mark c 7 "add esp, n\n(cdecl32, sysv32 only)"
