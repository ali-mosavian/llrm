kind: stack
title: AD descriptor of a numeric array
cell "offset" off="+0" size="2" note="data far pointer: offset" fill=a
cell "segment" off="+2" size="2" note="data far pointer: segment" fill=a
cell "link" off="+4" size="2"
cell "total size" off="+6" size="2"
cell "rank" off="+8" size="1"
cell "flags" off="+9" size="1" note="FADF_STATIC = 40h"
cell "adjusted offset" off="+0Ah" size="2"
cell "element width" off="+0Ch" size="2"
cell "(count, lower) ..." off="+0Eh" size="4" note="one 4-byte record per dimension" fill=b
