kind: stack
title: Frame of an x86-m16 far function, two word arguments, 8 bytes of locals
arrow "higher addresses" up
cell "caller's frame"
cell "b (argument 1)" off="bp+8" size="2" note="cdecl16: pushed first (right to left)"
cell "a (argument 0)" off="bp+6" size="2" note="first_argument_offset_far = 6, near = 4"
cell "return CS" off="bp+4" size="2" note="far call only" fill=a
cell "return IP" off="bp+2" size="2" fill=a
cell "caller's BP" off="bp+0" size="2" note="BP after push bp; mov bp,sp"
cell "locals, spills" off="bp-8" size="8" note="[bp-8] .. [bp-1]"
cell "saved SI" off="bp-10" size="2" note="pushed after the locals"
cell "saved DI" off="bp-12" size="2" note="SP; outgoing arguments are pushed below it at each call"
arrow "stack grows down" down
