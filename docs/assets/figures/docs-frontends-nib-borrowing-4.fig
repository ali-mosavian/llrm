kind: lanes
title: A change of c while an exclusive borrow is used later
lane c "c (owner)"
lane m "m = &mut c"
tick 9 "let m = &mut c"
tick 10 "c.inc()"
tick 11 "m.inc()"
span c 9 11 "owner" kind=owner
span m 9 11 "exclusive borrow: opens, last use closes" kind=mut
mark c 10 "refused: m is used later" kind=error
