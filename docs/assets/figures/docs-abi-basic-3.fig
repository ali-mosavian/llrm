kind: lanes
title: A BASIC procedure call through the runtime
lane c "caller"
lane p "PROC"
lane r "runtime"
tick 1 "push args"
tick 2 "call"
tick 3 "enter"
tick 4 "frame built"
tick 5 "body"
tick 6 "leave"
tick 7 "restored"
tick 8 "return"
mark c 1 "push &arg0 ... &argN-1"
msg c p 2 "call far PROC" kind=call
msg p r 3 "call far B$ENRA\n(CX = locals)" kind=call
msg r p 4 "build frame,\nzero locals" kind=ret
mark p 5 "body"
msg p r 6 "call far B$EXSA" kind=call
msg r p 7 "restore SI DI BP" kind=ret
msg p c 8 "retf n" kind=ret
mark c 8 "nothing to pop" kind=ok
