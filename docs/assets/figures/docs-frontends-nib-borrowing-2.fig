kind: lanes
title: A change while a shared borrow is used later
lane v "v (owner)"
lane r "r = &v[0]"
tick 3 "let r = &v[0]"
tick 4 "v.push(3)"
tick 5 "print(r)"
span v 3 5 "owner" kind=owner
span r 3 5 "shared borrow: opens, last use closes" kind=shared
mark v 4 "refused: r is used later" kind=error
