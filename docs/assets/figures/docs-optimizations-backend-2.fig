kind: graph
dir: down
title: The cheaper decision and the second layout
node st "staged(hole=0)"
node ch "cheaper\nbelow -Omax: directed" fill=b
node al "allocator alone\ntraffic >= 0.5%?"
node sp "spiller route\nkeep the cheaper\n(clocks, or bytes at -Os)"
node fl "first layout"
node rl "relayout::laid_again\n(second-frame.md)"
node keep "keep the layout with\nfewer far operands" fill=c
edge st -> ch
edge ch -> al
edge al -> sp "yes"
edge al -> fl "no: keep it"
edge sp -> fl
edge fl -> rl "far frame operands\nand a spill area"
edge rl -> keep
