kind: stack
title: Frame of an interrupt16 handler, offsets from the frame pointer, lowest first
cell "GS" off="0" size="2"
cell "FS" off="2" size="2"
cell "ES" off="4" size="2"
cell "DS" off="6" size="2"
cell "EDI" off="8" size="4" note="EDI lowest"
cell "ESI" off="12" size="4"
cell "EBP" off="16" size="4"
cell "ESP" off="20" size="4"
cell "EBX" off="24" size="4"
cell "EDX" off="28" size="4"
cell "ECX" off="32" size="4"
cell "EAX" off="36" size="4"
cell "IP" off="40" size="2" fill=a
cell "CS" off="42" size="2" fill=a
cell "flags" off="44" size="2" fill=a
cell "caller of the interrupted code" off="46"
bracket "popad's image" from=5 to=12
bracket "pushed by the interrupt" from=13 to=15
