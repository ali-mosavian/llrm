kind: graph
dir: right
title: Debug information from frontend to writers
node fe "Frontends\nllrm-c, llrm-nib, llrm-qb:\nHIR debug Builder" fill=a
node mir "MIR\n!types !functions !globals\n#dbg_declare\n#dbg_value/_piece/_gone\nlines"
node be "Backend\ndebuginfo::described\n(types, procedures)\nvaluetrack (ranges)\ncfi (frame rows)\ndebuginfo::laid_out\n-> debug::Info" fill=b
node dw "llrm-dwarf\n.debug_*\nELF, Mach-O,\nOMF (-gdwarf)" fill=c
node co "llrm-coff\nC13\nCOFF" fill=c
node om "llrm-omf\nCV4 / TD\nOMF" fill=c
edge fe -> mir
edge mir -> be
edge be -> dw
edge be -> co
edge be -> om
