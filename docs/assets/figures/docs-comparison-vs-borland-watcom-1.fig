kind: graph
dir: down
title: One C source through llrm-c, Borland C and Open Watcom, counted by the same emulator
node src "bench/NAME/NAME.c" fill=a
node llrm "llrm-c -O2 or -Os\n-fno-inline-functions\nllrm's own link" fill=b
node bcc "bcc.sh in DOSBox-X\nbcc / tcc -mm, 8087\njwlink + that toolchain's\nC0M, CM, FP87, MATHM" fill=c
node ow "bwcc (host)\nOpen Watcom -mm -4 -fpi87\njwlink + OW's CLIBM,\nMATH87M, NOEMU87" fill=d
node run "real-mode unicorn\ncrates/target/llrm-x86-m16\n/bench/icount.py\ncounts bench_NAME: entry to\nreturn, runtime calls included" fill=e
node ins "instructions, memory ops\n-> bench/NAME/expected.toml"
node clk "486 clocks (estimate)\nnot gated"
node siz "sizes.py: code, data,\nbss of the program's OBJ"
node tm "with --time: RDTSC in\nDOSBox-X -> kernel_ms"
edge src -> llrm
edge src -> bcc
edge src -> ow
edge llrm -> run "OBJ"
edge bcc -> run "OBJ"
edge ow -> run "OBJ"
edge run -> ins
edge run -> clk
edge run -> siz
edge ins ..> tm
