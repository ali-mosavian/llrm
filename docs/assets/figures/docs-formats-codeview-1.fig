kind: graph
dir: right
title: Two CodeView dialects of debug::Info
node info "debug::Info" fill=a
node cv4 "cv4.rs\nC7-era CodeView 4:\nC, Nib, QB default" fill=b
node bc "cvwrite.rs\nBC's pre-link layout:\nllrm-qb --bc-codeview" fill=b
node cv4i "cv4info.rs"
node cvi "cvinfo.rs"
edge info -> cv4 "dialect Cv4"
edge info -> bc "dialect Bc"
edge cv4 ..> cv4i "read back"
edge bc ..> cvi "read back"
