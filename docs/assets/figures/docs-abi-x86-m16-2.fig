kind: lanes
title: A call and its return on x86-m16
lane c "caller"
lane f "callee"
tick 1 "push"
tick 2 "registers"
tick 3 "call"
tick 4 "enter"
tick 5 "body"
tick 6 "return"
tick 7 "after"
mark c 1 "push arg(n-1) ... push arg0\n(cdecl16, ia16, regparm3's\nstack)"
mark c 2 "load argument registers\n(regparm3, watcall16)"
msg c f 3 "call far ptr f" kind=call
mark f 4 "push bp ; mov bp, sp\nsub sp, locals\npush si ; push di (those used)"
mark f 5 "result in AX, DX:AX\nor st(0)"
msg f c 6 "pop di ; pop si ;\nleave | pop bp ;\nretf (cdecl16, ia16,\nregparm3) or retf n\n(pascal16, watcall16)" kind=ret
mark c 7 "add sp, 2*words\n(caller pops: cdecl16,\nia16, regparm3);\nuse AX / DX:AX / st(0)"
