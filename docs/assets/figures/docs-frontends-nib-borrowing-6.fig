kind: lanes
title: h.r = &b stores a Scope(1) root in a Scope(0) holder
lane h "h  Scope(0)"
lane b "b  Scope(1)"
tick 1 "let mut h"
tick 2 "let b (block depth 1)"
tick 3 "h.r = &b"
tick 4 "block ends"
tick 5 "print(h.r)"
span h 1 5 "h lives" kind=owner
span b 2 4 "b lives" kind=owner
mark h 3 "refused: h would outlive b" kind=error
