kind: graph
dir: down
title: Fixed, the passes that run on one body
node sroa "sroa"
node round "One round\nfold ports decide phiopt\nequalcalls tailrec\nloopsimplify lcssa floatloop\nhoist loopmotion\ntrivialunswitch inferspace\ndse gvn promote indvars\nalgebraic dead fill" fill=b
node unroll "unroll\n(a copy goes back\nthrough sroa)"
node chg "changed?" shape=round
node peel "peel\n(repeat while loops drop)"
node unsw "unswitch (-O3)"
node uj "unroll-jam (-O3)"
node merge "merge"
edge sroa -> round
edge round -> unroll "after the round"
edge unroll -> chg
edge chg -> round "yes: next round"
edge chg -> peel "no"
edge peel -> unsw
edge unsw -> uj
edge uj -> merge
