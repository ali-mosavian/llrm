kind: graph
dir: down
title: What a body edit costs the next consumer of Summaries
node edit "pass edits body f\nchanged(f) / body_edited(f)\nModuleAnalyses.edited += f" fill=a
node ask "next consumer asks\nget::<Summaries>()"
node held "result held?"
node drop "dropped result,\nkind.unchanged()?"
node reuse "reuse" fill=c
node run "run()\ndirty = bodies whose mark differs\nfrom the memo's (+ declarations\nthat differ by value)" fill=b
node upd "alias::summaries_updating\n(procedures, known, memo, dirty)"
node clo "closure = dirty + every body that\nreads them through calls\n(+ all entries' callbacks if an\nentry is in it)\nrestarts from its direct summary;\nthe rest is kept" fill=d
edge edit -> ask
edge ask -> held
edge held -> reuse "yes"
edge held -> drop "no"
edge drop -> reuse "yes"
edge drop -> run "no"
edge run -> upd
edge upd -> clo
