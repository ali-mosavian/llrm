kind: graph
dir: down
title: From Info to the Turbo Debugger table
node info "Info" fill=a
node rec "COMENT records\nclass 0xE1..0xEA, among\nthe object's own"
node tl "TLINK /v"
node exe "EXE + Turbo Debugger\ntable" fill=b
node td "TD (DOSBox-X)"
node dump "TDUMP\nprints the table"
edge info -> rec "td::records"
edge rec -> tl
edge tl -> exe
edge exe -> td
edge exe ..> dump
