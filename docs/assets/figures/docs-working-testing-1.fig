kind: graph
dir: down
title: What the gate runs for a diff, and what executes the program under test
node gate "gate.py plan/run\n(tools/gate, tiers.toml)\npicks steps from the diff" fill=a
node cheap "cheap steps, every diff\nbuild: cargo check/test\n  --no-run\nlib, doc: unit tests, doctests\ncrate-tests, integration\n  (tests/*.rs)\nscans: source-text ratchets\nrun: tests/run in DOSBox\npytest: tools/, crates/,\n  tests/*.py\nbench, torture, fmt" fill=b
node heavy "heavy steps, when owner\npaths change\nturbo, cv4: Turbo Debugger,\n  CodeView\nidentity: compiler vs itself\nqcport: QCport vs Borland\ndos-slow: demos, graphics\n  sweeps\npytest-programs, measure,\n  rfmt-post" fill=c
node host "host\nunit tests, llrm-mir\ninterpreter, unicorn\n(bench counts)" fill=d
node dosbox "DOSBox-X fork\ntools/dosbatch: one launch\nbuilds and runs many programs" fill=d
node ref "reference tools\nTurbo Debugger, CodeView,\nBC, Borland C, gcc, clang,\ngdb" fill=d
edge gate -> cheap
edge gate -> heavy
edge cheap -> host
edge cheap -> dosbox
edge heavy -> dosbox
edge heavy -> ref
