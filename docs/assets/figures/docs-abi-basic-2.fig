kind: stack
title: Frame B$ENRA builds (llrm runtime, 16-bit)
arrow "higher addresses" up
cell "arguments"
cell "return CS" off="bp+4" size="2" fill=a
cell "return IP" off="bp+2" size="2" fill=a
cell "caller's BP" off="bp+0" size="2" note="BP points here"
cell "previous BASIC frame" off="bp-2" size="2" note="b$curframe chain"
cell "SI" off="bp-4" size="2"
cell "DI" off="bp-6" size="2"
cell "bytes of locals" off="bp-8" size="2"
cell "GOSUB count" off="bp-10" size="2" note="header ends: FR_SIZE = 10"
cell "locals, zeroed" off="bp-12" note="SP at the bottom"
gap "..."
arrow "lower addresses" down
bracket "runtime header" from=5 to=9
