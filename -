.386
.model flat

public _bench_fib
public _main
.data
extern _report:near
.code FIB_TEXT
_fib proc near
    sub esp, 12
    push ecx
L0_0:
    mov ecx, dword ptr [esp+20]
    xor eax, eax
    mov dword ptr [esp+4], eax
    cmp ecx, 2
    jge L0_5
    jmp L0_10
L0_5:
    lea eax, [ecx-1]
    push eax
    mov dword ptr [esp+12], ecx
    call _fib
    mov ecx, dword ptr [esp+8]
    sub ecx, 2
    add dword ptr [esp+4], eax
L0_1:
    cmp ecx, 2
    jge L0_5
L0_10:
    mov eax, dword ptr [esp+4]
    add eax, ecx
    pop ecx
    add esp, 12
    ret 4
_fib endp
_bench_fib proc near
L1_0:
    push dword ptr [esp+4]
    call _fib
    ret
_bench_fib endp
_main proc near
L2_0:
    pushd 20
    call _bench_fib
    add esp, 4
    push eax
    call _report
    add esp, 4
    xor eax, eax
    ret
_main endp
end
