INIT sw=0x808000 target=0xec size=50 rev=0x23
SEG 1 attr=0x7 name="_TEXT" align=1
SEG 2 attr=0x1c name="CONST" align=2
SEG 3 attr=0xc name="CONST2" align=2
SEG 4 attr=0x6 name="_DATA" align=2
START
f1 DBSrcFile "fixtures/c/negaddr.c" main=1
- DBSrcCue f1 5 1
SYM y1 name="tick" base="tick" pattern="_*" attr=0x43 seg=1
CALLCONV y1 class=0x80 target=0x716 parms=[] ret=0:0
- CGProcDecl y1 TY_INTEGER
l2 CGLastParm
t3 CGTemp TY_INTEGER
- CGReturn n0 TY_INTEGER
- DBSrcCue f1 7 1
SYM y2 name="negated" base="negated" pattern="_*" attr=0x7 seg=1
CALLCONV y2 class=0x80 target=0x716 parms=[] ret=0:0
- CGProcDecl y2 TY_INTEGER
SYM y3 name="x" base="x" pattern="_*" attr=0x0 seg=2
- CGParmDecl y3 TY_INTEGER
l4 CGLastParm
t5 CGTemp TY_INTEGER
n6 CGFEName y3 TY_INTEGER
n7 CGUnary O_POINTS n6 TY_INTEGER
