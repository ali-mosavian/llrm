n9 CGUnary O_CONVERT n8 TY_INTEGER
n10 CGTempName t5 TY_INTEGER
n11 CGAssign n10 n9 TY_INTEGER
- CGDone n11
n12 CGTempName t5 TY_INTEGER
n13 CGUnary O_POINTS n12 TY_INTEGER
- CGReturn n13 TY_INTEGER
- DBSrcCue f1 8 1
SYM y4 name="attach" base="attach" pattern="_*" attr=0x7 seg=1
CALLCONV y4 class=0x80 target=0x716 parms=[] ret=0:0
