INIT sw=0x808000 target=0xec size=50 rev=0x13
SEG 1 attr=0x7 name="_TEXT" align=1
SEG 2 attr=0x1c name="CONST" align=2
SEG 3 attr=0xc name="CONST2" align=2
SEG 4 attr=0x6 name="_DATA" align=2
START
f1 DBSrcFile "fixtures/c/regs.c"
- DBSrcCue f1 4 1
SYM y1 name="caller" base="caller" pattern="_*" attr=0x7 seg=1
CALLCONV y1 class=0x80 target=0x716 parms=[] ret=0:0
- CGProcDecl y1 TY_INT_2
SYM y2 name="n" base="n" pattern="_*" attr=0x0 seg=2
- CGParmDecl y2 TY_INT_2
l2 CGLastParm
t3 CGTemp TY_INT_2
- DBSrcCue f1 6 1
SYM y3 name="twice" base="twice" pattern="_*" attr=0xf seg=1
CALLCONV y3 class=0x80 target=0x717 parms=[3:0] ret=3:0
n4 CGFEName y3 TY_CODE_PTR
c5 CGInitCall n4 TY_INT_2 y3
n6 CGFEName y2 TY_INT_2
n7 CGUnary O_POINTS n6 TY_INT_2
- CGAddParm c5 n7 TY_INT_2
n8 CGCall c5
n9 CGUnary O_POINTS n8 TY_INT_2
n10 CGUnary O_CONVERT n9 TY_INT_2
n11 CGTempName t3 TY_INT_2
n12 CGAssign n11 n10 TY_INT_2
- CGDone n12
- DBSrcCue f1 7 1
n13 CGTempName t3 TY_INT_2
n14 CGUnary O_POINTS n13 TY_INT_2
- CGReturn n14 TY_INT_2
STOP
FINI
