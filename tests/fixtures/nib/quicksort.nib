# Same algorithm as quicksort.c.

fn sort(a: &mut [i16], lo: i16, hi: i16) -> void:
    if lo >= hi:
        return
    let pivot: i16 = a[hi]
    let mut i: i16 = lo
    for j in lo..hi:
        if a[j] < pivot:
            let t: i16 = a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
    let t: i16 = a[i]
    a[i] = a[hi]
    a[hi] = t
    sort(a, lo, i - 1)
    sort(a, i + 1, hi)

fn bench_quicksort(seed: u16) -> i32:
    let mut values: i16[1024] = [0] * 1024
    let mut x: u32 = u32(seed)
    let mut checksum: i32 = 0
    for i in 0..1024:
        x = (x * 25173 + 13849) & 0xFFFF
        values[i] = i16(x & 0x7FFF)
    sort(values, 0, 1023)
    for i in 1..1024:
        if values[i - 1] > values[i]:
            return -1
    for i in 0..1024:
        checksum += i32(values[i]) * i32((i & 15) + 1)
    return checksum

fn main() -> i16:
    print(bench_quicksort(1))
    return 0
