# flags: -Os --cpu 486
# Fill and copy loops as programs write them: clearing and scrolling a buffer, filling a
# palette, copying rows and records, and the loops that look alike but are not one move:
# a smear, a changed value, a second store, a stride that is not the cell, a source the body
# writes. Each prints a checksum that weighs every cell by its place. Bounds are constants:
# the checks of a loop to a variable n stay in it (#470), and with one a loop is no idiom.
var a: i16[160] = [0] * 160
var b: i16[160] = [0] * 160
var c: i16[160] = [0] * 160
var pal: i16[64] = [0] * 64
var lo: i32[40] = [0] * 40
var mo: i32[40] = [0] * 40

var s8: u8[128] = [0] * 128
var d8: u8[128] = [0] * 128

fn lim(x: i16) -> i16:
    return x

fn init() -> i16:
    for i in 0..160:
        a[i] = i16(i + 1000)
        b[i] = i16(i * 3 + 1)
        c[i] = i16(i * 5 + 2)
    return 0

fn sum_a() -> i32:
    let mut s: i32 = 0
    for i in 0..160:
        s += i32(i + 1) * i32(a[i])
    return s

fn sum_b() -> i32:
    let mut s: i32 = 0
    for i in 0..160:
        s += i32(i + 1) * i32(b[i])
    return s

fn sum_c() -> i32:
    let mut s: i32 = 0
    for i in 0..160:
        s += i32(i + 1) * i32(c[i])
    return s

fn sum_pal() -> i32:
    let mut s: i32 = 0
    for i in 0..64:
        s += i32(i + 1) * i32(pal[i])
    return s

fn sum_lo() -> i32:
    let mut s: i32 = 0
    for i in 0..40:
        s += i32(i + 1) * lo[i]
    return s

fn sum_d8() -> i32:
    let mut s: i32 = 0
    for i in 0..128:
        s += i32(i + 1) * i32(d8[i])
    return s

fn clear_rows() -> i16:
    for y in 0..6:
        for x in 0..16:
            a[y * 16 + x] = 4660
    return 0

fn palette(w: i16) -> i16:
    for i in 0..64:
        pal[i] = w
    return 0

fn copy() -> i16:
    for i in 0..100:
        a[i] = b[i]
    return 0

fn scroll_up() -> i16:
    for i in 0..100:
        a[i] = a[i + 16]
    return 0

fn scroll_down() -> i16:
    let mut i: i16 = 99
    while i >= 0:
        a[i + 16] = a[i]
        i -= 1
    return 0

fn smear() -> i16:
    for i in 0..100:
        a[i + 1] = a[i]
    return 0

fn changed() -> i16:
    for i in 0..100:
        a[i] = b[i] + 1
    return 0

fn two_stores() -> i16:
    for i in 0..100:
        a[i] = b[i]
        c[i] = 0
    return 0

fn strides() -> i16:
    for i in 0..50:
        a[2 * i] = b[i]
    return 0

fn written() -> i16:
    for i in 0..100:
        b[i] = 0
        a[i] = b[i]
    return 0

fn block() -> i16:
    for y in 0..4:
        for x in 0..7:
            a[y * 16 + x] = b[y * 20 + x]
    return 0

fn copy_long() -> i16:
    for i in 0..33:
        lo[i] = mo[i]
    return 0

fn fill_long(v: i32) -> i16:
    for i in 0..33:
        lo[i] = v
    return 0

fn copy_bytes() -> i16:
    for i in 0..101:
        d8[i] = s8[i]
    return 0

fn fill_bytes(v: u8) -> i16:
    for i in 0..101:
        d8[i] = v
    return 0

fn main() -> i16:
    let ws: i16[2] = [0x1234, 0x7F01]
    for t in 0..2:
        let w: i16 = ws[t]
        let mut x: i16 = init()
        x = clear_rows()
        print(sum_a())
        for i in 0..64:
            pal[i] = -1
        x = palette(w)
        print(sum_pal())
        x = init()
        x = copy()
        print(sum_a())
        x = init()
        x = scroll_up()
        print(sum_a())
        x = init()
        x = scroll_down()
        print(sum_a())
        x = init()
        x = smear()
        print(sum_a())
        x = init()
        x = changed()
        print(sum_a())
        x = init()
        x = two_stores()
        print(sum_a() + sum_c())
        x = init()
        x = strides()
        print(sum_a())
        x = init()
        x = written()
        print(sum_a() + sum_b())
        x = init()
        x = block()
        print(sum_a())
        for i in 0..40:
            lo[i] = 0x1000 + i32(i)
            mo[i] = 0x2000 + 3 * i32(i)
        x = copy_long()
        print(sum_lo())
        for i in 0..40:
            lo[i] = -1
        x = fill_long(0x123456 + i32(w))
        print(sum_lo())
        for i in 0..128:
            s8[i] = u8((i * 7 + 3) & 255)
            d8[i] = 0
        x = copy_bytes()
        print(sum_d8())
        for i in 0..128:
            d8[i] = 255
        x = fill_bytes(u8((w & 255) ^ 0x55))
        print(sum_d8())
    return 0
