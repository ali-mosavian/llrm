# flags: -O2 --cpu 486 | -O2 --cpu 486 --target x86-code32
# A file call's count is a count, however large: 40000 bytes written and read back, each in one call.
# The result was an i16, so 40000 came back as -25536; the error is still negative.
import os

var buffer: u8[40000] = [0] * 40000

fn main() -> i16:
    for i in 0..40000:
        buffer[i] = u8(i % 251)
    let name = "COUNT.TMP\0"
    unsafe:
        let path: *far char = &name
        let out = os.create(path)
        let wrote: i32 = os.write_file(out, &buffer, 40000)
        print(wrote)
        os.close(out)
        for i in 0..40000:
            buffer[i] = 0
        let handle = os.open(path, 0)
        let got: i32 = os.read(handle, &mut buffer, 40000)
        print(got)
        os.close(handle)
        print(os.read(99, &mut buffer, 10) < 0)
    let mut check: i32 = 0
    for i in 0..40000:
        check += i32(buffer[i])
    print(check)
    return 0
