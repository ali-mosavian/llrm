# flags: -O2 -march=i486 | -Os -march=i486
# i8(f) of the edges that pass: the minimum, a fraction past it, the maximum and a fraction past that.
# The values are stored through an opaque call, so nothing folds the conversions.
var v: f64 = 0.0

@noipa
fn put(x: f64) -> void:
    v = x

fn main() -> i16:
    put(-128.0)
    print(i8(v))
    put(-128.9)
    print(i8(v))
    put(127.0)
    print(i8(v))
    put(127.9)
    print(i8(v))
    return 0
