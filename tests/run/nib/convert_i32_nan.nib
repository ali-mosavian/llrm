# flags: -O2 -march=i486 | -Os -march=i486
# i32(f) of a NaN panics. The value is stored through an opaque call, so nothing folds the conversion.
var v: f64 = 0.0

@noipa
fn put(x: f64) -> void:
    v = x

fn main() -> i16:
    print("start")
    put(0.0)
    let zero = v
    put(0.0 / zero)
    print(i32(v))
    return 0
