# flags: -O2 -march=i486 -m32
# A fixed array past 64 KB, indexed and iterated, with bounds checked against its dimension.
var table: i32[40000] = [0] * 40000

fn main() -> i16:
    for i in 0..40000:
        table[i] = i32(i) * 2
    let mut sum: i32 = 0
    for i in 0..40000:
        sum += table[i]
    print(sum)
    print(table[39999])
    let mut inner: u8[70000] = [0] * 70000
    for i in 0..70000:
        inner[i] = u8(i % 250)
    let mut check: i32 = 0
    for i in 0..70000:
        check += i32(inner[i])
    print(check)
    return 0
