# flags: -O2 -march=i486 -m32
# A vector past 64 KB, and a string: lengths and capacities are as wide as the target's near pointer.
fn main() -> i16:
    let mut v: vec[i32] = []
    for i in 0..30000:
        v.push(i32(i))
    let mut sum: i32 = 0
    for i in 0..v.len:
        sum += v[i]
    print(v.len)
    print(sum)
    let mut s = "x"
    for i in 0..17:
        s = s + s.copy()
    print(s.len)
    return 0
