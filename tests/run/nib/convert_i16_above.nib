# flags: -O2 -march=i486 | -Os -march=i486
# i16(f) of one past the maximum panics. The value is stored through an opaque call, so nothing folds the conversion.
var v: f64 = 0.0

@noipa
fn put(x: f64) -> void:
    v = x

fn main() -> i16:
    print("start")
    put(32768.0)
    print(i16(v))
    return 0
