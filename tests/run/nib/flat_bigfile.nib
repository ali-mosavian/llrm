# flags: -O2 --cpu 486 --target x86-code32
# A file past 64 KB through os.write_file and os.read: one call each.
import os

var buffer: u8[100000] = [0] * 100000
var back: u8[100000] = [0] * 100000

fn main() -> i16:
    for i in 0..100000:
        buffer[i] = u8(i % 251)
    let name = "BIGFILE.TMP\0"
    unsafe:
        let path: *near char = &name
        let out = os.create(path)
        print(os.write_file(out, &buffer, 100000))
        print(os.close(out) >= 0)
        let handle = os.open(path, 0)
        print(os.read(handle, &mut back, 100000))
        print(os.close(handle) >= 0)
    unsafe:
        print(os.read(99, &mut back, 10) < 0)
    let mut same = true
    for i in 0..100000:
        if back[i] != buffer[i]:
            same = false
    print(same)
    return 0
