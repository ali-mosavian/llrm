# flags: -O2 -march=i486 | -Os -march=i486
# u32(f) of the edges that pass: the minimum, a fraction past it, the maximum and a fraction past that.
# The values are stored through an opaque call, so nothing folds the conversions.
var v: f64 = 0.0

@noipa
fn put(x: f64) -> void:
    v = x

fn main() -> i16:
    put(0.0)
    print(u32(v))
    put(-0.9)
    print(u32(v))
    put(4294967295.0)
    print(u32(v))
    put(4294967295.9)
    print(u32(v))
    return 0
