' flags: -O1 | -O2 | -Os
' A DATA item or a literal that looks like an integer but exceeds LONG is a double.
DATA 123456789012345, 2147483648, -2147483649, 32768, 99999999999999999999
DIM x AS DOUBLE
FOR i% = 1 TO 5
  READ x
  PRINT x
NEXT
PRINT 123456789012345# - 123456789012344#
y# = 2147483648
PRINT y#
z = 123456789012
PRINT z
PRINT 2147483648
PRINT 123456789012
PRINT 1234567890123456
PRINT 99999999999999999999
