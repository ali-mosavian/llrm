' SINGLE and DOUBLE through PRINT and STR$: digits, rounding, E and D form.
DEFDBL D
DEFSNG S
DIM s AS SINGLE, d AS DOUBLE
PRINT 1!; 1.5!; -2.25!; .1!; 100!; 1E+10!; 1E-10!; 123456.7!
PRINT 1.0000001!; 16777216!; 3.14159265!; 1E+38!; 1E-38!
PRINT 0#; 1#; .1#; 1# / 3#; 2# / 3#; 62.5#; 1E+15#; 1E+16#; 1E-5#
PRINT 123456789012345#; 1234567890123456#; 12345678901234567#
PRINT .000123456789#; 1.23456789012345678#; 1E+100#; 1E-100#
PRINT STR$(2.5!); STR$(-7.125#); STR$(1E+21#); STR$(1E-21#)
s = 22 / 7: d = 22 / 7
PRINT s; d; s * 2; d * 2
FOR i% = 1 TO 12
    d = d * 3.7# + i%
    PRINT d, d / 1000
NEXT
