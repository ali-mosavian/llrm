' RND (next, repeat, reseed), RANDOMIZE with a DOUBLE, and VAL.
PRINT RND; RND; RND(1); RND(0); RND(0)
x! = RND(-1): PRINT RND; RND; x!
x! = RND(-2.5): PRINT RND
RANDOMIZE 123.456#: PRINT RND; RND
RANDOMIZE 7: PRINT RND
RANDOMIZE -1D10: PRINT RND; RND
FOR i% = 1 TO 20: PRINT INT(RND * 6) + 1; : NEXT: PRINT
PRINT VAL("12"); VAL("  -3.5abc"); VAL("abc"); VAL(""); VAL("1E3x"); VAL("1D2")
PRINT VAL("0.1") + VAL(".2"); VAL("123456789012345678"); VAL("-.5"); VAL("+7")
PRINT VAL("&H1F"); VAL("&O17"); VAL("3 4"); VAL("2" + "5")
