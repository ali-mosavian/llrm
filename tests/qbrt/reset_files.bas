' RESET closes every open file: the data is on disk for the next OPEN
DEFINT A-Z
OPEN "STOPRST.TMP" FOR OUTPUT AS #1
PRINT #1, "kept"
OPEN "STOPRST2.TMP" FOR OUTPUT AS #2
PRINT #2, "also"
RESET
OPEN "STOPRST.TMP" FOR INPUT AS #1
LINE INPUT #1, a$
PRINT a$
OPEN "STOPRST2.TMP" FOR INPUT AS #2
LINE INPUT #2, b$
PRINT b$
CLOSE
END
