' MKDIR, CHDIR, NAME, KILL and RMDIR, and the errors each raises, against BCOM45's
DEFINT A-Z
ON ERROR GOTO h
MKDIR "QBNDIR"
MKDIR "QBNDIR"
OPEN "QBNDIR\A.TMP" FOR OUTPUT AS #1
PRINT #1, "x"
CLOSE #1
NAME "QBNDIR\A.TMP" AS "QBNDIR\B.TMP"
OPEN "QBNDIR\A.TMP" FOR INPUT AS #1
OPEN "QBNDIR\C.TMP" FOR OUTPUT AS #2
CLOSE #2
NAME "QBNDIR\C.TMP" AS "QBNDIR\B.TMP"
NAME "QBNDIR\NOSUCH" AS "QBNDIR\D.TMP"
RMDIR "QBNDIR"
KILL "QBNDIR\C.TMP"
KILL "QBNDIR\C.TMP"
KILL "QBNDIR\B.TMP"
CHDIR "QBNDIR"
CHDIR ".."
CHDIR "NOSUCH"
RMDIR "NOSUCH"
RMDIR "QBNDIR"
PRINT "done"
END
h:
PRINT "error"; ERR; "at"; ERL
RESUME NEXT
