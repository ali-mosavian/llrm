' SINGLE and DOUBLE from DATA: the decimal-to-binary conversion must round as
' BCOM45's does.
DATA .1, .2, 1.5, 3.14159265358979, 1E10, 1.0E-5, 123456789.123456789
DATA 2.5E-300, 4.9E+300, .3333333333333333333, 100, 0.7
DATA 1D2, 5.5D-3, 33333.33333333333333
FOR i% = 1 TO 12
    READ s!
    PRINT s!
NEXT
RESTORE
FOR i% = 1 TO 15
    READ d#
    PRINT d#
NEXT
RESTORE digits
FOR i% = 1 TO 8
    READ d#
    PRINT d#
NEXT
digits:
DATA 33333.33333333333333, 0.12345678901234567890123, 1234567890123456789012.0, 1.5E300
DATA 99999999999999999999.0, 18446744073709551615.0, 18446744073709551616.0, 0.000000000000000000000001
