' FILEATTR(n, 1) is the open mode (INPUT 1, OUTPUT 2, APPEND 8, BINARY 32); (n, 2) is a DOS handle; a closed file, error 52; a bad field, 5
DEFINT A-Z
ON ERROR GOTO h
OPEN "QBATTR.TMP" FOR OUTPUT AS #1
PRINT FILEATTR(1, 1); FILEATTR(1, 2) > 4
CLOSE #1
OPEN "QBATTR.TMP" FOR APPEND AS #1
PRINT FILEATTR(1, 1)
CLOSE #1
OPEN "QBATTR.TMP" FOR INPUT AS #2
PRINT FILEATTR(2, 1)
CLOSE #2
OPEN "QBATTR.TMP" FOR BINARY AS #3
PRINT FILEATTR(3, 1)
PRINT FILEATTR(3, 3)
CLOSE #3
PRINT FILEATTR(4, 1)
KILL "QBATTR.TMP"
PRINT "done"
END
h:
PRINT "error"; ERR
RESUME NEXT
