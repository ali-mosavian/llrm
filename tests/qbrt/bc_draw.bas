' DRAW: moves from the last point; B, N, scale, angle, colour, M, and the
' errors.  The picture is checked as a checksum of each screen row.
DEFINT A-Z
OPEN "L.TXT" FOR OUTPUT AS #1
SCREEN 13
PSET (20, 20), 0
DRAW "C4 R30 D20 L30 U20"
DRAW "BM60,20 C2 E10 F10 G10 H10"
DRAW "BM100,20 C5 S8 R10 D10 L10 U10"
DRAW "BM140,20 C6 S2 R20 D20 L20 U20"
DRAW "BM180,20 C7 NR10 NU10 ND10 NL10"
DRAW "BM20,60 C8 M+30,+10 M70,70 M-10,0"
DRAW "BM20,100 C9 A1 R20 D10 A2 R20 D10 A3 R20 D10 A0 R20 D10"
DRAW "BM120,100 C10 S6 A1 E10 F10 A2 G5 H5"
DRAW "BM200,100 C11 TA90 R20 TA180 R20 TA270 R20"
DRAW "BM240,100 C12 r8 d8 l8 u8; R4;D4"
DRAW "BM260,150 C3 TA0 S4 R20 D20 L20 U20 BM+10,+10 P14,3"
PRINT #1, "painted"; POINT(270, 160); POINT(250, 150)
ON ERROR GOTO oops
DRAW "Z5"
DRAW "C300"
DRAW "S0"
DRAW "A4"
DRAW "M10"
DRAW "R999999"
FOR y = 0 TO 199
  sum& = 0
  FOR x = 0 TO 319: sum& = (sum& * 31 + POINT(x, y) + 1) AND 16777215: NEXT
  PRINT #1, y; sum&
NEXT
CLOSE #1
END

oops:
  PRINT #1, "error"; ERR
  RESUME NEXT
