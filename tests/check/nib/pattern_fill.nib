# RUN: llrm-nib %s -O2 -march=i486 -S -o /dev/stdout
# A loop storing one word that no one byte repeats is `rep stosw` where the fill pays (loopidioms). The pin
# keeps a counted loop: DEVIATE, 100 words execute 12 instructions and 2 memory operands as the fill, 609
# and 201 as the loop.
# CHECK-LABEL: _main proc
# CHECK: mov ax, 4660
# CHECK: mov cx, 100
# CHECK: rep stosw
fn fill(n: u16) -> i16:
    let mut a: i16[100] = [0] * 100
    for i in 0..n:
        a[i] = 4660
    return a[5]

fn main() -> i16:
    print(fill(100))
    return 0
