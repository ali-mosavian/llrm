# RUN: llrm-nib %s -O2 -march=i486 -S -o /dev/stdout
# A loop storing one word that no one byte repeats stays a counted loop, as in the pin.
# CHECK-LABEL: _main proc
# CHECK: mov word ptr [bp+si-200], 4660
# CHECK: cmp ax, 100
# CHECK: jb
# CHECK-NOT: rep stosw
fn fill(n: u16) -> i16:
    let mut a: i16[100] = [0] * 100
    for i in 0..n:
        a[i] = 4660
    return a[5]

fn main() -> i16:
    print(fill(100))
    return 0
