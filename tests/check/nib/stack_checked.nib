# RUN: llrm-nib %s -O2 -fno-inline-functions -fsanitize=stack -S -o /dev/stdout
# -fno-inline-functions: with recursive inlining and the parameter range (0..3) from its one caller, `deep` folds to a frameless leaf.
# -fsanitize=stack: a function compares SP with the runtime's LL$STACK_LOW once its frame is allocated
# and calls the panic N$ESTK out of line, last. No other function of the module is a leaf with a
# frame within the red zone, so every one checks.
# CHECK-LABEL: _deep proc
# CHECK: cmp sp, word ptr LL$STACK_LOW
# CHECK-NEXT: jb
# CHECK: call far ptr N$ESTK
# CHECK-NEXT: _deep endp
fn deep(n: i16) -> i16:
    if n == 0:
        return 0
    return n - deep(n - 1)

fn main() -> i16:
    print(deep(3))
    return 0
