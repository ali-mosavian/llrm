# `=` in a cell: the price is in the CPU's file, machine/tune/x86/<march>.toml, which holds the rows every
# target with that CPU agrees on. Correct such a price there; a row only this target states is here.
#
# x86's CPU timings: one column a CPU, `-` where the CPU has no price for a
# form (the 386 has no `unknown`, and the others no `mov_seg_r`). Read by
# `llrm-target`; a target's mapping from these prices to its operations is
# `opcosts.txt`.
#
# Reciprocal throughput in cycles where the distinction matters. ALU and mov
# entries are solid, divide entries the roughest, K5 the least certain column.
# Where a cost depends on the operand (idiv) the figure is for a 32 bit
# register operand. Legacy approximate rankings, partly recalled from timing
# tables, not uniformly verified; audited bounds are the `smul_*` and `sdiv_*` rows below, see
# docs/measurement/timing-audit.md. Correct them in place.
#
# LEA: the 386 is 2 clocks and the 486 and later 1 (Intel's 486 table, as HelpPC 2.10's `LEA reg,mem 2+EA 3 2 1` has it; the 486 column held the 386's).
# The 386 column is Intel's 80386 table (POP m is five clocks, Jcc is 7+m taken
# and 3 not, REP MOVS is 8+4n) and GCC's i386 table for the x87 forms; its
# latencies are its clocks. x87 forms: 486 Intel's i486 data sheet, Table 10.3
# (lower bounds; memory forms at m64); P5, P6, K7 Agner Fog's instruction
# tables (P6/K7 latencies; FDIV at 64-bit precision; K7 FLDCW and FNSTCW by
# throughput); K5 AMD's K5 technical reference, Table 4-3 (last execution
# cycle); K6, which covers K6-2 and K6-III, AMD's note 21924, Table 1 (load 2
# plus FPU 2); neither AMD document gives FDIV, so K5 and K6 keep GCC's 56 plus
# the load. Core and control-word entries without a figure are the earlier
# rankings.
#
# The scalars: `issue` instructions retired a cycle; `in_order` (the 386, 486
# and P5 are); `prefix` clocks spent decoding each operand-size prefix, which
# every widened instruction carries in 16-bit code; `partial_stall` a 16 bit
# write followed by a 32 bit read of one register (P6 merges the halves, Core
# recovers most); `lcp_stall` a 66h on an instruction with an immediate,
# which stalls the decoder on P6 and Core; `pairing` the P5's U/V pairing.
#
# The CPU every frontend prices for with no -march. The one place that says so.
default_cpu           486
cpus                  386  486   P5   P6   K5   K6   K7 Core
# What gcc's -march and -mtune call each (K5 has no gcc name).
march                i386 i486 pentium pentiumpro k5 k6 athlon core2
issue                   =    =    =    =    =    =    =    =
in_order                =    =    =    =    =    =    =    =
prefix                  =    =    =    =    =    =    =    =
partial_stall           =    =    =    =    =    =    =    =
lcp_stall               =    =    =    =    =    =    =    =
# gcc's by-pieces limits for a constant memset (x86-tune-costs.h, gcc 13.4.0): stores while their count is under
# the ratio, else the CPU's stringop algorithm, `rep stos` of dwords here (i386_memset :146 is bytes, i486_memset
# :256, pentium_memset :368); `-` where gcc's algorithm is a loop or a libcall (pentiumpro_memset :588, k6_memset
# :808, athlon_memset :923, core_memset :3675) or it has no such CPU (K5), which keeps this target's own rule.
# `set_ratio` (a nonzero byte) is MOVE_RATIO through defaults.h:1330's SET_RATIO: i386_cost :202, i486_cost :312,
# pentium_cost :424; `clear_ratio` (zero) is CLEAR_RATIO: :203, :313, :425. The `_size` rows are the
# optimise-for-size path every CPU takes: i386.h:1866 MOVE_RATIO(speed false) 3, :1871 CLEAR_RATIO 2, its algorithm
# `rep stos` of bytes (ix86_size_memset :33).
set_ratio               =    =    =    -    -    -    -    -
clear_ratio             =    =    =    -    -    -    -    -
set_ratio_size          =    =    =    =    =    =    =    =
clear_ratio_size        =    =    =    =    =    =    =    =
# A switch of at least `jump_table` case values is a jump table: gcc's case_values_threshold, targhooks.cc:1846
# (4 with a `casesi` pattern, else 5); i386.md has `tablejump` (:15824) and no `casesi`, and i386.cc sets no
# TARGET_CASE_VALUES_THRESHOLD.
jump_table              =    =    =    =    =    =    =    =
# Bytes of a line of the first-level data cache, which loop interchange prices
# a walk by: the 486's 8 KB cache has 16 byte lines (Intel's i486 data sheet),
# the Pentium's, Pentium Pro's, K5's and K6's 32 (Intel and AMD's manuals), the
# Athlon's and Core 2's 64. The 386 has no cache on the chip.
cache_line              -   =    =    =    =    =    =    = 
pairing                 =    =    =    =    =    =    =    =

[clocks]
alu_rr                  =    =    =    =    =    =    =    =   # add/and/or/xor/sub/cmp reg,reg
xchg_rr                 =    =    =    =    =    =    =    =   # xchg reg,reg: the 486's is Intel's 3, not an ALU's 1
alu_ri                  =    =    =    =    =    =    =    =   # ... reg,imm
alu_rm                  =    =    =    =    =    =    =    =   # ... reg,[mem]
alu_mr                  =    =    =    =    =    =    =    =   # ... [mem],reg
mov_rr                  =    =    =    =    =    =    =    =
mov_rm                  =    =    =    =    =    =    =    =
mov_mr                  =    =    =    =    =    =    =    =
mov_ri                  =    =    =    =    =    =    =    =
shift_ri                =    =    =    =    =    =    =    =   # shl/shr/sar reg,imm
shift_r1                =    =    =    =    =    =    =    =   # the D1 form, reg,1
movzx                   =    =    =    =    =    =    =    =
setcc                   =    =    =    =    =    =    =    =   # setcc r8: 386 and 486 4 when set (Intel 240440-002); P5 onwards 1-2
cdq                     =    =    =    =    =    =    =    =
imul_r32               =    =    =     =    =    =    =    =   # 486 is 13-42, data dependent
imul_m32               =    =    =     =    =    =    =    =
idiv_r32               =    =    =    =    =    =    =    =    # the expensive one
idiv_m32               =    =    =    =    =    =    =    = 
push_r                  =    =    =    =    =    =    =    =
push_m                  =    =    =    =    =    =    =    =
push_i                  =    =    =    =    =    =    =    =
pop_r                   =    =    =    =    =    =    =    =   # POP memory is an implicit stack load and an explicit store. 486
pop_m                   =    =    =    =    =    =    =    =   # Intel's 80386 table: POP m16/m32 is five clocks, not the four-unit register form.
pop_seg                 =    3    3    =    =    =    =    =   # segment load, costly on P6+
mov_seg_r               =    3    3    =    =    =    =    =
les                     =    6    4    =    =    =    =    =
nop                     =    =    =    =    =    =    =    =
jmp_short               =    =    =    =    =    =    =    =   # predicted taken
jmp_indirect            =     =    =    =    =    =    =    =   # JMP r/m near: Intel's 80386 and i486 tables; the rest recalled, to audit
jcc                     =    =    =    =    =    =    =    =   # predicted
call_far               =    18    4   =     =    =    =   =    # real mode, no gate
ret_far                =    13    4   =     =    =    =   =    # RET imm16: the same clocks as RET, 2 bytes more.
ret_pop                =    13    4   =     =    =    =   = 
unknown                 -    =    =    =    =    =    =    =
mul_r16                =    =    =     =    =    =    =    =
div_r16                =    =    =    =    =    =    =    = 
lahf                    =    =    =    =    =    =    =    =
sahf                    =    =    2    =    =    =    =    =
lea                     =    =    =    =    =    =    =    =
rep_stos                =    =    =   =    =    =    =    = 
rep_stos_cell           =    =    =    =    =    =    =    =
rep_movs                =   =    =    =    =    =    =    =    # Intel's 80386 table: REP MOVS is 8+4n.
rep_movs_cell           =    =    =    =    =    =    =    =
mul_r32                =    =    =     =    =    =    =    =
leave                   =    =    2    =    =    =    =    =
x87_load                =    =    =    =    =    =    =    =   # GCC's i386 table: x87 loads/stores eight units, arithmetic 23/27/88. Memory arithmetic includes both components.
x87_exchange           =     =    =    =    =    =    =    =   # 80387 register exchange is eighteen clocks.
x87_store               =    =    =    =    =    =    =    =
x87_convert_store      =    =     =    =    =    =   =    = 
x87_add                =     =    =    =    =    =    =    =
x87_add_m              =     =    =    =    =    =    =    =
x87_mul                =    =     =    =    =    =    =    =
x87_mul_m              =    =     =    =   =     =    =   = 
x87_div                =    =    =    =    =    =    =    = 
x87_div_m              =    =    =    =    =    =    =    = 
# Integer memory operands (fild, fiadd, fimul, fidiv, m16/m32int): the 486 column is Intel's i486 data sheet 240440-002, Table 10.3,
# the least of each range (fild 13, fiadd m16 20, fimul m16 23, fidiv m16 85; the vsgcc harness counts the same); every other column is
# the pair the form replaces, `fild` as a load plus the operation, which favours neither: no source here states a cheaper form.
x87_load_i               =   =     =    =    =    =    =    =
x87_add_i               =    =     =    =   =     =    =    =
x87_mul_i               =    =     =    =   =     =    =   = 
x87_div_i               =    =    =    =    =    =    =    = 
x87_cmp_i               =    =     =    =   =     =    =    =
x87_control_load        =    =    =   =     =    =   =     =
x87_control_store       =    =    =    =    =    =    =    =
jcc_not_taken           =    =    =    =    =    =    =    =   # Intel's 80386 table: Jcc is 7+m taken, 3 not.

# Audited bounds of the signed multiply and divide (docs/measurement/timing-audit.md), where a CPU has them:
# the least and most clocks by operand width in bytes (`w2`, `w4`), and where the P5 prices the full product
# of a word differently (`smul_full_w2`). Read by backend/timing.rs; the divide has one figure.
smul_min_w2             =   =    =     -    -    -    -    -
smul_max_w2            =    =    =     -    -    -    -    -
smul_min_w4             =   =    =     -    -    -    -    -
smul_max_w4            =    =    =     -    -    -    -    -
smul_full_w2            -    -   =     -    -    -    -    -
# Intel 240440-002 Table 10.1 note 3: 10 + max(bits of the multiplier, n), n = 3 for a positive multiplier and 5 for a negative one.
smul_negative_bits      -    =    -    -    -    -    -    -
sdiv_w2                =    =    =     -    -    -    -    -
sdiv_w4                =    =    =     -    -    -    -    -
udiv_w2                =    =    =     -    -    -    -    -
udiv_w4                =    =    =     -    -    -    -    -

[latency]
alu_rr                  =    =    =    =    =    =    =    =   # add/and/or/xor/sub/cmp reg,reg
xchg_rr                 =    =    =    =    =    =    =    =   # xchg reg,reg: the 486's is Intel's 3, not an ALU's 1
alu_rm                  =    =    =    =    =    =    =    =   # ... reg,[mem]
alu_mr                  =    =    =    =    =    =    =    =   # ... [mem],reg
mov_rr                  =    =    =    =    =    =    =    =
mov_rm                  =    =    =    =    =    =    =    =
mov_mr                  =    =    =    =    =    =    =    =
mov_ri                  =    =    =    =    =    =    =    =
shift_ri                =    =    =    =    =    =    =    =   # shl/shr/sar reg,imm
shift_r1                =    =    =    =    =    =    =    =   # the D1 form, reg,1
movzx                   =    =    =    =    =    =    =    =
setcc                   =    =    =    =    =    =    =    =
cdq                     =    =    =    =    =    =    =    =
imul_r32               =    =    =     =    =    =    =    =   # 486 is 13-42, data dependent
imul_m32               =    =    =     =    =    =    =    =
mul_r16                =    =    =     =    =    =    =    =
idiv_r32               =    =    =    =    =    =    =    =    # the expensive one
idiv_m32               =    =    =    =    =    =    =    = 
div_r16                =    =    =    =    =    =    =    = 
push_r                  =    =    =    =    =    =    =    =
push_m                  =    =    =    =    =    =    =    =
push_i                  =    =    =    =    =    =    =    =
pop_r                   =    =    =    =    =    =    =    =   # POP memory is an implicit stack load and an explicit store. 486
pop_m                   =    =    =    =    =    =    =    =
pop_seg                 =    3    3    =    =    =    =    =   # segment load, costly on P6+
mov_seg_r               =    3    3    =    =    =    =    =
les                     =    6    4    =    =    =    =    =
nop                     =    =    =    =    =    =    =    =
jmp_short               =    =    =    =    =    =    =    =   # predicted taken
jmp_indirect            =     =    =    =    =    =    =    =   # JMP r/m near: Intel's 80386 and i486 tables; the rest recalled, to audit
jcc                     =    =    =    =    =    =    =    =   # predicted
call_far               =    18    4   =     =    =    =   =    # real mode, no gate
ret_far                =    13    4   =     =    =    =   =    # RET imm16: the same clocks as RET, 2 bytes more.
lahf                    =    =    =    =    =    =    =    =
sahf                    =    =    2    =    =    =    =    =
unknown                 -    =    =    =    =    =    =    =
alu_ri                  =    =    =    =    =    =    =    =   # ... reg,imm
ret_pop                =    13    4   =     =    =    =   = 
lea                     =    =    =    =    =    =    =    =
rep_stos                =    =    =   =    =    =    =    = 
rep_stos_cell           =    =    =    =    =    =    =    =
rep_movs                =   =    =    =    =    =    =    = 
rep_movs_cell           =    =    =    =    =    =    =    =
mul_r32                =    =    =     =    =    =    =    =
leave                   =    =    2    =    =    =    =    =
x87_load                =    =    =    =    =    =    =    =
x87_exchange           =     =    =    =    =    =    =    =
x87_store               =    =    =    =    =    =    =    =
x87_convert_store      =    =     =    =    =    =   =    = 
x87_add                =     =    =    =    =    =    =    =
x87_add_m              =     =    =    =    =    =    =    =
x87_mul                =    =     =    =    =    =    =    =
x87_mul_m              =    =     =    =   =     =    =   = 
x87_div                =    =    =    =    =    =    =    = 
x87_div_m              =    =    =    =    =    =    =    = 
# Integer memory operands (fild, fiadd, fimul, fidiv, m16/m32int): the 486 column is Intel's i486 data sheet 240440-002, Table 10.3,
# the least of each range (fild 13, fiadd m16 20, fimul m16 23, fidiv m16 85; the vsgcc harness counts the same); every other column is
# the pair the form replaces, `fild` as a load plus the operation, which favours neither: no source here states a cheaper form.
x87_load_i               =   =     =    =    =    =    =    =
x87_add_i               =    =     =    =   =     =    =    =
x87_mul_i               =    =     =    =   =     =    =   = 
x87_div_i               =    =    =    =    =    =    =    = 
x87_cmp_i               =    =     =    =   =     =    =    =
x87_control_load        =    =    =   =     =    =   =     =
x87_control_store       =    =    =    =    =    =    =    =
