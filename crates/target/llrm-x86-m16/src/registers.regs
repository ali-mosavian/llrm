# x86-m16 registers (real-mode DOS), in the format of llrm-x86-m32's registers.regs.
# Classes: gpr (a value may sit in it), byte (has 8-bit views), base and index (what a word
# address `[bx+si]` is made of), frame (the frame pointer: no value is held in it).
# Allocation order is file order. Segment registers are the machine's (machines/dos.toml).
#
# name  bits root lane classes
eax     32   eax  0    gpr,byte
ebx     32   ebx  0    gpr,byte,base
ecx     32   ecx  0    gpr,byte
edx     32   edx  0    gpr,byte
esi     32   esi  0    gpr,index
edi     32   edi  0    gpr,index
ebp     32   ebp  0    reserved,frame,base
esp     32   esp  0    reserved,stack
ax      16   eax  0    -
bx      16   ebx  0    -
cx      16   ecx  0    -
dx      16   edx  0    -
si      16   esi  0    -
di      16   edi  0    -
bp      16   ebp  0    -
sp      16   esp  0    -
al      8    eax  0    -
bl      8    ebx  0    -
cl      8    ecx  0    -
dl      8    edx  0    -
ah      8    eax  8    -
bh      8    ebx  8    -
ch      8    ecx  8    -
dh      8    edx  8    -

# The x87 stack, as llrm-x86-m32 states it: its depth is the floating values held at once.
st0     80   st0 0    x87
st1     80   st1 0    x87
st2     80   st2 0    x87
st3     80   st3 0    x87
st4     80   st4 0    x87
st5     80   st5 0    x87
st6     80   st6 0    x87
st7     80   st7 0    x87
