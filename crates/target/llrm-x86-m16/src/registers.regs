# x86-m16 registers (real-mode DOS), in the format of llrm-x86-m32's registers.regs.
# Classes: int (an integer register: the 8, 16 and 32-bit views the width tables name), gpr (a value may
# sit in it), byte (has 8-bit views), base and index (what a word
# address `[bx+si]` is made of), frame (the frame pointer: no value is held in it), positional (a position in a
# stack, st(i): an exchange of it is an effect and it is no register a pass renames or removes).
# Allocation order is file order: the registers a call destroys first (eax ecx edx ebx), the ones it keeps last (esi edi), as
# X86RegisterInfo.td lists GR32 with the callee-saved registers last. DEVIATE D-RO1: ebx comes before esi and edi, where the pin
# has it last (it is callee-saved there). The fact: this ABI destroys bx and keeps si and di, and the pin's literal order cost
# QCport -Os +511 B against -174 B for this one (65 modules). Exit: none.
# The segment registers carry the class of the address space they mean (data_segment, stack_segment, code_segment, far_segment).
#
# dwarf and codeview: the register's number in each debug format, `-` for none. CodeView's are
# CV_HREG_e (llvm's CodeViewRegisters.def). Real-mode x86 has no psABI DWARF map; the numbers are Open Watcom's
# (bld/watcom/h/dwregx86.h), which its debugger and jwlink read: the i386 ones for the 32-bit registers, then the
# x87 stack, the byte, word and segment registers in that order.
#
# @scratch: the words a pass may borrow for a moment, most preferred first (gcc's REG_ALLOC_ORDER): a
# register the result is not left in comes last.
@scratch cx dx bx ax
# @asm: the registers inline asm may name in a constraint (`{ax}`, `={dx}`): the Watcom `#pragma aux` set. No bp, sp or ah..dh
# (a register constraint names a whole value), and no segment register.
@asm al bl cl dl ax bx cx dx si di eax ebx ecx edx esi edi
#
# @bytes: the 8-bit allocation order, GR8 of X86RegisterInfo.td: the high bytes come before bl and bh.
@bytes al cl dl ah ch dh bl bh
#
# name  bits root lane classes dwarf codeview [load: the mnemonic that loads a far pointer into a segment register]
eax     32   eax  0    gpr,byte,int  0  17
ecx     32   ecx  0    gpr,byte,int  1  18
edx     32   edx  0    gpr,byte,int  2  19
ebx     32   ebx  0    gpr,byte,base,int,frame_follows  3  20
esi     32   esi  0    gpr,index,int  6  23
edi     32   edi  0    gpr,index,int  7  24
ebp     32   ebp  0    reserved,frame,base,int  5  22
esp     32   esp  0    reserved,stack,int  4  21
ax      16   eax  0    int  27  9
bx      16   ebx  0    int  28  12
cx      16   ecx  0    int  29  10
dx      16   edx  0    int  30  11
si      16   esi  0    int  31  15
di      16   edi  0    int  32  16
bp      16   ebp  0    int  33  14
sp      16   esp  0    int  34  13
al      8    eax  0    int  19  1
bl      8    ebx  0    int  21  4
cl      8    ecx  0    int  23  2
dl      8    edx  0    int  25  3
ah      8    eax  8    int  20  5
bh      8    ebx  8    int  22  8
ch      8    ecx  8    int  24  6
dh      8    edx  8    int  26  7

# The x87 stack, as llrm-x86-m32 states it: its depth is the floating values held at once.
es      16   es   0    segment,reserved,far_segment  38  25  les
cs      16   cs   0    segment,reserved,code_segment  35  26
ss      16   ss   0    segment,reserved,stack_segment  36  27
ds      16   ds   0    segment,reserved,data_segment  37  28  lds
fs      16   fs   0    segment,reserved  39  29  lfs
gs      16   gs   0    segment,reserved  40  30  lgs
st0     80   st0 0    x87,positional  11  128
st1     80   st1 0    x87,positional  12  129
st2     80   st2 0    x87,positional  13  130
st3     80   st3 0    x87,positional  14  131
st4     80   st4 0    x87,positional  15  132
st5     80   st5 0    x87,positional  16  133
st6     80   st6 0    x87,positional  17  134
st7     80   st7 0    x87,positional  18  135
# LLVM's RFP registers FP0..FP6, which greedy allocates and the stackifier maps
# to stack positions (FP7 is the stackifier's scratch). Named by iced's MM0..MM6,
# the physical x87 registers; never encoded (an assigned one becomes an st(i)).
mm0     80   mm0 0    rfp  -  -
mm1     80   mm1 0    rfp  -  -
mm2     80   mm2 0    rfp  -  -
mm3     80   mm3 0    rfp  -  -
mm4     80   mm4 0    rfp  -  -
mm5     80   mm5 0    rfp  -  -
mm6     80   mm6 0    rfp  -  -
# The return address, which a frame description's rules name as the column the caller resumes at.
eip     32   eip  0    pc  8  -
