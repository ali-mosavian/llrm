# Instruction selection: a MIR shape => the x86 forms it is. build.rs
# compiles this, with x86.instr, into isel/matcher.rs's automaton and
# emitters (see isel/generator).
#
#   pattern NAME [for mir=x86 ...]   one pattern per pair: $mir and $x86 replaced
#     match OPCODE[.TYPE](OPERAND, ...)
#                     OPCODE: a|b, `cast`, `binary`, or `*` for any.
#                     TYPE: i1 i8 i16 i32 i64 ptr far float other void, a|b, `int`.
#                     OPERAND: name, `_` or #INT, then .TYPE and :KIND
#                     (value int poison fconst const block); or
#                     name=OPCODE[.TYPE](OPERAND, ..), the instruction defining it.
#     cover NAME      that nested instruction is selected here, not where it is:
#                     a cover phase marks it before selection starts
#     group NAME      patterns of one group compete: the cheapest that holds wins
#     cost HOOK(..)   a group member's cost
#     when PRED(..), !PRED(..)
#     let NAME = CONSTRUCTOR(..)      made in order, as written
#     emit X86 DEST, .. <- SOURCE, .. [volatile]
#     call HOOK(..)   selected by hand, in matcher.rs
#     chain FIRST REST <- a, b   an operation on an integer wider than the native one, as its halves: FIRST for the
#                     lowest, REST for each above it (the same form, or the one that takes the carry)
#     refuse "why" | refuse mnemonic
#     nothing
#   end
#
# The first pattern that holds is chosen, in file order.

# A constant first operand is taken second.
commutative add and or xor mul

# An element count that is a value reserves its bytes when it runs.
pattern dynamic_alloca
  match alloca
  when dynamic
  call dynamic_alloca
end

pattern alloca
  match alloca
  nothing
end

# Selected where its reader is: see Selector::fold and its kin.
pattern selected_elsewhere
  match *
  when selected_elsewhere
  nothing
end

pattern words
  match load(p)
  when narrowed
  call words(p)
end

# What a poison store leaves may be anything, so it stays as is.
pattern poison_store
  match store(_:poison, _)
  when !volatile
  nothing
end

# x87 reads and writes only memory: a conversion only a store reads is
# stored by fisttp, fistp or fstp into the store's cell, and an integer
# load only sitofp reads is fild's cell.
pattern store_truncated
  match store(v=fptosi.i16|i32(x), p)
  when only_reader(v)
  cover v
  let c = cell(p)
  emit fisttp c <- float(x) volatile
end

pattern store_narrowed
  match store(v=fptrunc(x), p)
  when only_reader(v)
  cover v
  let c = cell(p)
  emit fstp c <- float(x) volatile
end

pattern store_float_rounded
  match store(v=fpround(x), p)
  when only_reader(v)
  cover v
  let c = cell(p)
  emit fstp c <- float(x) volatile
end

pattern store_rounded
  match store(v=call.i16|i32(x), p)
  when lrint(v), only_reader(v)
  cover v
  let c = cell(p)
  emit fistp c <- float(x) volatile
end

pattern fild
  match sitofp(v=load.i16|i32(p))
  when nonvolatile(v), only_reader(v), unwritten(v)
  cover v
  let c = loaded(v)
  emit fild fresult <- c
end

pattern getelementptr
  match getelementptr
  call getelementptr
end

pattern wide_cast_to
  match cast.i64
  when splits_i64
  call wide_cast
end

pattern wide_cast_from
  match cast(_.i64)
  when splits_i64
  call wide_cast
end

# Where the datalayout has no legal i64 (`splits_i64`), an i64 is its halves, low first (isel/expand.rs): the first form for the lowest, the second for each above it,
# which takes the carry of the half below.
pattern wide_add
  match add.i64(a, b)
  when splits_i64
  chain add adc <- a, b
end

pattern wide_sub
  match sub.i64(a, b)
  when splits_i64
  chain sub sbb <- a, b
end

pattern wide_and
  match and.i64(a, b)
  when splits_i64
  chain and and <- a, b
end

pattern wide_or
  match or.i64(a, b)
  when splits_i64
  chain or or <- a, b
end

pattern wide_xor
  match xor.i64(a, b)
  when splits_i64
  chain xor xor <- a, b
end

pattern wide_binary
  match binary.i64
  when splits_i64
  call wide_binary
end

pattern wide_load
  match load.i64(p)
  when splits_i64
  call wide_load(p)
end

pattern wide_store
  match store(v.i64, p)
  when splits_i64
  call wide_store(v, p)
end

pattern float_load
  match load.float(p)
  let c = cell(p)
  emit fld fresult <- c volatile
end

pattern float_bits_store
  match store(c.float:int|poison|fconst|const, p)
  call float_bits(c, p)
end

pattern float_store
  match store(v.float, p)
  let c = cell(p)
  emit fstp c <- float(v) volatile
end

pattern float_arithmetic for fadd=fadd fsub=fsub fmul=fmul fdiv=fdiv
  match $mir(a, b)
  let x = float(a)
  let y = float(b)
  emit $x86 fresult <- x, y
end

pattern fneg
  match fneg(a)
  let x = float(a)
  emit fchs fresult <- x
end

pattern float_cast_to
  match cast.float
  call float_cast
end

pattern float_cast_from
  match cast(_.float)
  call float_cast
end

# Where a target's own patterns for memory go: after the conversions above, which
# no memory pattern of its own competes with, and before the general ones.
own memory

pattern load
  match load(p)
  let c = access(p)
  emit mov result <- c volatile
end

pattern store
  match store(v, p)
  let s = source(v)
  let c = access(p)
  emit mov c <- s volatile
end

# div and idiv leave both quotient and remainder.
pattern divide
  match sdiv|srem|udiv|urem
  call divide
end

# An i1's byte is 0 or 1: its sum and difference are the xor, its product the
# and. LSR's expander makes `add i1 x, true` of a `not`.
pattern boolean_sum for add=xor sub=xor mul=and
  match $mir.i1(a, b)
  let x = held(a)
  let y = source(b)
  emit $x86 result <- x, y
end

pattern boolean_arithmetic
  match shl|lshr|ashr.i1
  refuse "arithmetic on an i1"
end

pattern negate
  match sub(#0, b)
  let x = held(b)
  emit neg result <- x
end

# A byte product has no two-operand form: the low byte of the product of the words is the product's.
pattern multiply_byte
  match mul.i8(a, b)
  call byte_multiply(a, b)
end

# A multiply by a constant: imul, or shifts and adds where they are cheaper.
pattern multiply_immediate
  match mul(a, n:int)
  group multiply_by_constant
  cost immediate_multiply(n)
  let x = held(a)
  let y = source(n)
  emit imul result <- x, y
end

pattern multiply_scaled
  match mul(a, n:int)
  group multiply_by_constant
  when scalable(n)
  cost scaled(n)
  call scaled(a, n)
end

# The `not` of a comparison is the comparison of the opposite condition, as
# DAGCombiner's visitXOR has it; one nothing else reads is not made twice.
pattern inverted_icmp_only
  match xor.i1(t=icmp(_, _), #1)
  when only_reader(t)
  cover t
  call setcc_inverted
end

pattern inverted_fcmp_only
  match xor.i1(t=fcmp(_, _), #1)
  when only_reader(t)
  cover t
  call setcc_inverted
end

pattern inverted_icmp
  match xor.i1(t=icmp(_, _), #1)
  call setcc_inverted
end

pattern inverted_fcmp
  match xor.i1(t=fcmp(_, _), #1)
  call setcc_inverted
end

# What the target would rather run on the whole register (`promote` in its datalayout.toml): the word
# operation is run as a dword, which reads and writes what lies above the word and does not care.
# A load only this reads is its memory operand (X86DAGToDAGISel::tryFoldLoad:
# `ADD32rm`): nothing writes memory between, and the load has no other reader.
# DEVIATE F1 (exit: SsaSpill deleted or after twoaddr, 2026-11-05; then the pin's unfold in `twoaddr.rs`
# replaces this guard, see lir-cleanup-plan.md): only where the other operand is free after (`dies`); the pin folds
# either way and leaves the copy to the coalescer, which cost `x_transpose` 7.6%,
# `x_bigadd` 3.7% and `nbody_fixed` 1.0% in clocks (bench's rows pair, 486).
# Not `and`: `and_tested` covers an AND a comparison with zero reads, and a load
# covered here would be left unselected under it.
pattern arithmetic_cell for add=add sub=sub or=or xor=xor
  match $mir.i16|i32(a:value, v=load(p))
  when !indexing(), !promoted, nonvolatile(v), only_reader(v), dies(a), unwritten(v), !stored_back(v), !local(v)
  cover v
  let x = held(a)
  let y = access(p)
  emit $x86 result <- x, y
end

# The same with the load first, for the operations that commute.
pattern arithmetic_cell_first for add=add or=or xor=xor
  match $mir.i16|i32(v=load(p), b:value)
  when !indexing(), !promoted, nonvolatile(v), only_reader(v), dies(b), unwritten(v), !stored_back(v), !local(v)
  cover v
  let x = held(b)
  let y = access(p)
  emit $x86 result <- x, y
end

pattern arithmetic_promoted for add=add sub=sub and=and or=or xor=xor
  match $mir(a, b)
  when promoted
  let x = promoted(a)
  let y = promoted_source(b)
  let r = promoted_result
  emit $x86 r <- x, y
end

pattern arithmetic for add=add sub=sub and=and or=or xor=xor mul=imul
  match $mir(a, b)
  let x = held(a)
  let y = source(b)
  emit $x86 result <- x, y
end

# A shift counts from cl.
pattern shift for shl=shl lshr=shr ashr=sar
  match $mir(a, b)
  let x = held(a)
  let y = count(b)
  emit $x86 result <- x, y
end

pattern extractvalue
  match extractvalue
  call extractvalue
end

# An aggregate of scalars is its fields, each in a register of its own, as a call answers it.
pattern insertvalue
  match insertvalue
  call insertvalue
end

# Where a target's own casts go: after the i64 and float casts, which are not
# those of its own types, and before the general ones.
own casts

# A boolean truncation only the block's branch reads is the branch's `test`.
pattern fused_truncation
  match trunc.i1(x)
  when fused
  nothing
end

pattern truncate_to_boolean
  match trunc.i1(x)
  let r = result
  let s = byte(x)
  emit and r <- s, imm(1, 1)
end

pattern truncate
  match trunc(x)
  let r = result
  let s = narrowed(x)
  emit mov r <- s
end

# An i1's byte is already 0 or 1: its sign extension is its negation.
pattern zero_extend_boolean_to_byte
  match zext.i8(x.i1)
  let r = result
  let s = held(x)
  emit mov r <- s
end

pattern zero_extend_boolean
  match zext(x.i1)
  let r = result
  let s = held(x)
  emit movzx r <- s
end

pattern sign_extend_boolean_to_byte
  match sext.i8(x.i1)
  let r = result
  let s = held(x)
  let w = fresh
  emit mov w <- s
  emit neg r <- w
end

pattern sign_extend_boolean
  match sext(x.i1)
  let r = result
  let s = held(x)
  let w = fresh
  emit movzx w <- s
  emit neg r <- w
end

pattern extend for sext=movsx zext=movzx
  match $mir(x)
  let r = result
  let s = held(x)
  emit $x86 r <- s
end

pattern pointer_cast for ptrtoint=mov inttoptr=mov addrspacecast=mov
  match $mir(x)
  when same_width(x)
  let r = result
  let s = source(x)
  emit $x86 r <- s
end

# A frozen value is the value: LLVM selects it as a copy.
pattern freeze
  match freeze.i1|i8|i16|i32|ptr(x)
  let r = result
  let s = source(x)
  emit mov r <- s
end

# Where an i64 is its halves, a frozen one is the same halves.
pattern wide_freeze
  match freeze.i64
  when splits_i64
  call wide_freeze
end

pattern unselected_cast
  match cast
  call unselected_cast
end

# A comparison a branch reads stays flags, made beside the branch.
pattern fused_compare
  match icmp|fcmp
  when fused
  nothing
end

# An AND only a comparison with zero reads is `test`.
pattern and_tested
  match icmp(t=and.i8|i16|i32(_:value, _:value|int), #0)
  when only_reader(t)
  cover t
  call setcc
end

pattern and_tested_second
  match icmp(#0, t=and.i8|i16|i32(_:value, _:value|int))
  when only_reader(t)
  cover t
  call setcc
end

# A float load only a comparison reads second is fcom's cell.
pattern fcom_cell_first
  match fcmp(v=load(p), _)
  when compared_second(v), nonvolatile(v), only_reader(v), unwritten(v)
  cover v
  call setcc
end

pattern fcom_cell_second
  match fcmp(_, v=load(p))
  when compared_second(v), nonvolatile(v), only_reader(v), unwritten(v)
  cover v
  call setcc
end

pattern setcc
  match icmp|fcmp
  call setcc
end

pattern br
  match br
  call br
end

pattern ret
  match ret
  call ret
end

pattern call
  match call
  call call
end

pattern invoke
  match invoke
  call invoke
end

pattern landingpad
  match landingpad
  call landing_pad
end

# Nothing runs after it: the block ends with what came before.
pattern unreachable
  match unreachable
  nothing
end

pattern unselected
  match *
  refuse mnemonic
end
