// The peephole rules every x86 target has: local rewrites of allocated LIR, over the
// instructions of x86.instr. A target adds its own groups in its own `peephole.peep`.
// build.rs compiles each group into one decision automaton;
// `Peephole::transform` runs the groups among the passes that stay code,
// in a fixed order.
//
// A rule matches instructions as LIR spells them: destinations, then
// sources (`add d, d, #1` is d = d + 1); where a mnemonic's forms differ
// in that count, `/` parts the two. `x:reg` binds an operand (reg, mem,
// imm, sym, held or any, with an optional width), a later `x` requires the
// same operand, `#1` is an immediate without an address, `..` any further
// sources. `@k` is the matched instruction k and `$k` the rewrite's item k.
// Guards live in peep/guards.rs, operand and metadata makers in
// peep/make.rs.
//
// Walks: `each` rewrites one instruction in place; `window` consumes the
// instructions a rule matches, skipping those `skip` names; `slide`
// rewrites in place and moves on `advance`; `gap` lets instructions stand
// between the first and the rest while its guard (`... g(@0, *)`) holds.

// Metadata an instruction must lack to be rewritten (guards::free).
meta exact = clobbers clobbers_high requires delivers spread group symbol frame_adjust spill_reload spill_store
meta synthetic = exact point
meta settled = clobbers requires delivers spread group symbol frame_adjust
meta dropped = settled unowned
meta tied = settled spill_reload
meta synthetic_tied = tied point
meta argument = tied
meta pushed_argument = argument defines uses
meta moved_argument = argument uses
meta rewritable = clobbers requires delivers spread group
meta rewritable_named = rewritable symbol
meta widening = clobbers clobbers_high requires delivers spread group frame_adjust spill_reload spill_store
// A load whose segment is required in a register (ES for a far access) may widen: the requirement stays on the instruction.
meta widening_load = clobbers clobbers_high delivers spread group frame_adjust spill_reload spill_store
meta tested = clobbers symbol

// Sets of mnemonics, from x86.instr. What an operation on memory can be:
// the arithmetic writing its first operand from a register, memory or
// immediate, and the unary operations, that read no flag.
set alu_rmw = op(Binary) & shape("rm/^0,rmi") - reads(any)
set unary_rmw = op(Unary) & shape("rm/^0") - reads(any)
set commutative = (add|and|or|xor|imul)
set commutative_alu = commutative & op(Binary)
// The branches zero_compares was written for. jo, jno, jp and jnp would be
// sound too (`or r,r` and `cmp r,0` set OF and PF alike) but change output.
set jcc = op(Branch) - (jo|jno|jp|jnp)
// The branches a zero test decides: they read only ZF or SF.
set zero_jcc = jcc - reads(CF|OF|PF|AF)


// Fold a load or transitive extension into one widening instruction. A
// plain load's value has no other reader; a transitive extension keeps one
// register root. Independent instructions may stand between: the widened
// write moves up over them.
group extensions
    walk gap first original

rule loaded_extension
    match   mov m:reg, src:mem ; ... independent(@0, *) ; x=(movsx|movzx) d:reg, m
    when    free(@0, widening_load), free(@1, widening), same_width(m, src), narrower(m, d), feeds_once(@0, @1),
            encodable($0), hoistable($0, @0, gap)
    rewrite @0: x d, src {defines: @1.defines, uses: joined_uses(@0, @1), widths: joined_widths(@0, @1)} ;
            anchor @1 {defines: [], uses: []}

rule signed_extensions
    match   movsx m:reg, src:any ; ... independent(@0, *) ; movsx d:reg, m
    when    free(@0, widening), free(@1, widening), same_root(m, d), narrower(src, m), narrower(m, d), feeds_once(@0, @1),
            encodable($0), hoistable($0, @0, gap)
    rewrite @0: movsx d, src {defines: @1.defines, uses: joined_uses(@0, @1), widths: joined_widths(@0, @1)} ;
            anchor @1 {defines: [], uses: []}

rule unsigned_extensions
    match   movzx m:reg, src:any ; ... independent(@0, *) ; movzx d:reg, m
    when    free(@0, widening), free(@1, widening), same_root(m, d), narrower(src, m), narrower(m, d), feeds_once(@0, @1),
            encodable($0), hoistable($0, @0, gap)
    rewrite @0: movzx d, src {defines: @1.defines, uses: joined_uses(@0, @1), widths: joined_widths(@0, @1)} ;
            anchor @1 {defines: [], uses: []}


// Priced forms of a zero extension. `movzx r,m8` as `xor r,r; mov rl,m` where the target prices the pair lower (the 486: two clocks
// for three). The xor sets the flags, so none may be live, and r must not be in the address.
group zeroed_loads
    walk window

rule zeroed_load
    match   movzx d:reg, src:mem
    when    clears_before_byte_load(), free(@0, widening), width_in(src, [8]), byte_loadable(d, src),
            flags_dead(@0)
    rewrite @0: xor d, d, d ; @0: mov low_byte(d), src

// `and r, 255` and `and r, 65535` with the flags dead are the zero extension of
// the low byte or word, as X86's patterns select them (`(and GR32:$src1, 0xffff)`
// and `0xff`, X86InstrCompiler.td L1772 and L1775 at d1106deb71cc; the GR16 `0xff`
// pattern at L1778 is not translated): the combiner makes `zext(trunc x)` that
// `and`. Where the code is not for size, only if the target prices the
// extension no higher.
rule byte_mask
    match   and d:reg, d, #255
    when    masks_by_extension(), width_in(d, [32]), flags_dead(@0), encodable($0)
    rewrite @0: movzx d, low_byte(d)

rule word_mask
    match   and d:reg, d, #65535
    when    masks_by_extension(), width_in(d, [32]), flags_dead(@0), encodable($0)
    rewrite @0: movzx d, low_word(d)


// Materialize a call's literal once when both stack and register need it.
group pushed_constants
    walk window

rule pushed_constant
    match   push lit:imm ; mov d:reg, lit
    when    free(@0, pushed_argument), free(@1, moved_argument), same_width(d, lit), width_in(d, [16, 32]),
            register_width(d), !stack_or_frame(d), placed(@1), ends_at(@0, @1)
    rewrite @1 {at: @0.at, covers: point(@0), symbol: false} ; @0: =@0 d {uses: @1.defines}


// Use a saved accumulator in place for commutative two-address operations.
group commuted
    walk slide advance 2

rule commuted
    match   mov t:reg, a:reg ; mov a, x:reg ; op=commutative_alu a, a, t
    when    free(@0, rewritable), free(@1, rewritable_named), free(@2, rewritable_named),
            same_width(a, t), same_width(t, x), width_in(a, [16, 32]), disjoint(lanes(a), lanes(t))
    rewrite @0 ; anchor @1 ; @2: =@2 a, a, x


// Write a commutative result directly into its copied destination: `A =
// op(A, B); B = A` is `B = op(B, A)` when A dies at the copy. The copy
// stays as an anchor for its virtual definition.
group transferred
    walk window skip meta

rule transferred
    match   op=commutative l:reg, l, r:reg ; mov r, l
    when    free(@0, exact), free(@1, synthetic), same_width(l, r), !same_root(l, r), dead(@1, lanes(l)),
            same_length(@0, $0)
    rewrite @0: =@0 r, r, l ; anchor @1


// Remove a synthetic save/restore when the source survives between them:
// nothing between writes the source or touches the temporary, and the
// temporary dies at the restore. Both stay as anchors.
group restored_copies
    walk gap

rule restored_copy
    match   mov t:reg, s:reg ; ... clear_of(t, s, *) ; mov s, t
    when    free(@0, synthetic), free(@1, synthetic), same_width(t, s), width_in(t, [8, 16, 32]),
            disjoint(lanes(t), lanes(s)), !empty(lanes(t)), !empty(lanes(s)), dead(@1, lanes(t))
    rewrite anchor @0 ; anchor @1


// `T = S; T = op(T); S = T` is `S = op(S); T = S`: the same registers and
// flags, one move fewer.
group shuttles
    walk window skip meta

rule shuttle
    match   mov t:reg, s:reg ; any(Binary|Unary|Multiply) t / t, .. ; mov s, t
    when    free(@0, synthetic_tied), free(@1, tied), free(@2, synthetic_tied), same_width(t, s), width_in(t, [8, 16, 32]),
            !same_root(t, s), encodable($0)
    rewrite @1: =@1 map renamed(t, s) ; @2: mov t, s {defines: joined_defines(@0, @2)}


// `mov r,[m]; op r,x; mov [m],r` is `op [m],x`; `mov r,[m]; cmp r,x` is
// `cmp [m],x`. The memory forms set the flags the register forms do and
// leave the cell as the store did; what they no longer write is r, so
// nothing may read r after, and r must be neither how the cell is reached
// nor the operand. A load of the other operand may stand between.
group fused
    walk gap skip nothing resume past

rule fused_compare
    match   mov r:reg, c:mem ; ... delays(@0, *) ; cmp r, o:any
    when    free(@0, dropped), free(@1, settled), same_width(r, c), operand(o, r), dead(@1, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: cmp c, o

// Zero tests the widened value as it does the cell, but for SF: movsx
// copies the cell's top bit as the narrow compare does, movzx leaves it clear.
rule fused_signed_zero_test
    match   movsx r:reg, c:mem ; ... delays(@0, *) ; cmp r, #0
    when    free(@0, dropped), free(@1, settled), narrower(c, r), dead(@1, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: cmp c, zero(c)

rule fused_unsigned_zero_test
    match   movzx r:reg, c:mem ; ... delays(@0, *) ; cmp r, #0
    when    free(@0, dropped), free(@1, settled), narrower(c, r), dead(@1, lanes(r)), dead(@1, SF), encodable($1)
    rewrite anchor @0 ; @1: cmp c, zero(c)

rule fused_update
    match   mov r:reg, c:mem ; ... delays(@0, *) ; op=alu_rmw r, r, o:any ; mov c2:mem, r
    when    free(@0, dropped), free(@1, settled), free(@2, dropped), same_width(r, c), operand(o, r),
            !addresses(c, r), same_cell(c2, c), dead(@2, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: op c, c, o ; anchor @2

// A frontend load is not a register-allocation decision: when its only
// consumer accepts a memory source, the read happens there.
rule fused_operand
    match   mov r:reg, c:mem ; ... delays(@0, *) ; op=alu_rmw d:reg, d, r
    when    free(@0, dropped), free(@1, settled), same_width(r, c), !same_root(d, r), dead(@1, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: op d, d, c

// A load whose only reader is a push is the push's memory operand.
rule fused_push
    match   mov r:reg, c:mem ; ... delays(@0, *) ; push r
    when    free(@0, dropped), free(@1, settled), same_width(r, c), width_in(c, [16, 32]), dead(@1, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: push c

rule fused_unary
    match   mov r:reg, c:mem ; ... delays(@0, *) ; op=unary_rmw r, r ; mov c2:mem, r
    when    free(@0, dropped), free(@1, settled), free(@2, dropped), same_width(r, c),
            !addresses(c, r), same_cell(c2, c), dead(@2, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: op c, c ; anchor @2

rule fused_sourceless_unary
    match   mov r:reg, c:mem ; ... delays(@0, *) ; op=unary_rmw r / ; mov c2:mem, r
    when    free(@0, dropped), free(@1, settled), free(@2, dropped), same_width(r, c),
            !addresses(c, r), same_cell(c2, c), dead(@2, lanes(r)), encodable($1)
    rewrite anchor @0 ; @1: op c / ; anchor @2


// `lea t,[a]; cmp x,o; mov x,t`: a step made before the compare that reads
// the value it replaces, and copied back over it. The lea sets no flag, so
// the branch after reads the compare's either way; made after it, the step
// is in place and one register holds both values.
group stepped_after_compare
    walk window skip meta

rule step_after_compare
    match   lea t:reg, a:any ; cmp x:reg, o:any ; mov x, t
    when    free(@0, rewritable), free(@1, settled), free(@2, synthetic), same_width(x, t), !same_root(x, t),
            operand(o, t), dead(@2, lanes(t)), encodable($1)
    rewrite @1 ; @0: =@0 x, a ; drop @2


// X86FixupLEAs `optTwoAddrLEA` (X86FixupLEAs.cpp#L564), the two cases i486
// reaches: an LEA that is a two-address add, where no flag is read after it.
// A step of one is the INC or DEC `increments` then makes, as the pin's case 2.
group lea_fixup
    walk each

rule lea_sum_as_add
    match   lea d:reg, a:any
    when    free(@0, exact), flags_dead(@0), sums_into(a, d)
    rewrite @0: add d, d, other_term(a, d)

rule lea_step_as_add
    match   lea d:reg, a:any
    when    free(@0, exact), flags_dead(@0), steps_in_place(a, d)
    rewrite @0: add d, d, step(a, d)

// Select compact INC/DEC for a unit add whose carry result is dead: they
// differ from it only in keeping CF.
group increments
    walk each

rule increment
    match   add d:reg, d, #1
    when    dead(@0, CF), no_longer(@0, $0)
    rewrite @0: inc d, d

rule decrement
    match   sub d:reg, d, #1
    when    dead(@0, CF), no_longer(@0, $0)
    rewrite @0: dec d, d

// The combiner's canonical `x - 1` is `add x, -1`: the same DEC, as X86's
// patterns select for `add x, -1` (X86InstrCompiler.td `(add GR32:$src, -1)`).
rule decrement_by_add
    match   add d:reg, d, #-1
    when    dead(@0, CF), no_longer(@0, $0)
    rewrite @0: dec d, d

// A borrow spread to a mask: `0 - 0 - CF` is `r - r - CF`, flags and all,
// and needs no zero. The mov between keeps the borrow.
group borrows
    walk window skip meta

rule borrow_mask
    match   mov r:reg, #0 ; sbb r, r, #0
    when    free(@0, exact), free(@1, exact)
    rewrite drop @0 ; @1: sbb r, r, r


// `shl r,1` as `add r,r` where the target prices the add lower. Every flag
// the shift defines, the add sets the same way.
group doubled
    walk each

rule doubled
    match   (shl|sal) d:reg, d, #1
    when    doubles_by_add()
    rewrite @0: add d, d, d


// `cmp r,0; jcc` is `test r,r; jcc`, a byte shorter: both clear carry and
// overflow and set zero, sign and parity from r; only AF differs, so the
// branch must be the block's last work, or the last but a jump (which reads
// no flag), and nothing after may read AF. `test` writes no register, where
// `or r,r` rewrote r (a dependency for what reads it next), at the same
// price. The branch reading straight after keeps OF clear of anything
// between -- DOSBox's dynamic core loses it across OR and SAHF.
group zero_compares
    walk gap skip inert

set jump = op(Jump)

rule zero_compare
    match   cmp r:reg, #0 ; ... moves(*) ; jcc ; $
    when    free(@0, tested), register_named(r), flags_dead_out(AF), no_longer(@0, $0)
    rewrite @0: test r, r ; @1

rule zero_compare_before_a_jump
    match   cmp r:reg, #0 ; ... moves(*) ; jcc ; jump ; $
    when    free(@0, tested), register_named(r), flags_dead_out(AF), no_longer(@0, $0)
    rewrite @0: test r, r ; @1 ; @2


// A mask only a branch reads is a `test`, as X86 selects `(brcond (and x, m))`: the
// `and` sets the flags `test` does and writes a register nothing reads, and the copy
// that kept its source is not needed (x_collatz: `mov dl, cl; and dl, 1; jne` is
// `test cl, 1; jne`). `test r, imm` has no sign-extended imm8 form: a word or dword
// `and r, imm8` is shorter, so only a byte register is tested alone, and a copy is
// dropped only when that pays for it (byte and word).
group tested_masks
    walk gap skip nothing resume past

rule test_of_masked_copy
    match   mov d:reg, s:reg ; ... delays(@0, *) ; and d, d, m:any
    when    free(@0, dropped), free(@1, settled), same_width(d, s), width_in(d, [8, 16]), operand(m, d), dead(@1, lanes(d)),
            encodable($1)
    rewrite anchor @0 ; @1: test s, m

group tested_lone_masks
    walk each

rule test_of_mask
    match   and d:reg, d, m:any
    when    free(@0, settled), width_in(d, [8]), dead(@0, lanes(d)), encodable($0)
    rewrite @0: test d, m


// Selection across instructions before allocation (isel::combined), on
// held values: `def v: ...` matches the nearest instruction before the
// window that defines v, and `drop` of it takes it out of the block once
// the walk is done. `used_once` reads the counts combined.rs makes.

meta plain = clobbers requires delivers spread
meta pushed_word = plain uses defines volatile
meta pushed_value = plain defines volatile
meta loaded_word = plain volatile
meta argument_load = plain uses
meta held_copy = plain uses
meta pushed_held = plain defines

// Fold a single-use frame load into the push that consumes it.
group memory_arguments
    walk window

rule memory_argument
    match   push v:held ; def v: mov v, c:mem
    when    free(@0, pushed_held), used_once(v), same_width(v, c), width_in(c, [16, 32]), frame_argument(c),
            free(@1, argument_load), defines_only(@1, v), unchanged(@1, @0)
    rewrite @0: =@0 c {uses: [], call: @1.call, symbol: @1.symbol} ; drop @1

// Push a single-use immediate directly. Tuned for size, a dword one whose words are
// shorter pushes than the dword is two word pushes.
group immediate_arguments
    walk window

rule split_immediate_argument
    match   mov v:held, i:imm32 ; push v
    when    free(@0, held_copy), free(@1, pushed_held), same_width(v, i), used_once(v),
            defines_only(@0, v), uses_only(@1, v), splits_smaller(i)
    rewrite @0: =@1 high_word(i) {defines: [], uses: []} ; @1: =@1 low_word(i) {defines: [], uses: []}

rule immediate_argument
    match   mov v:held, i:sym ; push v
    when    free(@0, held_copy), free(@1, pushed_held), same_width(v, i), width_in(v, [16, 32]),
            used_once(v), defines_only(@0, v), uses_only(@1, v)
    rewrite @0: =@1 i {defines: [], uses: []} ; drop @1


// X86FixupBWInsts (X86FixupBWInsts.cpp L165): after allocation, a byte or word load, copy or
// extension whose register's other bytes are dead after it is the dword form. A zero
// extending load needs no merge with the old upper bytes, and a dword copy has no
// partial-register write. `mov al,[m]` is not widened for size (it takes a byte more);
// `ah` is never the destination (the pin's `sub_8bit_hi`); `movsx ax,al` stays `cbw`.
// DEVIATE W1 (no number yet): in real mode the dword form takes the 0x66 prefix, so the pin's claim
// that code size is the same is false there; the rewrite is made only if it is no longer. Exit: none
// (a fact of the encoding); cost: the real-mode words the pin would widen stay words.
group byte_word_fixup
    walk each

rule loaded_byte
    match   mov d:reg8, src:mem8
    when    !for_size(), !segment(d), low_view(d), free(@0, widening_load), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: movzx dword_of(d), src

rule loaded_word
    match   mov d:reg16, src:mem16
    when    !segment(d), low_view(d), free(@0, widening_load), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: movzx dword_of(d), src

rule copied_byte
    match   mov d:reg8, s:reg8
    when    !segment(d), !segment(s), low_view(d), low_view(s), free(@0, widening), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: mov dword_of(d), dword_of(s)

rule copied_word
    match   mov d:reg16, s:reg16
    when    !segment(d), !segment(s), low_view(d), low_view(s), free(@0, widening), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: mov dword_of(d), dword_of(s)

rule sign_extended_byte
    match   movsx d:reg16, s:reg8
    when    !segment(d), !segment(s), low_view(d), low_view(s), !same_root(d, s), free(@0, widening), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: movsx dword_of(d), s

rule sign_extended_byte_cell
    match   movsx d:reg16, s:mem8
    when    !segment(d), low_view(d), free(@0, widening_load), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: movsx dword_of(d), s

rule zero_extended_byte
    match   movzx d:reg16, s:reg8
    when    !segment(d), !segment(s), low_view(d), low_view(s), free(@0, widening), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: movzx dword_of(d), s

rule zero_extended_byte_cell
    match   movzx d:reg16, s:mem8
    when    !segment(d), low_view(d), free(@0, widening_load), dead(@0, rest_of_root(d)), short_in_real_mode(@0, $0)
    rewrite @0: movzx dword_of(d), s
