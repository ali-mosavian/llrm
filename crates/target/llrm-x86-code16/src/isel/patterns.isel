# The patterns real mode adds to the family's (llrm-x86): far pointers, which a
# selector and an offset make two words.

pattern far_load
  match load.far(p)
  call far_load(p)
end

pattern far_store
  match store(v.far, p)
  call far_store(v, p)
end

pattern far_cast_to
  match cast.far
  call far_cast
end

pattern far_cast_from
  match cast(_.far)
  call far_cast
end

