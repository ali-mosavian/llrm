# The operating system: what only assembly reaches (dos.asm). A file call
# returns what DOS does, or its error code negated; `read` and `write_file` return a byte count or the
# negated error code as an i32 on every target (one call moves at most i32 max bytes), so a program
# that names the type is portable.

@extern("cdecl16", name="N$OOPN")
pub fn open(name: *far char, mode: u8) -> i16
@extern("cdecl16", name="N$OCRE")
pub fn create(name: *far char) -> i16
@extern("cdecl16", name="N$OREA")
pub fn read(handle: i16, data: *far mut u8, count: usize) -> i32
@extern("cdecl16", name="N$OWRI")
pub fn write_file(handle: i16, data: *far u8, count: usize) -> i32
@extern("cdecl16", name="N$OCLO")
pub fn close(handle: i16) -> i16
# Ends the program with `code`.
@extern("cdecl16", name="N$OEXT")
pub fn exit(code: u8) -> void
# `bytes` more of DGROUP, right after the last grant, or null.
@extern("cdecl16", name="N$OMEM")
pub fn more(bytes: usize) -> *near mut u8
# The handler interrupt `number` enters.
@extern("cdecl16", name="N$OGIV")
pub fn vector(number: u8) -> extern "interrupt16" fn() -> void
@extern("cdecl16", name="N$OSIV")
pub fn set_vector(number: u8, handler: extern "interrupt16" fn() -> void) -> void
# Enters `handler` as its interrupt would, and comes back.
@extern("cdecl16", name="N$OCHN")
pub fn chain(handler: extern "interrupt16" fn() -> void) -> void

const STANDARD_OUTPUT: i16 = 1

# `length` bytes of `text` to standard output.
pub fn write(text: *far u8, length: usize) -> void:
    unsafe:
        write_file(STANDARD_OUTPUT, text, length)

# The colour text screen: 80x25 cells of a character and an attribute, at the machine's physical
# address (the target's description names it; this layer turns it into the far pointer real mode
# reaches memory outside its data segment by: segment = address >> 4, offset = address & 15).
const SCREEN_FAR = ((PHYSICAL_TEXT_SCREEN >> 4) << 16) | (PHYSICAL_TEXT_SCREEN & 15)

pub fn text_screen() -> *far mut u8:
    unsafe:
        let screen: *far mut u8 = SCREEN_FAR
        return screen
