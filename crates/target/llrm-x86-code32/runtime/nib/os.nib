# The operating system under DOS/32A: what only assembly reaches (dos.asm). A file call
# returns what DOS does, or its error code negated. One flat segment: `*far` and `*near`
# are the same pointer, and the target's C convention is cdecl32.

@extern("cdecl32", name="N$OOPN")
pub fn open(name: *near char, mode: u8) -> i16
@extern("cdecl32", name="N$OCRE")
pub fn create(name: *near char) -> i16
@extern("cdecl32", name="N$OREA")
pub fn read(handle: i16, data: *near mut u8, count: usize) -> isize
@extern("cdecl32", name="N$OWRI")
pub fn write_file(handle: i16, data: *near u8, count: usize) -> isize
@extern("cdecl32", name="N$OCLO")
pub fn close(handle: i16) -> i16
# Ends the program with `code`.
@extern("cdecl32", name="N$OEXT")
pub fn exit(code: u8) -> void
# `bytes` more of the heap, right after the last grant, or null.
@extern("cdecl32", name="N$OMEM")
pub fn more(bytes: usize) -> *near mut u8

const STANDARD_OUTPUT: i16 = 1

# `length` bytes of `text` to standard output.
pub fn write(text: *near u8, length: usize) -> void:
    unsafe:
        write_file(STANDARD_OUTPUT, text, length)
