// code32's own peephole groups, beside the family's (llrm-x86): flat code runs dwords unprefixed, so a word
// operation is the one that costs, and is taken only where it keeps what the dword form would make.

// A word result extended in place of a dword operation: where the upper half of the
// register is zero already, the word operation leaves it so and is the same value
// in one instruction. The flags are the word's, so none may be read after.
set word_alu = (add|sub|and|or|xor|imul)

group narrowed_arithmetic
    walk window skip meta

rule narrowed_register_arithmetic
    match   op=word_alu d:reg32, d, s:reg32 ; movzx e:reg32, w:reg16
    when    free(@0, widening), free(@1, widening), same_root(d, e), same_root(d, w), upper_zero(@0, d),
            dead(@1, CF), dead(@1, ZF), dead(@1, SF), dead(@1, OF), dead(@1, PF), dead(@1, AF), encodable($0)
    rewrite @0: =@0 low_word(d), low_word(d), low_word(s) {defines: @1.defines, uses: joined_uses(@0, @1), widths: joined_widths(@0, @1)} ;
            anchor @1 {defines: [], uses: []}

rule narrowed_immediate_arithmetic
    match   op=word_alu d:reg32, d, s:imm32 ; movzx e:reg32, w:reg16
    when    free(@0, widening), free(@1, widening), same_root(d, e), same_root(d, w), upper_zero(@0, d),
            dead(@1, CF), dead(@1, ZF), dead(@1, SF), dead(@1, OF), dead(@1, PF), dead(@1, AF), encodable($0)
    rewrite @0: =@0 low_word(d), low_word(d), low_word(s) {defines: @1.defines, uses: joined_uses(@0, @1), widths: joined_widths(@0, @1)} ;
            anchor @1 {defines: [], uses: []}
