# arm64 registers, one per line, in the format of x86-m32's registers.regs.
# Ids are numbered by line from 1. The file is the AArch64 register file at the
# pin (AArch64RegisterInfo.td); Darwin reserves x18 (the platform register).
# x29 is the frame register and sp the stack: Darwin AAPCS64 keeps a frame pointer.
#
# name bits root lane classes dwarf codeview
@scratch x9 x10 x11 x12 x13 x14 x15
# Integer registers, 64-bit roots then their 32-bit views.
x0   64 x0 0 gpr,int,base,index 0 -
x1   64 x1 0 gpr,int,base,index 1 -
x2   64 x2 0 gpr,int,base,index 2 -
x3   64 x3 0 gpr,int,base,index 3 -
x4   64 x4 0 gpr,int,base,index 4 -
x5   64 x5 0 gpr,int,base,index 5 -
x6   64 x6 0 gpr,int,base,index 6 -
x7   64 x7 0 gpr,int,base,index 7 -
x8   64 x8 0 gpr,int,base,index 8 -
x9   64 x9 0 gpr,int,base,index 9 -
x10  64 x10 0 gpr,int,base,index 10 -
x11  64 x11 0 gpr,int,base,index 11 -
x12  64 x12 0 gpr,int,base,index 12 -
x13  64 x13 0 gpr,int,base,index 13 -
x14  64 x14 0 gpr,int,base,index 14 -
x15  64 x15 0 gpr,int,base,index 15 -
x16  64 x16 0 gpr,int,base,index 16 -
x17  64 x17 0 gpr,int,base,index 17 -
x18  64 x18 0 reserved,int,base,index 18 -
x19  64 x19 0 gpr,int,base,index 19 -
x20  64 x20 0 gpr,int,base,index 20 -
x21  64 x21 0 gpr,int,base,index 21 -
x22  64 x22 0 gpr,int,base,index 22 -
x23  64 x23 0 gpr,int,base,index 23 -
x24  64 x24 0 gpr,int,base,index 24 -
x25  64 x25 0 gpr,int,base,index 25 -
x26  64 x26 0 gpr,int,base,index 26 -
x27  64 x27 0 gpr,int,base,index 27 -
x28  64 x28 0 gpr,int,base,index 28 -
x29  64 x29 0 reserved,frame,int,base,index 29 -
x30  64 x30 0 reserved,int,base,index 30 -
sp   64 sp 0 reserved,stack,int,base 31 -
xzr  64 xzr 0 reserved,zero,int 31 -
w0   32 x0 0 int 0 -
w1   32 x1 0 int 1 -
w2   32 x2 0 int 2 -
w3   32 x3 0 int 3 -
w4   32 x4 0 int 4 -
w5   32 x5 0 int 5 -
w6   32 x6 0 int 6 -
w7   32 x7 0 int 7 -
w8   32 x8 0 int 8 -
w9   32 x9 0 int 9 -
w10  32 x10 0 int 10 -
w11  32 x11 0 int 11 -
w12  32 x12 0 int 12 -
w13  32 x13 0 int 13 -
w14  32 x14 0 int 14 -
w15  32 x15 0 int 15 -
w16  32 x16 0 int 16 -
w17  32 x17 0 int 17 -
w18  32 x18 0 int,reserved 18 -
w19  32 x19 0 int 19 -
w20  32 x20 0 int 20 -
w21  32 x21 0 int 21 -
w22  32 x22 0 int 22 -
w23  32 x23 0 int 23 -
w24  32 x24 0 int 24 -
w25  32 x25 0 int 25 -
w26  32 x26 0 int 26 -
w27  32 x27 0 int 27 -
w28  32 x28 0 int 28 -
w29  32 x29 0 int,reserved 29 -
w30  32 x30 0 int,reserved 30 -
wsp  32 sp 0 int,reserved 31 -
wzr  32 xzr 0 int,reserved,zero 31 -
