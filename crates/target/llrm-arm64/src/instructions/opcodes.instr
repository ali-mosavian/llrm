STPW.{pre|post}          stpair   r/r,r,m       -                        store      - - - -/-                STPW{pre|post}
STPSW.ui                 stpair   -/r,r,m       -                        store      - - - -/-                STPWi
STPSW.{pre|post}         stpair   r/r,r,m       -                        store      - - - -/-                STPW{pre|post}
STPF4.ui                 stpair   -/x,x,m       -                        store      - - - -/-                STPSi
STPF4.{pre|post}         stpair   r/x,x,m       -                        store      - - - -/-                STPS{pre|post}
STPF8.ui                 stpair   -/x,x,m       -                        store      - - - -/-                STPDi
STPF8.{pre|post}         stpair   r/x,x,m       -                        store      - - - -/-                STPD{pre|post}
STPF16.ui                stpair   -/x,x,m       -                        store      - - - -/-                STPQi
STPF16.{pre|post}        stpair   r/x,x,m       -                        store      - - - -/-                STPQ{pre|post}
# ---- atomics: `.<size><a|-><l|->` is the size (0 byte .. 3 doubleword), acquire and release
# (the producer names the release store `a-` too)
CAS.{zn}{--|a-|-l|al}    xchg     r/^0,r,m      z8,z16,z32,z64           atomic     - - - -/-                CAS{|A|L|AL}{z}
SWP.{zn}{--|a-|-l|al}    xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                SWP{|A|L|AL}{z}
LDADD.{zn}{--|a-|-l|al}  xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDADD{|A|L|AL}{z}
LDCLR.{zn}{--|a-|-l|al}  xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDCLR{|A|L|AL}{z}
LDEOR.{zn}{--|a-|-l|al}  xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDEOR{|A|L|AL}{z}
LDSET.{zn}{--|a-|-l|al}  xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDSET{|A|L|AL}{z}
LDSMAX.{zn}{--|a-|-l|al} xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDSMAX{|A|L|AL}{z}
LDSMIN.{zn}{--|a-|-l|al} xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDSMIN{|A|L|AL}{z}
LDUMAX.{zn}{--|a-|-l|al} xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDUMAX{|A|L|AL}{z}
LDUMIN.{zn}{--|a-|-l|al} xchg     r/r,m         z8,z16,z32,z64           atomic     - - - -/-                LDUMIN{|A|L|AL}{z}
LDAR.{zn}a-              move     r/m           z8,z16,z32,z64           atomic     - - - -/-                LDAR{z}
LDAPR.{zn}a-             move     r/m           z8,z16,z32,z64           atomic     - - - -/-                LDAPR{z}
STLR.{zn}a-              move     -/r,m         z8,z16,z32,z64           atomic     - - - -/-                STLR{z}
