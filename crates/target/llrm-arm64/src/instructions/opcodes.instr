EON{g}rs       binary   r/r,r,i,i    g32,g64  alu_shift  -  -  -  -/-          EON{g}rs
EOR{g}ri       binary   r/r,i        g32,g64  alu        -  -  -  -/-          EOR{g}ri
EOR{g}rs       binary   r/r,r,i,i    g32,g64  alu_shift  -  -  -  -/-          EOR{g}rs
ORN{g}rs       binary   r/r,r,i,i    g32,g64  alu_shift  -  -  -  -/-          ORN{g}rs
ORR{g}ri       binary   r/r,i        g32,g64  alu        -  -  -  -/-          ORR{g}ri
ORR{g}rs       binary   r/r,r,i,i    g32,g64  alu_shift  -  -  -  -/-          ORR{g}rs
ASRV{g}r       binary   r/r,r        g32,g64  shift      -  -  -  -/-          ASRV{g}r
LSLV{g}r       binary   r/r,r        g32,g64  shift      -  -  -  -/-          LSLV{g}r
LSRV{g}r       binary   r/r,r        g32,g64  shift      -  -  -  -/-          LSRV{g}r
RORV{g}r       binary   r/r,r        g32,g64  shift      -  -  -  -/-          RORV{g}r
CLS{g}r        unary    r/r          g32,g64  alu        -  -  -  -/-          CLS{g}r
CLZ{g}r        unary    r/r          g32,g64  alu        -  -  -  -/-          CLZ{g}r
RBIT{g}r       unary    r/r          g32,g64  alu        -  -  -  -/-          RBIT{g}r
REV{g}r        unary    r/r          g32,g64  alu        -  -  -  -/-          REV{g}r
REV16{g}r      unary    r/r          g32,g64  alu        -  -  -  -/-          REV16{g}r
EXTR{g}rri     funnel   r/r,r,i      g32,g64  alu        -  -  -  -/-          EXTR{g}rri
MOVK{g}i       move     r/^0,i,i     g32,g64  alu        -  -  -  -/-          MOVK{g}i
MOVN{g}i       move     r/i,i        g32,g64  alu        -  -  -  -/-          MOVN{g}i
MOVZ{g}i       move     r/i,i        g32,g64  alu        -  -  -  -/-          MOVZ{g}i
BFM{g}ri       bitfield r/^0,r,i,i   g32,g64  alu        -  -  -  -/-          BFM{g}ri
SBFM{g}ri      bitfield r/r,i,i      g32,g64  alu        -  -  -  -/-          SBFM{g}ri
UBFM{g}ri      bitfield r/r,i,i      g32,g64  alu        -  -  -  -/-          UBFM{g}ri
CCMN{g}i       ccmp     -/r,i,i,i    g32,g64  alu        -  -  -  N,Z,C,V/N,Z,C,V  CCMN{g}i
CCMN{g}r       ccmp     -/r,r,i,i    g32,g64  alu        -  -  -  N,Z,C,V/N,Z,C,V  CCMN{g}r
CCMP{g}i       ccmp     -/r,i,i,i    g32,g64  alu        -  -  -  N,Z,C,V/N,Z,C,V  CCMP{g}i
CCMP{g}r       ccmp     -/r,r,i,i    g32,g64  alu        -  -  -  N,Z,C,V/N,Z,C,V  CCMP{g}r
CSEL{g}r       select   r/r,r,i      g32,g64  alu        -  -  -  N,Z,C,V/-    CSEL{g}r
CSINC{g}r      select   r/r,r,i      g32,g64  alu        -  -  -  N,Z,C,V/-    CSINC{g}r
CSINV{g}r      select   r/r,r,i      g32,g64  alu        -  -  -  N,Z,C,V/-    CSINV{g}r
CSNEG{g}r      select   r/r,r,i      g32,g64  alu        -  -  -  N,Z,C,V/-    CSNEG{g}r
MADD{g}rrr     muladd   r/r,r,r      g32,g64  mul        -  -  -  -/-          MADD{g}rrr
MSUB{g}rrr     muladd   r/r,r,r      g32,g64  mul        -  -  -  -/-          MSUB{g}rrr
