FMADD{f}rrr              fmuladd  x/x,x,x       f16,f32,f64              fp_arith   - - - -/-                FMADD{f}rrr
FMSUB{f}rrr              fmuladd  x/x,x,x       f16,f32,f64              fp_arith   - - - -/-                FMSUB{f}rrr
