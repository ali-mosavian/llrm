UMSUBLXrrr     muladd   r/r,r,r      g64      mul        -  -  -  -/-          UMSUBLrrr
SMULHXrrr      mul      r/r,r,r      g64      mul        -  -  -  -/-          SMULHrr
UMULHXrrr      mul      r/r,r,r      g64      mul        -  -  -  -/-          UMULHrr
SDIV{g}r       div      r/r,r        g32,g64  div        -  -  -  -/-          SDIV{g}r
UDIV{g}r       div      r/r,r        g32,g64  div        -  -  -  -/-          UDIV{g}r
ADR            addr     r/a          -        alu        -  -  -  -/-          ADR
ADRP           addr     r/a          -        alu        -  -  -  -/-          ADRP
ADRP.got       addr     r/a          -        alu        -  -  -  -/-          ADRP
# ---- control
B                        jump     -/-           -                        branch     - - - -/-                B
BL                       call     -/a           -                        call       - - - -/-                BL
BLR                      call     -/r           -                        call       - - - -/-                BLR
BR                       jump     -/r           -                        branch     - - - -/-                BR
BRK                      escape   -/i           -                        branch     - - - -/-                BRK
Bcc                      branch   -/i           -                        branch     - - - N,Z,C,V/-          Bcc
CB{Z|NZ}{g}              branch   -/r           g32,g64                  branch     - - - -/-                CB{Z|NZ}{g}
TBZ                      branch   -/r,i         -                        branch     - - - -/-                TBZ[W|X]
TBNZ                     branch   -/r,i         -                        branch     - - - -/-                TBNZ[W|X]
DMB                      barrier  -/i           -                        barrier    - - - -/-                DMB
NOP                      nothing  -/-           -                        alu        - - - -/-                HINT
PRFM                     nothing  -/i,r         -                        load       - - - -/-                PRFMui
RET                      ret      -/r           -                        branch     - - - -/-                RET
SVC                      escape   -/i           -                        branch     - - - -/-                SVC
