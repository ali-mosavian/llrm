# x86-64 prices, clocks, one CPU. PROVISIONAL (POC spike): the integer rows are recalled Skylake-class
# figures (Agner Fog, Instruction tables), not yet checked against the tables; the x87 and string rows are
# the P5 column of x86-m32's. Exit: replace by X86 scheduling-model figures (SkylakeClient) before any row
# of this target is claimed. Keys are the cost keys of the forms.
#
# The scalars: issue width, in-order, clocks decoding each operand-size prefix, the partial-register and
# length-changing-prefix stalls, and pairing.
default_cpu           x86-64
cpus                  x86-64
march                x86-64
issue                   4
in_order                0
prefix                  1
partial_stall           1
lcp_stall               3
set_ratio           6
clear_ratio         6
set_ratio_size      3
clear_ratio_size    2
# No jump table: a table of code addresses needs an absolute relocation per entry, which a PIE refuses; the
# position-independent form (a table of offsets from its own address) is not selected yet.
jump_table          0
cache_line          64
pairing             0
[clocks]
alu_rr              1
xchg_rr             1
alu_ri              1
alu_rm              1
alu_mr              2
mov_rr              1
mov_rm              1
mov_mr              1
mov_ri              1
shift_ri            1
shift_r1            1
movzx               1
setcc               1
cdq                 1
lea                 1
imul_r32            3
imul_m32            4
mul_r32             3
idiv_r32            40
idiv_m32            41
push_r              1
push_m              2
push_i              1
pop_r               1
pop_m               2
leave               3
jmp_short           1
jmp_indirect        1
jcc                 1
call_near           2
ret_near            1
ret_pop             2
rep_stos            9
rep_stos_cell       1
rep_movs            13
rep_movs_cell       1
x87_load            1
x87_exchange        1
x87_store           2
x87_release         1
x87_add             3
x87_mul             3
x87_div             39
x87_convert_store   7
x87_add_m           3
x87_mul_m           3
x87_div_m           39
x87_load_i          1
x87_add_i           4
x87_mul_i           4
x87_div_i           40
x87_cmp_i           4
x87_control_load    8
x87_control_store   2
mul_r16             11
div_r16             25
jcc_not_taken       1
nop                 1
lahf                2
sahf                1
unknown             2
smul_min_w2         10
smul_max_w2         10
smul_min_w4         10
smul_max_w4         10
smul_full_w2        11
smul_negative_bits  -
sdiv_w2             30
sdiv_w4             46
udiv_w2             25
udiv_w4             41
[latency]
alu_rr              1
xchg_rr             1
alu_ri              1
alu_rm              1
alu_mr              2
mov_rr              1
mov_rm              1
mov_mr              1
mov_ri              1
shift_ri            1
shift_r1            1
movzx               1
setcc               1
cdq                 1
lea                 1
imul_r32            3
imul_m32            4
mul_r32             3
idiv_r32            40
idiv_m32            41
push_r              1
push_m              2
push_i              1
pop_r               1
pop_m               2
leave               3
jmp_short           1
jmp_indirect        1
jcc                 1
call_near           2
ret_near            1
ret_pop             2
rep_stos            9
rep_stos_cell       1
rep_movs            13
rep_movs_cell       1
x87_load            1
x87_exchange        1
x87_store           2
x87_release         1
x87_add             3
x87_mul             3
x87_div             39
x87_convert_store   7
x87_add_m           3
x87_mul_m           3
x87_div_m           39
x87_load_i          1
x87_add_i           4
x87_mul_i           4
x87_div_i           40
x87_cmp_i           4
x87_control_load    8
x87_control_store   2
mul_r16             11
div_r16             25
jcc_not_taken       1
nop                 1
lahf                2
sahf                1
unknown             2
