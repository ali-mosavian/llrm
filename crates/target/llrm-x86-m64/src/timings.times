# `=` in a cell: the price is in the CPU's file, machine/tune/x86/<march>.toml, which holds the rows every
# target with that CPU agrees on. Correct such a price there; a row only this target states is here.
#
# x86-64 prices, clocks, one CPU. PROVISIONAL (POC spike): the integer rows are recalled Skylake-class
# figures (Agner Fog, Instruction tables), not yet checked against the tables; the x87 and string rows are
# the P5 column of x86-m32's. Exit: replace by X86 scheduling-model figures (SkylakeClient) before any row
# of this target is claimed. Keys are the cost keys of the forms.
#
# The scalars: issue width, in-order, clocks decoding each operand-size prefix, the partial-register and
# length-changing-prefix stalls, and pairing.
default_cpu           x86-64
cpus                  x86-64
march                x86-64
issue                   =
in_order                =
prefix                  =
partial_stall           =
# DEVIATE CMC3 (owner m64, exit 2026-11-20): the pin's SandyBridge penalty (16) converts
# register cmovs to branches; on Zen 5 that costs jpeg_fixed -Os +2.6% (pin llc with
# -x86-cmov-converter=false is faster). So -O1..-O3 keep the pin's 16 and -Os/-Oz
# take 1000: only memory-operand groups convert.
mispredict_penalty      =
mispredict_penalty_size 1000
lcp_stall               =
set_ratio           =
clear_ratio         =
set_ratio_size      =
clear_ratio_size    =
# No jump table: a table of code addresses needs an absolute relocation per entry, which a PIE refuses; the
# position-independent form (a table of offsets from its own address) is not selected yet.
jump_table          5
cache_line          = 
# M64-RATE (owner m64, exit 2026-11-20): clocks to fill a 64 B line from L2, measured on Zen 5 (Ryzen 9 9950X3D),
# L2 chase 14.0 minus L1 chase 4.0 clk (card ~/scratch/m64idwork/fill/RESULT.txt). Derives 156 mclk/B; the unroll rate
# in lib.rs stays 312, borrowed from x86-m32: no consumer reads this row at m64 yet.
line_fill_clocks    10
pairing             =
# DEVIATE TA-LC (owner anyisa, exit 2026-11-27): m64 A/B, 1984 cells.
commute_loop_carried 1
# DEVIATE PHI-SHARE (owner x87, exit 2026-11-29): see CpuTable::share_congruent_phis.
# DEVIATE UNORDERED-ODDS (owner x87, exit 2026-11-24): see CpuTable::unordered_branch_odds.
unordered_branch_odds 1
share_congruent_phis 1
post_ra_tail_duplicate 1
