# `=` in a cell: the price is in the CPU's file, machine/tune/x86/<march>.toml, which holds the rows every
# target with that CPU agrees on. Correct such a price there; a row only this target states is here.
#
# x86-m32 prices, clocks, per CPU. Keys are the cost keys of the forms; a
# key absent here is the target having no such form (no far call, no segment
# load). Values are x86-m16's `timings.times` 486 and P5 columns for the forms
# both have. call_near and ret_near are NOT from there: 3/5 (486) and 1/2 (P5)
# and ret_pop 5/3 and leave 5/3 are recalled (a reviewer's figures), to be checked against the i486 data sheet and Agner Fog's
# tables before any measurement uses them. `prefix` is paid by 16-bit forms
# here, by 32-bit forms in m16.
#
# x87_release (`fstp st(i)`): 486 Intel's i486 data sheet 240440-002, Table 10.3, 3 clocks; P5 Intel 241430-004,
# instruction set, FST/FSTP (PDF page 755; Appendix F, PDF page 1023), 1 clock.
#
#
# The scalars: issue width, in-order (the 486 and P5 are), clocks decoding each
# operand-size prefix (paid by 16-bit forms here), the partial-register and
# length-changing-prefix stalls, and the P5's U/V pairing.
# The CPU a compile is priced for with no -march.
default_cpu           486
cpus                  486   P5
march                i486 pentium
issue                   =    =
in_order                =    =
prefix                  =    =
partial_stall           =    =
lcp_stall               =    =
# gcc's by-pieces limits for a constant memset (x86-tune-costs.h, gcc 13.4.0): stores while their count is under
# the ratio, else the CPU's stringop algorithm, `rep stos` of dwords here (i486_memset :256, pentium_memset :368).
# `set_ratio` (a nonzero byte) is MOVE_RATIO through defaults.h:1330's SET_RATIO: i486_cost :312, pentium_cost :424;
# `clear_ratio` (zero) is CLEAR_RATIO: :313, :425. The `_size` rows are the optimise-for-size path every CPU takes:
# i386.h:1866 MOVE_RATIO(speed false) 3, :1871 CLEAR_RATIO 2, its algorithm `rep stos` of bytes (ix86_size_memset :33).
set_ratio               =    =
clear_ratio             =    =
set_ratio_size          =    =
clear_ratio_size        =    =
# A switch of at least `jump_table` case values is a jump table: gcc's case_values_threshold, targhooks.cc:1846
# (4 with a `casesi` pattern, else 5); i386.md has `tablejump` (:15824) and no `casesi`, and i386.cc sets no
# TARGET_CASE_VALUES_THRESHOLD.
jump_table              =    =
# Bytes of a line of the first-level data cache, which loop interchange prices
# a walk by: the 486's 8 KB cache has 16 byte lines (Intel's i486 data sheet),
# the Pentium's, Pentium Pro's, K5's and K6's 32 (Intel and AMD's manuals), the
# Athlon's and Core 2's 64. The 386 has no cache on the chip.
cache_line             =    = 
# Clocks to fill one such line (a burst): the instruction cache's cost of a code byte once per run; 486 and Pentium state it
# (their CPU files), later CPUs do not.
line_fill_clocks             =    = 
# DEVIATE TAILDUP-HOT (owner x86-m32): gcc copies up to 8 instructions where it optimises for speed. Stated cost:
# x_jpeg_fixed/x_jpeg_single -O2 +32 B at 0 clk (a cold error tail in a loop; static frequency cannot tell). Exit: profile-fed frequencies (program PGO).
tail_dup_hot_threshold  8    8
pairing                 =    =
# DEVIATE TA-LC (owner anyisa, exit 2026-11-27): measured on the 486 (m32 A/B, 1984 cells); P5 off until measured.
commute_loop_carried    1    0
# DEVIATE PHI-SHARE (owner x87, exit 2026-11-29): see CpuTable::share_congruent_phis.
# DEVIATE UNORDERED-ODDS (owner x87, exit 2026-11-24): see CpuTable::unordered_branch_odds.
unordered_branch_odds 1 1
share_congruent_phis   1    1
# DEVIATE ISS1 (owner x86-m32, exit 2026-11-30): equal literal stores share a register at -O2/-O3 outside loops; pin: `MOV32mi`s. 2026-11-08 A/B: nbody -64 B, jpeg -78 B at -O2, 0 clk.
share_literal_stores    1    1
# Pin: MOV32r1, `OptForSize, Not64BitMode` (m64 has `mov r,1`, m16 never reaches the DAG form).
size_one_is_xor_inc     1    1
# DEVIATE SELB (owner x86-m32, exit 2026-11-30): a select of two constants is a branch in blocks run >= 2x per entry at -O2/-O3; pin: setcc+arithmetic.
# 2026-11-08 A/B: bintree -6.6% clk (-O2), -7.5% (-O3); sfm16_float_cmp +16 B for -5.6% clk.
branch_constant_selects 2    2

[clocks]
alu_rr       =   =
xchg_rr      =   =
alu_ri       =   =
alu_rm       =   =
alu_mr       =   =
mov_rr       =   =
mov_rm       =   =
