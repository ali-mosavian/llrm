idiv_r32     =   = 
idiv_m32     =   = 
push_r       =   =
push_m       =   =
push_i       =   =
pop_r        =   =
pop_m        =   =
leave        =   3
jmp_short    =   =
jmp_indirect  =   =
jcc          =   =
call_near    3   1
ret_near     5   2
ret_pop      5   3
rep_stos     =   =
rep_stos_cell =  =
rep_movs     =   = 
rep_movs_cell =  =
x87_load     =   =
x87_exchange =   =
x87_copy     =   =
x87_store    =   =
x87_release 3   1
x87_add      =   =
x87_mul      =   =
x87_div      =   = 
x87_convert_store =  =
x87_add_m    =   =
x87_mul_m    =   =
x87_div_m    =   = 
# Integer memory operands (fild, fiadd, fimul, fidiv, m16/m32int): 486 is Intel's i486 data sheet 240440-002, Table 10.3, the least of
# each range; P5 is the pair the form replaces (`fild` as a load plus the operation), as no source here states a cheaper one.
x87_load_i   =    =
x87_add_i    =    =
x87_mul_i    =    =
x87_div_i    =   = 
x87_cmp_i    =    =
x87_compare  =    =
x87_control_load = =
x87_control_store = =
mul_r16      =   = 
div_r16      =   = 
jcc_not_taken =  =
nop          =   =
lahf         =   =
sahf         =   1
unknown      =   =

# The latencies are the clocks, as the 386's are, until measured.

# Audited bounds of the signed multiply and divide (docs/measurement/timing-audit.md), where a CPU has them:
# the least and most clocks by operand width in bytes (`w2`, `w4`), and where the P5 prices the full product
# of a word differently (`smul_full_w2`). Read by backend/timing.rs; the divide has one figure.
smul_min_w2     =    = 
smul_max_w2     =    = 
smul_min_w4     =    = 
smul_max_w4     =    = 
smul_full_w2     -   = 
# Intel 240440-002 Table 10.1 note 3: n = 3 for a positive multiplier, 5 for a negative one (the bits floor of 10 + max(bits, n)).
smul_negative_bits  =    -
smul_multiplier     =    -
sdiv_w2         =    = 
sdiv_w4         =    = 
udiv_w2         =    = 
udiv_w4         =    = 

