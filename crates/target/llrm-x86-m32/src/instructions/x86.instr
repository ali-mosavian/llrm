# The forms flat 32-bit code adds to the family's: rel32 branches and calls,
# and no segment loads.
#
# name   operation shape            widths    cost        fixed                  iced
j{cc}     branch     -/-                -          jcc          -                       -       -       J{cc}_rel32_32
jmp       jump       -/-                -          jmp_short    -                       -       -       Jmp_rel32_32
call      call       -/-                -          call_near    -                       -       -       Call_rel32_32
# String operations name no segment: DS and ES are the one flat segment.
stosb     fill       m,r/r,r            8          rep_stos     s0=ax,s1=di,d1=di       es,-ax,ax*  -       Stosb_m8_AL
stosw     fill       m,r/r,r            16         rep_stos     s0=ax,s1=di,d1=di       es,-ax,ax*  -       Stosw_m16_AX
stosd     fill       m,r/r,r            32         rep_stos     s0=ax,s1=di,d1=di       es,-ax,ax*  -       Stosd_m32_EAX
stosb     fill       m,r,r/r,r,r        8          rep_stos     s0=ax,s1=cx,s2=di,d1=di,d2=cx  es,-ax,ax*  rep     Stosb_m8_AL
stosw     fill       m,r,r/r,r,r        16         rep_stos     s0=ax,s1=cx,s2=di,d1=di,d2=cx  es,-ax,ax*  rep     Stosw_m16_AX
stosd     fill       m,r,r/r,r,r        32         rep_stos     s0=ax,s1=cx,s2=di,d1=di,d2=cx  es,-ax,ax*  rep     Stosd_m32_EAX
movsb     copy       m,r,r/r,r          8          rep_movs     s0=si,s1=di,d1=si,d2=di  ds,es   -       Movsb_m8_m8
movsw     copy       m,r,r/r,r          16         rep_movs     s0=si,s1=di,d1=si,d2=di  ds,es   -       Movsw_m16_m16
movsd     copy       m,r,r/r,r          32         rep_movs     s0=si,s1=di,d1=si,d2=di  ds,es   -       Movsd_m32_m32
movsb     copy       m,r,r,r/r,r,r      8          rep_movs     s0=cx,s1=si,s2=di,d1=si,d2=di,d3=cx  ds,es   rep     Movsb_m8_m8
movsw     copy       m,r,r,r/r,r,r      16         rep_movs     s0=cx,s1=si,s2=di,d1=si,d2=di,d3=cx  ds,es   rep     Movsw_m16_m16
movsd     copy       m,r,r,r/r,r,r      32         rep_movs     s0=cx,s1=si,s2=di,d1=si,d2=di,d3=cx  ds,es   rep     Movsd_m32_m32
