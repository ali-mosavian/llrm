# Strings' and vecs' buffers (section 13): a descriptor in front of the
# data, [flags][pad][length][capacity], and a NUL after it. The length and
# capacity are words (usize), the flags and their pad one: 6 bytes on
# code16, 12 on code32.

import errors
import heap

pub const HEAP: u8 = 1
pub const READONLY: u8 = 8
const DESCRIPTOR: usize = 3 * NEAR_BYTES
const LENGTH_AT: usize = 2 * NEAR_BYTES
const CAPACITY_AT: usize = NEAR_BYTES
# The most a buffer's descriptor, data and NUL take.
const LARGEST: usize = (1 << (NEAR_BYTES * 8)) - 16
# A capacity below this doubles without overflowing.
const HALF: usize = 1 << (NEAR_BYTES * 8 - 1)

pub fn flags(data: *near mut u8) -> *near mut u8:
    return data.offset(-isize(DESCRIPTOR))

pub fn length(data: *near mut u8) -> *near mut usize:
    return data.offset(-isize(LENGTH_AT)).cast[usize]()

pub fn capacity(data: *near mut u8) -> *near mut usize:
    return data.offset(-isize(CAPACITY_AT)).cast[usize]()

pub fn copy(to: *near mut u8, source: *far u8, count: usize) -> void:
    unsafe:
        for at in 0..count:
            to[at] = source[at]

# Whether `capacity` elements of `size` bytes fit in one buffer.
fn fits(capacity: usize, size: usize) -> bool:
    return size == 0 || capacity <= (LARGEST - DESCRIPTOR - 1) // size

# An empty heap buffer for `capacity` elements of `size` bytes.
pub fn allocate(capacity: usize, size: usize) -> *near mut u8:
    if !fits(capacity, size):
        errors.panic("out of memory")
    let data = heap.allocate(capacity * size + DESCRIPTOR + 1).offset(isize(DESCRIPTOR))
    unsafe:
        *flags(data) = HEAP
        *flags(data).offset(1) = 0
        *length(data) = 0
        *capacity(data) = capacity
        *data = 0
    return data

# `data` on the heap and writable, with room for `capacity` elements:
# the same buffer when it already is, else a copy, and the old one
# dropped. Room at least doubles, so appending one at a time is linear.
@export(name="N$BRES")
pub fn reserve(data: *near mut u8, capacity: usize, size: usize) -> *near mut u8:
    unsafe:
        let length = *length(data)
        let room = *capacity(data)
        let wanted = capacity < length ? length : capacity
        let owned = *flags(data) & (HEAP | READONLY) == HEAP
        if owned && room >= wanted:
            return data
        let doubled = room < HALF ? room * 2 : room
        let target = (wanted < doubled && fits(doubled, size)) ? doubled : wanted
        if owned && fits(target, size) && heap.resize(data.offset(-isize(DESCRIPTOR)), target * size + DESCRIPTOR + 1):
            *capacity(data) = target
            return data
        let moved = allocate(target, size)
        copy(moved, data.far(), length * size + 1)
        *length(moved) = length
        drop(data)
        return moved

@export(name="N$BDRP")
pub fn drop(data: *near mut u8) -> void:
    unsafe:
        if !data.is_null() && *flags(data) & HEAP != 0:
            heap.release(data.offset(-isize(DESCRIPTOR)))

# `data` with `count` more elements counted in its length; it may move.
@export(name="N$BGRW")
fn grow(data: *near mut u8, count: usize, size: usize) -> *near mut u8:
    unsafe:
        let length = *length(data)
        let grown = reserve(data, length + count, size)
        *length(grown) = length + count
        return grown

# `data` without its last `count` elements; the new length.
@export(name="N$BSHR")
fn shrink(data: *near mut u8, count: usize) -> usize:
    unsafe:
        let length = *length(data)
        if length < count:
            errors.panic("pop from an empty vec")
        *length(data) = length - count
        return length - count

# A heap copy of `data`.
@export(name="N$BCLN")
fn clone(data: *near mut u8, size: usize) -> *near mut u8:
    unsafe:
        let length = *length(data)
        let copied = allocate(length, size)
        copy(copied, data.far(), length * size + 1)
        *length(copied) = length
        return copied
