}

// ---- leaves ----------------------------------------------------------------

Ident: Tree = <l:@L> "ident" => Tree::at(l);
IntLit: Tree = <l:@L> "int" => Tree::at(l);
RealLit: Tree = <l:@L> "real" => Tree::at(l);
StrLit: Tree = <l:@L> "str" => Tree::at(l);
Kws<K>: Tree = <k:K> => Tree::tok(k);
Nil: Tree = => Tree::Empty;
Opt<T>: Tree = { Nil, T };
Seq<T>: Tree = {
    <t:T> => Tree::List(vec![t]),
    <l:Seq<T>> <t:T> => Tree::push(l, t),
};
// One or more, comma separated.
Sep<T>: Tree = {
    <t:T> => Tree::List(vec![t]),
    <l:Sep<T>> "tkComma" <t:T> => Tree::push(l, t),
};
N<R>: Tree = R;

// ---- program and lines -----------------------------------------------------
//
// Blocks are not the grammar's: IF/ELSEIF/ELSE/END IF, loops, SUB bodies and
// SELECT CASE are lines of a flat list, nested by a later pass. On one line
// THEN, ELSE and `:` separate statements, so `IF c THEN x ELSE y` is the list
// [IF c, THEN, x, ELSE, y] and which IF an ELSE closes is that pass's answer.

pub Program: Tree = <l:Line*> => Tree::List(l);

Line: Tree = {
    "tkNewLine" => Tree::Empty,
    <s:LineStart> "tkNewLine" => s,
};

LineStart: Tree = {
    <n:IntLit> <s:Stmts> => Tree::node("Label", vec![n, s]),
    // a name and a colon at the line start is a label, never a call
    <n:Ident> "tkColon" <s:Stmts> => Tree::node("Label", vec![n, s]),
    <n:Ident> => Tree::node("Call", vec![n]),
    <s:SimpleNoBare> <t:Tail> => Tree::List(vec![s, t]),
    <h:Head> <s:StmtsAfterHead> => Tree::List(vec![h, s]),
    "tkELSE" <s:StmtsAfterHead> => Tree::node("ELSE", vec![s]),
    "tkColon" <s:Stmts> => s,
};

Stmts: Tree = {
    Nil,
    <s:Simple> <t:Tail> => Tree::List(vec![s, t]),
    <h:Head> <s:StmtsAfterHead> => Tree::List(vec![h, s]),
    "tkELSE" <s:StmtsAfterHead> => Tree::node("ELSE", vec![s]),
};

// after THEN or ELSE a bare line number is a GOTO
StmtsAfterHead: Tree = {
    Stmts,
    <n:IntLit> <t:Tail> => Tree::node("ThenLine", vec![n, t]),
};

Tail: Tree = {
    Nil,
    "tkColon" <s:Stmts> => s,
    "tkELSE" <s:StmtsAfterHead> => Tree::node("ELSE", vec![s]),
};

Head: Tree = {
    "tkIF" <c:Exp> "tkTHEN" => Tree::node("IF", vec![c]),
    "tkELSEIF" <c:Exp> "tkTHEN" => Tree::node("ELSEIF", vec![c]),
};

Simple: Tree = {
    SimpleNoBare,
    <n:Ident> => Tree::node("Call", vec![n]),
};

SimpleNoBare: Tree = {
    Flow, Declaration, Data, Io, Graphics, Machine,
    // `x = e`, `a(i) = e`, `r.f = e`: a name until a pass knows what it names
    <t:NameRef> "tkEQ" <e:Exp> => Tree::node("Assign", vec![t, e]),
    // `foo a, b`: a call without CALL or parentheses
    <n:Ident> <a:ExpListNP> => Tree::node("CallArgs", vec![n, a]),
    // `foo (a), b` and `foo(a)`: parentheses that are the call's or the first
    // argument's, which only the symbol table can tell
    <n:NameRefApplied> => Tree::node("CallApplied", vec![n]),
    <n:NameRefApplied> "tkComma" <a:ExpList> => Tree::node("CallAppliedList", vec![n, a]),
    // TYPE members: `name AS type`, the name any word
    <n:Ident> <a:AsPart> => Tree::node("Member", vec![n, a]),
    <n:NameRefApplied> <a:AsPart> => Tree::node("Member", vec![n, a]),
    <k:Keyword> <a:AsPart> => Tree::node("Member", vec![k, a]),
    <k:FnKeyword> "tkLParen" <d:ArgList> "tkRParen" <a:AsPart> => Tree::node("Member", vec![k, d, a]),
    "dynamic" => Tree::node("DYNAMIC", vec![]),
    "static" => Tree::node("STATIC", vec![]),
    "tkREM" => Tree::node("REM", vec![]),
};

// ---- control flow -----------------------------------------------------------

Flow: Tree = {
    "tkIF" <c:Exp> "tkGOTO" <l:LabLn> => Tree::node("IFGOTO", vec![c, l]),
    "tkFOR" <v:NameRef> "tkEQ" <a:Exp> "tkTO" <b:Exp> <s:("tkSTEP" <Exp>)?> => Tree::node("FOR", vec![v, a, b, Tree::opt(s)]),
    "tkNEXT" <v:Opt<Sep<NameRef>>> => Tree::node("NEXT", vec![v]),
    "tkWHILE" <c:Exp> => Tree::node("WHILE", vec![c]),
    "tkWEND" => Tree::node("WEND", vec![]),
    "tkDO" <c:Opt<LoopCond>> => Tree::node("DO", vec![c]),
    "tkLOOP" <c:Opt<LoopCond>> => Tree::node("LOOP", vec![c]),
    "tkSELECT" "tkCASE" <e:Exp> => Tree::node("SELECT", vec![e]),
    "tkCASE" "tkELSE" => Tree::node("CASEELSE", vec![]),
    "tkCASE" <i:Sep<CaseItem>> => Tree::node("CASE", vec![i]),
    "tkGOTO" <l:LabLn> => Tree::node("GOTO", vec![l]),
    "tkGOSUB" <l:LabLn> => Tree::node("GOSUB", vec![l]),
    "tkRETURN" <l:Opt<LabLn>> => Tree::node("RETURN", vec![l]),
    // `RESUME 0` is `RESUME` of the label 0: an integer is read by a pass
    "tkRESUME" <t:Opt<ResumeTarget>> => Tree::node("RESUME", vec![t]),
    "tkEXIT" <w:ExitWhat> => Tree::node("EXIT", vec![w]),
    "tkEND" => Tree::node("END", vec![]),
    "tkEND" <w:EndWhat> => Tree::node("END", vec![w]),
    "tkENDIF" => Tree::node("ENDIF", vec![]),
    "tkSTOP" => Tree::node("STOP", vec![]),
    "tkSYSTEM" => Tree::node("SYSTEM", vec![]),
    "tkRUN" <e:Opt<Exp>> => Tree::node("RUN", vec![e]),
    "tkERROR" <e:Exp> => Tree::node("ERROR", vec![e]),
    "tkON" "tkERROR" "tkGOTO" <l:LabLn> => Tree::node("ONERROR", vec![l]),
    "tkON" "tkLOCAL" "tkERROR" "tkGOTO" <l:LabLn> => Tree::node("ONLOCALERROR", vec![l]),
    "tkON" <e:OnEvent> "tkGOSUB" <l:LabLn> => Tree::node("ONEVENT", vec![e, l]),
    // PEN, PLAY(n) and STRIG(n) traps are `ON expr GOSUB` with a function
    // call for expr, read by a pass that knows the trap spellings
    "tkON" <e:Exp> <g:GotoGosub> <l:Sep<LabLn>> => Tree::node("ON", vec![e, g, l]),
};

LoopCond: Tree = {
    "tkWHILE" <e:Exp> => Tree::node("WHILE", vec![e]),
    "tkUNTIL" <e:Exp> => Tree::node("UNTIL", vec![e]),
};
CaseItem: Tree = {
    <a:Exp> <b:("tkTO" <Exp>)?> => Tree::node("Item", vec![a, Tree::opt(b)]),
    "tkIS" <r:RelOp> <e:Exp> => Tree::node("Is", vec![r, e]),
    <r:RelOp> <e:Exp> => Tree::node("Is", vec![r, e]),
};
ResumeTarget: Tree = { LabLn, Kws<"tkNEXT"> };
ExitWhat: Tree = { Kws<"tkDEF">, Kws<"tkFUNCTION">, Kws<"tkSUB">, Kws<"tkDO">, Kws<"tkFOR"> };
EndWhat: Tree = { Kws<"tkDEF">, Kws<"tkFUNCTION">, Kws<"tkIF">, Kws<"tkSELECT">, Kws<"tkSUB">, Kws<"tkTYPE"> };
GotoGosub: Tree = { Kws<"tkGOTO">, Kws<"tkGOSUB"> };
LabLn: Tree = { Ident, IntLit };
OnEvent: Tree = {
    "tkKEY" <a:Paren1> => Tree::node("KEY", vec![a]),
    "tkCOM" <a:Paren1> => Tree::node("COM", vec![a]),
    "tkSIGNAL" <a:Paren1> => Tree::node("SIGNAL", vec![a]),
    "tkTIMER" <a:Paren1> => Tree::node("TIMER", vec![a]),
    "tkPEN" => Tree::node("PEN", vec![]),
    "tkUEVENT" => Tree::node("UEVENT", vec![]),
};
Paren1: Tree = "tkLParen" <e:Exp> "tkRParen" => e;

// ---- declarations -------------------------------------------------------------

Declaration: Tree = {
    "tkDIM" <s:Opt<Kws<"tkSHARED">>> <l:Sep<DimName>> => Tree::node("DIM", vec![s, l]),
    "tkREDIM" <s:Opt<Kws<"tkSHARED">>> <l:Sep<DimName>> => Tree::node("REDIM", vec![s, l]),
    "tkSHARED" <l:Sep<VarName>> => Tree::node("SHARED", vec![l]),
    "tkSTATIC" <l:Sep<VarName>> => Tree::node("STATIC", vec![l]),
    "tkCOMMON" <s:Opt<Kws<"tkSHARED">>> <b:Opt<CommonBlock>> <l:Sep<VarName>> => Tree::node("COMMON", vec![s, b, l]),
    "tkCONST" <l:Sep<ConstAssign>> => Tree::node("CONST", vec![l]),
    "tkTYPE" <n:TypeName> => Tree::node("TYPE", vec![n]),
    "tkDEFINT" <r:LetterRanges> => Tree::node("DEFINT", vec![r]),
    "tkDEFLNG" <r:LetterRanges> => Tree::node("DEFLNG", vec![r]),
    "tkDEFSNG" <r:LetterRanges> => Tree::node("DEFSNG", vec![r]),
    "tkDEFDBL" <r:LetterRanges> => Tree::node("DEFDBL", vec![r]),
    "tkDEFSTR" <r:LetterRanges> => Tree::node("DEFSTR", vec![r]),
    // DEFBYTE and the DEFU* statements: the keyword is an extension word
    "ext" <r:LetterRanges> => Tree::node("DEFEXT", vec![r]),
    // OPTION BASE n; OPTION EXPLICIT
    "tkOPTION" "tkBASE" <n:IntLit> => Tree::node("OPTIONBASE", vec![n]),
    "tkOPTION" "ext" => Tree::node("OPTIONEXT", vec![]),
    "tkERASE" <l:Sep<ArrayName>> => Tree::node("ERASE", vec![l]),
    "tkDECLARE" <k:ProcKind> <n:ProcName> <c:Opt<CdeclAlias>> <p:Parms> <r:OptReturnAs> => Tree::node("DECLARE", vec![k, n, c, p, r]),
        <p:ProcStmt> => p,
    // PRIVATE (QuickrBASIC) is a name before SUB and FUNCTION, checked later
    <x:Ident> <p:ProcStmt> => p,
    "tkDEF" <n:Ident> <p:Parms> <e:("tkEQ" <Exp>)?> => Tree::node("DEFFN", vec![n, p, Tree::opt(e)]),
    "tkDEF" "tkSEG" <e:("tkEQ" <Exp>)?> => Tree::node("DEFSEG", vec![Tree::opt(e)]),
};

ProcStmt: Tree = {
    "tkFUNCTION" <n:ProcName> <p:Parms> <r:OptReturnAs> <s:Opt<Kws<"tkSTATIC">>> => Tree::node("FUNCTION", vec![n, p, r, s]),
    "tkSUB" <n:ProcName> <p:Parms> <s:Opt<Kws<"tkSTATIC">>> => Tree::node("SUB", vec![n, p, s]),
};
ProcKind: Tree = { Kws<"tkFUNCTION">, Kws<"tkSUB"> };
ProcName: Tree = { Ident, FnKeyword };
TypeName: Tree = { Ident, FnKeyword };
CdeclAlias: Tree = {
    "tkCDECL" <a:("tkALIAS" <StrLit>)?> => Tree::opt(a),
    "tkALIAS" <a:StrLit> => a,
};
CommonBlock: Tree = "tkDiv" <n:Ident> "tkDiv" => n;
Parms: Tree = {
    Nil,
    "tkLParen" <l:Opt<Sep<Parm>>> "tkRParen" => l,
};
Parm: Tree = {
    <m:Opt<ParmMode>> <i:Ident> <p:Opt<EmptyParens>> <a:OptAs> => Tree::node("Parm", vec![m, i, a]),
};
ParmMode: Tree = { Kws<"tkBYVAL">, Kws<"tkSEG"> };
EmptyParens: Tree = "tkLParen" "tkRParen" => Tree::Empty;
OptReturnAs: Tree = { Nil, "tkAS" <c:AsClause> => c };
// `AS VOLATILE INTEGER`: a modifier is a name before the type
AsPart: Tree = "tkAS" <m:Ident*> <c:AsClause> <n:("tkMult" <Exp>)?> => Tree::node("As", vec![c, Tree::opt(n)]);
OptAs: Tree = { Nil, AsPart };
AsClause: Tree = {
    "tkINTEGER" => Tree::node("INTEGER", vec![]),
    "tkLONG" => Tree::node("LONG", vec![]),
    "tkSINGLE" => Tree::node("SINGLE", vec![]),
    "tkDOUBLE" => Tree::node("DOUBLE", vec![]),
    "tkSTRING" => Tree::node("STRING", vec![]),
    "tkANY" => Tree::node("ANY", vec![]),
    <n:TypeName> => Tree::node("TypeName", vec![n]),
};
DimName: Tree = <n:VarWord> <d:("tkLParen" <Opt<Sep<ArgItem>>> "tkRParen")?> <a:OptAs> => Tree::node("Dim", vec![n, Tree::opt(d), a]);
VarName: Tree = <n:VarWord> <p:Opt<EmptyParens>> <a:OptAs> => Tree::node("Var", vec![n, a]);
ArrayName: Tree = <n:VarWord> <p:Opt<EmptyParens>> => n;
// a function's name is a variable's too when no parenthesis follows
VarWord: Tree = { Ident, FnKeyword, CtxName };
ConstAssign: Tree = <i:Ident> "tkEQ" <e:Exp> => Tree::node("ConstAssign", vec![i, e]);
LetterRanges: Tree = Sep<LetterRange>;
LetterRange: Tree = <a:Ident> <b:("tkMinus" <Ident>)?> => Tree::node("Range", vec![a, Tree::opt(b)]);

// ---- data and files -------------------------------------------------------------

Data: Tree = {
    "tkDATA" <e:Sep<OptExp>> => Tree::node("DATA", vec![e]),
    "tkREAD" <l:Sep<NameRef>> => Tree::node("READ", vec![l]),
    "tkRESTORE" <l:Opt<LabLn>> => Tree::node("RESTORE", vec![l]),
    "tkLET" <t:NameRef> "tkEQ" <e:Exp> => Tree::node("Assign", vec![t, e]),
    "tkSWAP" <a:NameRef> "tkComma" <b:NameRef> => Tree::node("SWAP", vec![a, b]),
    "tkLSET" <t:NameRef> "tkEQ" <e:Exp> => Tree::node("LSET", vec![t, e]),
    "tkRSET" <t:NameRef> "tkEQ" <e:Exp> => Tree::node("RSET", vec![t, e]),
    "tkMID_" "tkLParen" <t:NameRef> "tkComma" <a:Exp> <b:("tkComma" <Exp>)?> "tkRParen" "tkEQ" <e:Exp>
        => Tree::node("MIDASSIGN", vec![t, a, Tree::opt(b), e]),
    "tkDATE_" "tkEQ" <e:Exp> => Tree::node("DATEASSIGN", vec![e]),
    "tkTIME_" "tkEQ" <e:Exp> => Tree::node("TIMEASSIGN", vec![e]),
    "tkRANDOMIZE" <e:Opt<Exp>> => Tree::node("RANDOMIZE", vec![e]),
};

Filenum: Tree = { "tkLbs" <e:Exp> => e, Exp };

Io: Tree = {
    "tkPRINT" <f:Opt<ChannelComma>> <l:PrintList> => Tree::node("PRINT", vec![f, l]),
    "tkLPRINT" <l:PrintList> => Tree::node("LPRINT", vec![l]),
    "tkWRITE" <f:Opt<ChannelComma>> <l:Opt<WriteList>> => Tree::node("WRITE", vec![f, l]),
    "tkINPUT" <p:InputPrefix> <l:Sep<NameRef>> => Tree::node("INPUT", vec![p, l]),
    "tkLINE" "tkINPUT" <p:InputPrefix> <v:NameRef> => Tree::node("LINEINPUT", vec![p, v]),
    "tkOPEN" <f:Exp> <t:OpenTail> => Tree::node("OPEN", vec![f, t]),
    "tkCLOSE" <l:Opt<Sep<Filenum>>> => Tree::node("CLOSE", vec![l]),
    "tkFIELD" <f:Filenum> <l:FieldItems> => Tree::node("FIELD", vec![f, l]),
    "tkGET" <f:Filenum> <t:RecordTail> => Tree::node("GET", vec![f, t]),
    "tkPUT" <f:Filenum> <t:RecordTail> => Tree::node("PUT", vec![f, t]),
    "tkSEEK" <f:Filenum> "tkComma" <e:Exp> => Tree::node("SEEK", vec![f, e]),
    "tkIOCTL" <f:Filenum> "tkComma" <e:Exp> => Tree::node("IOCTL", vec![f, e]),
    "tkLOCK" <f:Filenum> <r:Opt<LockRange>> => Tree::node("LOCK", vec![f, r]),
    "tkUNLOCK" <f:Filenum> <r:Opt<LockRange>> => Tree::node("UNLOCK", vec![f, r]),
    "tkNAME" <a:Exp> "tkAS" <b:Exp> => Tree::node("NAME", vec![a, b]),
    "tkKILL" <e:Exp> => Tree::node("KILL", vec![e]),
    "tkMKDIR" <e:Exp> => Tree::node("MKDIR", vec![e]),
    "tkCHDIR" <e:Exp> => Tree::node("CHDIR", vec![e]),
    "tkRMDIR" <e:Exp> => Tree::node("RMDIR", vec![e]),
    "tkFILES" <e:Opt<Exp>> => Tree::node("FILES", vec![e]),
    "tkRESET" => Tree::node("RESET", vec![]),
    "tkCHAIN" <e:Exp> => Tree::node("CHAIN", vec![e]),
    "tkSHELL" <e:Opt<Exp>> => Tree::node("SHELL", vec![e]),
    "tkENVIRON" <e:Exp> => Tree::node("ENVIRON", vec![e]),
    "tkBLOAD" <a:Exp> <b:("tkComma" <Exp>)?> => Tree::node("BLOAD", vec![a, Tree::opt(b)]),
    "tkBSAVE" <a:Exp> "tkComma" <b:Exp> "tkComma" <c:Exp> => Tree::node("BSAVE", vec![a, b, c]),
    "tkWIDTH" "tkLbs" <a:Exp> "tkComma" <b:Exp> => Tree::node("WIDTHFILE", vec![a, b]),
    "tkWIDTH" "tkLPRINT" <e:Exp> => Tree::node("WIDTHLPRINT", vec![e]),
    "tkWIDTH" <a:Exp> <b:("tkComma" <Exp>)?> => Tree::node("WIDTH", vec![a, Tree::opt(b)]),
    "tkWIDTH" "tkComma" <b:Exp> => Tree::node("WIDTH", vec![b]),
};

ChannelComma: Tree = "tkLbs" <e:Exp> "tkComma" => e;

// `PRINT a; b, TAB(3) c USING f$; x`: an expression is followed by a
// separator, the end of the statement, ELSE or USING, never by another
// expression, so the last expression is the list's final item.
PrintList: Tree = <h:PrintHead> <f:Opt<Exp>> <u:UsingTail?> => Tree::node("PrintList", vec![h, f, Tree::opt(u)]);
UsingTail: Tree = "tkUSING" <e:Exp> "tkSColon" <h:PrintHead> <f:Opt<Exp>> => Tree::List(vec![e, h, f]);
PrintHead: Tree = {
    => Tree::List(vec![]),
    <l:PrintHead> <s:PrintStep> => Tree::push(l, s),
};
PrintStep: Tree = {
    "tkTAB" <a:Paren1> => Tree::node("TAB", vec![a]),
    "tkSPC" <a:Paren1> => Tree::node("SPC", vec![a]),
    "tkComma" => Tree::Empty,
    "tkSColon" => Tree::Empty,
    <e:Exp> "tkComma" => e,
    <e:Exp> "tkSColon" => e,
};
WriteList: Tree = {
    <e:Exp> => Tree::List(vec![e]),
    <l:WriteList> <s:WriteSep> <e:Exp> => Tree::push(l, e),
};
WriteSep: Tree = { Kws<"tkComma">, Kws<"tkSColon"> };

InputPrefix: Tree = {
    Nil,
    "tkLbs" <e:Exp> "tkComma" => Tree::node("Channel", vec![e]),
    "tkSColon" <p:Opt<PromptSep>> => p,
    <p:PromptSep> => p,
};
PromptSep: Tree = <s:StrLit> <w:WriteSep> => s;

OpenTail: Tree = {
    <m:Opt<OpenMode>> <a:Opt<OpenAccess>> <l:Opt<OpenLock>> "tkAS" <f:Filenum> <n:("tkLEN" "tkEQ" <Exp>)?>
        => Tree::node("Modern", vec![m, a, l, f, Tree::opt(n)]),
    // OPEN "I", #1, "file"[, len]
    "tkComma" <f:Filenum> "tkComma" <n:Exp> <r:("tkComma" <Exp>)?> => Tree::node("Classic", vec![f, n, Tree::opt(r)]),
};
OpenMode: Tree = "tkFOR" <m:OpenModeWord> => m;
OpenModeWord: Tree = { Kws<"tkAPPEND">, Kws<"tkINPUT">, Kws<"tkOUTPUT">, Kws<"tkRANDOM">, Kws<"tkBINARY"> };
OpenAccess: Tree = {
    "tkACCESS" "tkREAD" <w:Opt<Kws<"tkWRITE">>> => Tree::node("Access", vec![w]),
    "tkACCESS" "tkWRITE" => Tree::node("Access", vec![]),
};
OpenLock: Tree = {
    "tkLOCK" "tkREAD" <w:Opt<Kws<"tkWRITE">>> => Tree::node("Lock", vec![w]),
    "tkLOCK" "tkWRITE" => Tree::node("Lock", vec![]),
    "tkSHARED" => Tree::node("Shared", vec![]),
};
FieldItems: Tree = Seq<FieldItem>;
FieldItem: Tree = "tkComma" <w:Exp> "tkAS" <v:NameRef> => Tree::node("Field", vec![w, v]);
// GET/PUT [#]n [, [record] [, var]]
RecordTail: Tree = {
    Nil,
    "tkComma" <r:Opt<Exp>> <v:("tkComma" <NameRef>)?> => Tree::node("Record", vec![r, Tree::opt(v)]),
};
LockRange: Tree = {
    "tkComma" <a:Exp> <b:("tkTO" <Exp>)?> => Tree::node("Range", vec![a, Tree::opt(b)]),
    "tkComma" "tkTO" <b:Exp> => Tree::node("Range", vec![b]),
};

// ---- graphics and screen ------------------------------------------------------------

// Trailing optional arguments are a list of `, [exp]`; how many a statement
// takes, and that B and BF in LINE are names, is a later pass's.
Rest: Tree = Seq<RestItem>;
RestItem: Tree = "tkComma" <e:OptExp> => e;
OptRest: Tree = { Nil, Rest };

Graphics: Tree = {
    "tkPSET" <c:CoordStep> <r:OptRest> => Tree::node("PSET", vec![c, r]),
    "tkPRESET" <c:CoordStep> <r:OptRest> => Tree::node("PRESET", vec![c, r]),
    "tkPAINT" <c:CoordStep> <r:OptRest> => Tree::node("PAINT", vec![c, r]),
    "tkCIRCLE" <c:CoordStep> "tkComma" <e:Exp> <r:OptRest> => Tree::node("CIRCLE", vec![c, e, r]),
    "tkLINE" <c:Opt<CoordStep>> "tkMinus" <d:CoordStep> <r:OptRest> => Tree::node("LINE", vec![c, d, r]),
    "tkGET" <c:CoordStep> "tkMinus" <d:CoordStep> "tkComma" <v:NameRef> => Tree::node("GETGFX", vec![c, d, v]),
    "tkPUT" <c:CoordStep> "tkComma" <v:NameRef> <a:("tkComma" <PutAction>)?> => Tree::node("PUTGFX", vec![c, v, Tree::opt(a)]),
    "tkDRAW" <e:Exp> => Tree::node("DRAW", vec![e]),
    "tkVIEW" <w:ViewRest> => Tree::node("VIEW", vec![w]),
    "tkWINDOW" <w:WindowRest> => Tree::node("WINDOW", vec![w]),
    "tkSCREEN" <a:OptExpList> => Tree::node("SCREEN", vec![a]),
    "tkCOLOR" <a:OptExpList> => Tree::node("COLOR", vec![a]),
    "tkLOCATE" <a:OptExpList> => Tree::node("LOCATE", vec![a]),
    "tkCLS" <e:Opt<Exp>> => Tree::node("CLS", vec![e]),
    "tkPALETTE" <w:PaletteRest> => Tree::node("PALETTE", vec![w]),
    "tkPCOPY" <a:Exp> "tkComma" <b:Exp> => Tree::node("PCOPY", vec![a, b]),
};
CoordStep: Tree = {
    "tkSTEP" <p:CoordPair> => Tree::node("Step", vec![p]),
    CoordPair,
};
CoordPair: Tree = "tkLParen" <a:Exp> "tkComma" <b:Exp> "tkRParen" => Tree::List(vec![a, b]);
PutAction: Tree = { Kws<"tkAND">, Kws<"tkOR">, Kws<"tkPRESET">, Kws<"tkPSET">, Kws<"tkXOR"> };
ViewRest: Tree = {
    "tkPRINT" <r:(<Exp> "tkTO" <Exp>)?> => Tree::node("Print", vec![Tree::opt(r.map(|(a, b)| Tree::List(vec![a, b])))]),
    "tkSCREEN" <a:CoordPair> "tkMinus" <b:CoordPair> <r:OptRest> => Tree::node("Screen", vec![a, b, r]),
    <a:CoordPair> "tkMinus" <b:CoordPair> <r:OptRest> => Tree::node("Port", vec![a, b, r]),
    Nil,
};
WindowRest: Tree = {
    "tkSCREEN" <a:CoordPair> "tkMinus" <b:CoordPair> => Tree::node("Screen", vec![a, b]),
    <a:CoordPair> "tkMinus" <b:CoordPair> => Tree::node("World", vec![a, b]),
    Nil,
};
PaletteRest: Tree = {
    Nil,
    "tkUSING" <v:NameRef> => Tree::node("Using", vec![v]),
    <a:Exp> "tkComma" <b:Exp> => Tree::List(vec![a, b]),
};

// ---- sound, ports, events, memory --------------------------------------------------------

Machine: Tree = {
    "tkBEEP" => Tree::node("BEEP", vec![]),
    "tkSOUND" <a:Exp> "tkComma" <b:Exp> => Tree::node("SOUND", vec![a, b]),
    "tkPLAY" <e:Exp> => Tree::node("PLAY", vec![e]),
    "tkOUT" <a:Exp> "tkComma" <b:Exp> => Tree::node("OUT", vec![a, b]),
    "tkPOKE" <a:Exp> "tkComma" <b:Exp> => Tree::node("POKE", vec![a, b]),
    "tkWAIT" <a:Exp> "tkComma" <b:Exp> <c:("tkComma" <Exp>)?> => Tree::node("WAIT", vec![a, b, Tree::opt(c)]),
    "tkSLEEP" <e:Opt<Exp>> => Tree::node("SLEEP", vec![e]),
    "tkCLEAR" <a:OptExpList> => Tree::node("CLEAR", vec![a]),
    "tkTRON" => Tree::node("TRON", vec![]),
    "tkTROFF" => Tree::node("TROFF", vec![]),
    "tkCALL" <n:ProcName> <a:("tkLParen" <Opt<Sep<CallArg>>> "tkRParen")?> => Tree::node("CALL", vec![n, Tree::opt(a)]),
    "tkCALLS" <n:ProcName> <a:("tkLParen" <Opt<Sep<Exp>>> "tkRParen")?> => Tree::node("CALLS", vec![n, Tree::opt(a)]),
    // event switches: ON, OFF, STOP after the event
    "tkCOM" <n:Paren1> <s:Switch> => Tree::node("COMSWITCH", vec![n, s]),
    "tkSIGNAL" <n:Paren1> <s:Switch> => Tree::node("SIGNALSWITCH", vec![n, s]),
    "tkPEN" <s:Switch> => Tree::node("PENSWITCH", vec![s]),
    "tkPLAY" <s:Switch> => Tree::node("PLAYSWITCH", vec![s]),
    "tkTIMER" <s:Switch> => Tree::node("TIMERSWITCH", vec![s]),
    "tkUEVENT" <s:Switch> => Tree::node("UEVENTSWITCH", vec![s]),
    "tkSTRIG" <n:Paren1> <s:Switch> => Tree::node("STRIGSWITCH", vec![n, s]),
    "tkSTRIG" <s:Kws<"tkON">> => Tree::node("STRIG", vec![s]),
    "tkSTRIG" <s:Kws<"tkOFF">> => Tree::node("STRIG", vec![s]),
    // KEY ON|OFF|LIST, KEY (n) ON, KEY n, text$: the key number is an expression
    "tkKEY" <w:KeyWord> => Tree::node("KEY", vec![w]),
    "tkKEY" <n:Exp> <t:KeyTail> => Tree::node("KEY", vec![n, t]),
};
Switch: Tree = { Kws<"tkON">, Kws<"tkOFF">, Kws<"tkSTOP"> };
KeyWord: Tree = { Kws<"tkOFF">, Kws<"tkON">, Kws<"tkLIST"> };
KeyTail: Tree = { Switch, "tkComma" <e:Exp> => e };
CallArg: Tree = <b:Opt<Kws<"tkBYVAL">>> <s:Opt<Kws<"tkSEG">>> <e:Exp> => Tree::node("CallArg", vec![e]);

// ---- names -----------------------------------------------------------------------------------

// A name with parentheses is an array element, a function call or a
// parenthesised argument; with fields it is a record access. Nothing here
// chooses.
NameRef: Tree = {
    <i:Ident> => Tree::node("Name", vec![i]),
    NameRefApplied,
    <r:NameRef> "period" <i:FieldName> => Tree::node("Field", vec![r, i]),
    // a function's name used as a variable
    <k:FnKeyword> => Tree::node("Name", vec![k]),
};
NameRefApplied: Tree = {
    <i:Ident> "tkLParen" <a:ArgList> "tkRParen" => Tree::node("Apply", vec![i, a]),
    <r:NameRef> "period" <i:FieldName> "tkLParen" <a:ArgList> "tkRParen" => Tree::node("FieldApply", vec![r, i, a]),
};
FieldName: Tree = { Ident, Keyword };

ArgList: Tree = { Nil, ExpList };
// an argument may be a range, TO: array bounds read like arguments
ExpList: Tree = Sep<ArgItem>;
ArgItem: Tree = {
    Exp,
    <a:Exp> "tkTO" <b:Exp> => Tree::node("To", vec![a, b]),
};
ExpListNP: Tree = {
    <e:ExpNP> => Tree::List(vec![e]),
    <l:ExpListNP> "tkComma" <e:Exp> => Tree::push(l, e),
};
OptExp: Tree = Opt<Exp>;
OptExpList: Tree = Sep<OptExp>;

// ---- expressions --------------------------------------------------------------------------------
//
// QuickBASIC precedence, loosest first: IMP EQV XOR OR AND NOT relations
// + - MOD \ * / unary-minus ^. `P` is the primary a level starts with: the
// full one, or the one without a leading parenthesis, which a statement
// `foo (a), b` needs to leave to NameRef.

Exp: Tree = Imp<Primary>;
ExpNP: Tree = Imp<PrimaryNP>;

Binary<Op, Left, Right>: Tree = {
    <l:Left> <o:Op> <r:Right> => Tree::node("Binary", vec![l, Tree::tok(o), r]),
};

Imp<P>: Tree = { Eqv<P>, Binary<"tkIMP", Imp<P>, Eqv<Primary>> };
Eqv<P>: Tree = { Xor<P>, Binary<"tkEQV", Eqv<P>, Xor<Primary>> };
Xor<P>: Tree = { Or<P>, Binary<"tkXOR", Xor<P>, Or<Primary>> };
Or<P>: Tree = { And<P>, Binary<"tkOR", Or<P>, And<Primary>> };
And<P>: Tree = { Not<P>, Binary<"tkAND", And<P>, Not<Primary>> };
Not<P>: Tree = {
    Rel<P>,
    <o:"tkNOT"> <e:Not<Primary>> => Tree::node("Unary", vec![Tree::tok(o), e]),
};
Rel<P>: Tree = {
    Add<P>,
    <l:Rel<P>> <o:RelOp> <r:Add<Primary>> => Tree::node("Binary", vec![l, o, r]),
};
RelOp: Tree = {
    <o:"tkEQ"> => Tree::tok(o),
    <o:"tkLT"> => Tree::tok(o),
    <o:"tkGT"> => Tree::tok(o),
    <l:@L> "le" => Tree::at(l),
    <l:@L> "ne" => Tree::at(l),
    <l:@L> "ge" => Tree::at(l),
};
Add<P>: Tree = { Mod<P>, Binary<AddOp, Add<P>, Mod<Primary>> };
AddOp: Tok = { "tkAdd", "tkMinus" };
Mod<P>: Tree = { IDiv<P>, Binary<"tkMOD", Mod<P>, IDiv<Primary>> };
IDiv<P>: Tree = { Mul<P>, Binary<"tkIdiv", IDiv<P>, Mul<Primary>> };
Mul<P>: Tree = { Neg<P>, Binary<MulOp, Mul<P>, Neg<Primary>> };
MulOp: Tok = { "tkMult", "tkDiv" };
Neg<P>: Tree = {
    Pow<P>,
    <o:AddOp> <e:Neg<Primary>> => Tree::node("Unary", vec![Tree::tok(o), e]),
};
Pow<P>: Tree = { P, Binary<"tkPwr", Pow<P>, PowOperand> };
PowOperand: Tree = {
    Primary,
    <o:AddOp> <e:PowOperand> => Tree::node("Unary", vec![Tree::tok(o), e]),
};

Primary: Tree = {
    PrimaryNP,
    "tkLParen" <e:Exp> "tkRParen" => Tree::node("Paren", vec![e]),
};
PrimaryNP: Tree = { IntLit, RealLit, StrLit, Function, NameRef, CtxName };

// Built-in functions by the shape of their arguments.
Function: Tree = {
    <k:Fn0> => Tree::node("Fn", vec![Tree::tok(k)]),
    <k:Fn1> "tkLParen" <a:Exp> "tkRParen" => Tree::node("Fn", vec![Tree::tok(k), a]),
    <k:Fn2> "tkLParen" <a:Exp> "tkComma" <b:Exp> "tkRParen" => Tree::node("Fn", vec![Tree::tok(k), a, b]),
    <k:Fn23> "tkLParen" <a:Exp> "tkComma" <b:Exp> <c:("tkComma" <Exp>)?> "tkRParen" => Tree::node("Fn", vec![Tree::tok(k), a, b, Tree::opt(c)]),
    <k:FnBound> "tkLParen" <a:NameRef> <b:("tkComma" <Exp>)?> "tkRParen" => Tree::node("Fn", vec![Tree::tok(k), a, Tree::opt(b)]),
    <k:FnRef> "tkLParen" <a:NameRef> "tkRParen" => Tree::node("Fn", vec![Tree::tok(k), a]),
    "tkPOINT" "tkLParen" <a:Exp> <b:("tkComma" <Exp>)?> "tkRParen" => Tree::node("Fn", vec![a, Tree::opt(b)]),
    "tkRND" <a:Opt<Paren1>> => Tree::node("Fn", vec![a]),
    "tkINPUT_" "tkLParen" <a:Exp> <b:("tkComma" <Filenum>)?> "tkRParen" => Tree::node("Fn", vec![a, Tree::opt(b)]),
    "tkIOCTL_" "tkLParen" <a:Filenum> "tkRParen" => Tree::node("Fn", vec![a]),
};
Fn0: Tok = { "tkCOMMAND_", "tkCSRLIN", "tkDATE_", "tkERDEV", "tkERDEV_", "tkERL", "tkERR", "tkFREEFILE", "tkINKEY_", "tkTIME_", "tkTIMER" };
