// The QB-family grammar, by hand. Reference: the recovered qbasbnf.prs, whose
// ordered choices and greedy optionals are written here as the context-free
// shapes they mean. It builds the generic tree; names, calls and block
// structure are for later passes.

use crate::qb_kw::Kw;
use crate::qb_tokens::Tok;
use crate::qb_tree::Tree;

grammar;

extern {
    type Location = usize;
    type Error = crate::qb_tokens::Never;

    enum Tok {
        "tkEtInteger" => Tok::Kw(Kw::EtInteger),
        "tkEtLong" => Tok::Kw(Kw::EtLong),
        "tkEtSingle" => Tok::Kw(Kw::EtSingle),
        "tkLbs" => Tok::Kw(Kw::Lbs),
        "tkEtString" => Tok::Kw(Kw::EtString),
        "tkDQuote" => Tok::Kw(Kw::DQuote),
