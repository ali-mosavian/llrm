        "tkLCASE_" => Tok::Kw(Kw::LCASE_),
        "tkLEFT_" => Tok::Kw(Kw::LEFT_),
        "tkLEN" => Tok::Kw(Kw::LEN),
        "tkLET" => Tok::Kw(Kw::LET),
        "tkLINE" => Tok::Kw(Kw::LINE),
