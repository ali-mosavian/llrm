        "tkINKEY_" => Tok::Kw(Kw::INKEY_),
        "tkINP" => Tok::Kw(Kw::INP),
        "tkINPUT" => Tok::Kw(Kw::INPUT),
        "tkINPUT_" => Tok::Kw(Kw::INPUT_),
