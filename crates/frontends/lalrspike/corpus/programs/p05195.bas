TYPE Inner
v(3) AS INTEGER
w AS INTEGER
END TYPE
TYPE Rec
a(5) AS INTEGER
b(1 TO 3, 1 TO 4) AS LONG
s(2) AS STRING * 4
d(2) AS DOUBLE
n AS INTEGER
t AS STRING * 6
END TYPE
TYPE Outer
i(2) AS Inner
q AS Inner
END TYPE
DECLARE FUNCTION f% (z AS Rec)
DIM r AS Rec
PRINT f%(r)
END
FUNCTION f% (z AS Rec)
f% = z.a(1) + z.b(1, 2)
END FUNCTION
