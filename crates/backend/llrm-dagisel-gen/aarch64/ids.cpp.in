// Prints `name value` for every symbol the pin's AArch64GenDAGISel.inc names; ids.sh fills in the lists.
#include "llvm/CodeGen/ISDOpcodes.h"
#include "llvm/CodeGen/TargetOpcodes.h"
#include "llvm/CodeGen/ValueTypes.h"
#include "MCTargetDesc/AArch64MCTargetDesc.h"
#include "AArch64SelectionDAGInfo.h"
#include <cstdio>

using namespace llvm;

// @ENUMS@

#define P(sym) std::printf("%s %lld\n", #sym, (long long)(sym))

int main() {
  @MEMBERS@
  @SYMBOLS@
  return 0;
}

// Defined by the library the header would link against; nothing here needs it.
namespace llvm { int DisableABIBreakingChecks = 0; }
