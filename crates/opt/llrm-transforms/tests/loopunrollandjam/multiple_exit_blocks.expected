== -allow-unroll-and-jam -unroll-and-jam-count=8
@h
B0:
  store i32 4, ptr @e
  %v0 = load i16, ptr @b
  %v1 = icmp slt i16 %v0, 1
  br label %B1
B1:
  %v2 = phi i32 [ %v8, %B6 ], [ 4, %B0 ]
  br label %B2
B2:
  %v3 = phi i16 [ %v5, %B5 ], [ 0, %B1 ]
  br i1 %v1, label %B3, label %B5
B3:
  %v4 = phi i16 [ %v3, %B2 ]
  store i16 %v4, ptr @f
  br label %B4
B4:
  br label %B4
B5:
  %v5 = add nuw nsw i16 %v3, 1
  %v6 = icmp ult i16 %v3, 7
  br i1 %v6, label %B2, label %B6
B6:
  %v7 = phi i16 [ %v5, %B5 ]
  %v8 = add nsw i32 %v2, -1
  store i32 %v8, ptr @e
  %v9 = icmp eq i32 %v8, 0
  br i1 %v9, label %B7, label %B1
B7:
  %v10 = phi i16 [ %v7, %B6 ]
  store i16 %v10, ptr @f
  ret void
