== -allow-unroll-and-jam -unroll-and-jam-count=2
@disable_nonforced
B0:
  %v0 = icmp ne i32 %J, 0
  %v1 = icmp ne i32 %I, 0
  %v2 = and i1 %v0, %v1
  br i1 %v2, label %B1, label %B6
B1:
  br label %B2
B2:
  %v3 = phi i32 [ %v13, %B4 ], [ 0, %B1 ]
  br label %B3
B3:
  %v4 = phi i32 [ %v9, %B3 ], [ 0, %B2 ]
  %v5 = phi i32 [ %v8, %B3 ], [ 0, %B2 ]
  %v6 = getelementptr inbounds i32, ptr %B, i32 %v4
  %v7 = load i32, ptr %v6
  %v8 = add i32 %v7, %v5
  %v9 = add nuw i32 %v4, 1
  %v10 = icmp eq i32 %v9, %J
  br i1 %v10, label %B4, label %B3
B4:
  %v11 = phi i32 [ %v8, %B3 ]
  %v12 = getelementptr inbounds i32, ptr %A, i32 %v3
  store i32 %v11, ptr %v12
  %v13 = add nuw i32 %v3, 1
  %v14 = icmp eq i32 %v13, %I
  br i1 %v14, label %B5, label %B2
B5:
  br label %B6
B6:
  ret void
