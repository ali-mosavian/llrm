== -allow-unroll-and-jam -unroll-and-jam-count=4
@test1
B0:
  br i1 false, label %B1, label %B7
B1:
  %v0 = phi i16 [ %v26, %B11 ], [ 0, %B0 ]
  call void @llvm.assume(i1 true)
  br label %B2
B2:
  %v1 = phi i16 [ %v0, %B1 ], [ %v6, %B4 ]
  %v2 = phi i16 [ %v8, %B4 ], [ 0, %B1 ]
  br label %B3
B3:
  br i1 true, label %B4, label %B3
B4:
  %v3 = zext i16 %v1 to i64
  %v4 = add i64 %v3, 1
  %v5 = select i1 true, i64 %v4, i64 %v3
  %v6 = trunc i64 %v5 to i16
  %v7 = icmp eq i16 %v1, -27
  %v8 = add i16 %v2, 1
  %v9 = icmp ne i16 %v8, 2
  br i1 %v9, label %B2, label %B5
B5:
  br label %B6
B6:
  ret void
B7:
  br label %B8
B8:
  %v10 = phi i16 [ %v23, %B10 ], [ 0, %B7 ]
  %v11 = phi i16 [ %v24, %B10 ], [ 0, %B7 ]
  %v12 = zext i16 %v10 to i64
  %v13 = add nuw nsw i64 %v12, 1
  %v14 = trunc i64 %v13 to i16
  %v15 = zext i16 %v14 to i64
  %v16 = add nuw nsw i64 %v15, 1
  %v17 = trunc i64 %v16 to i16
  %v18 = zext i16 %v17 to i64
  %v19 = add nuw nsw i64 %v18, 1
  %v20 = trunc i64 %v19 to i16
  %v21 = zext i16 %v20 to i64
  %v22 = add nuw nsw i64 %v21, 1
  %v23 = trunc i64 %v22 to i16
  %v24 = add nuw i16 %v11, 4
  br label %B9
B9:
  br i1 true, label %B10, label %B9
B10:
  %v25 = icmp eq i16 %v24, -28
  br i1 %v25, label %B11, label %B8
B11:
  %v26 = phi i16 [ %v23, %B10 ]
  br i1 true, label %B1, label %B6
