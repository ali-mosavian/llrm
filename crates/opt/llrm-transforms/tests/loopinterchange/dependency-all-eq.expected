== -loop-interchange-profitabilities=instorder
@all_eq
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v5, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v3, %B2 ], [ 0, %B1 ]
  %v2 = getelementptr i8, ptr %A, i64 %v1
  store i8 0, ptr %v2
  %v3 = add i64 %v1, 1
  %v4 = icmp eq i64 %v3, 100
  br i1 %v4, label %B3, label %B2
B3:
  %v5 = add i64 %v0, 1
  %v6 = icmp eq i64 %v5, 100
  br i1 %v6, label %B4, label %B1
B4:
  ret void
@eq_all
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v5, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v3, %B2 ], [ 0, %B1 ]
  %v2 = getelementptr i8, ptr %A, i64 %v0
  store i8 0, ptr %v2
  %v3 = add i64 %v1, 1
  %v4 = icmp eq i64 %v3, 100
  br i1 %v4, label %B3, label %B2
B3:
  %v5 = add i64 %v0, 1
  %v6 = icmp eq i64 %v5, 100
  br i1 %v6, label %B4, label %B1
B4:
  ret void
