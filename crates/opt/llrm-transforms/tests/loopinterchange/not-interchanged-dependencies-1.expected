== 
@interchange_04
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v1, %B3 ], [ 0, %B0 ]
  %v1 = add nuw nsw i64 %v0, 1
  br label %B2
B2:
  %v2 = phi i64 [ %v6, %B2 ], [ 0, %B1 ]
  %v3 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i64 0, i64 %v1, i64 %v2
  %v4 = load i32, ptr %v3
  %v5 = add nsw i32 %v4, %k
  %v6 = add nuw nsw i64 %v2, 1
  %v7 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i64 0, i64 %v0, i64 %v6
  store i32 %v5, ptr %v7
  %v8 = icmp eq i64 %v6, 99
  br i1 %v8, label %B3, label %B2
B3:
  %v9 = icmp eq i64 %v1, 99
  br i1 %v9, label %B4, label %B1
B4:
  ret void
