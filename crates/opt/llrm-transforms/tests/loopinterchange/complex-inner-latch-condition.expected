== -loop-interchange-profitabilities=ignore
@complex_inner_latch_cond
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v9, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v5, %B2 ], [ 0, %B1 ]
  %v2 = getelementptr [5 x i8], ptr %A, i64 %v1, i64 %v0
  %v3 = load i8, ptr %v2
  %v4 = add i8 %v3, 1
  store i8 %v4, ptr %v2
  %v5 = add i64 %v1, 1
  %v6 = icmp slt i64 %v5, %v0
  %v7 = icmp slt i64 %v5, 100
  %v8 = and i1 %v6, %v7
  br i1 %v8, label %B2, label %B3
B3:
  %v9 = add i64 %v0, 1
  %v10 = icmp eq i64 %v9, 5
  br i1 %v10, label %B4, label %B1
B4:
  ret void
