== 
@f
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v7, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v5, %B2 ], [ 0, %B1 ]
  %v2 = and i64 %v0, %val
  %v3 = and i64 %v1, %val
  %v4 = getelementptr inbounds [4 x i8], ptr %A, i64 %v2, i64 %v3
  store i8 0, ptr %v4
  %v5 = add nuw nsw i64 %v1, 1
  %v6 = icmp eq i64 %v5, 4
  br i1 %v6, label %B3, label %B2
B3:
  %v7 = add nuw nsw i64 %v0, 1
  %v8 = icmp eq i64 %v7, 4
  br i1 %v8, label %B4, label %B1
B4:
  ret void
