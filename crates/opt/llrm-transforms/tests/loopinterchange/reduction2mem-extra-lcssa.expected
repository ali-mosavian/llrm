== -loop-interchange-reduction-to-mem
@reduction_lcssa_with_non_phi_user
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v12, %B4 ], [ 0, %B0 ]
  %v1 = getelementptr inbounds i32, ptr @sum, i64 %v0
  br label %B2
B2:
  %v2 = phi i64 [ %v7, %B2 ], [ 0, %B1 ]
  %v3 = phi i32 [ %v6, %B2 ], [ 0, %B1 ]
  %v4 = getelementptr inbounds [100 x i32], ptr @A, i64 %v2, i64 %v0
  %v5 = load i32, ptr %v4
  %v6 = add i32 %v3, %v5
  %v7 = add nuw nsw i64 %v2, 1
  %v8 = icmp eq i64 %v2, 99
  br i1 %v8, label %B3, label %B2
B3:
  %v9 = phi i32 [ %v6, %B2 ]
  %v10 = phi i64 [ %v2, %B2 ]
  store i32 %v9, ptr %v1
  %v11 = add i64 %v10, 1
  br label %B4
B4:
  %v12 = add nuw nsw i64 %v0, 1
  %v13 = icmp eq i64 %v0, 99
  br i1 %v13, label %B5, label %B1
B5:
  ret void
