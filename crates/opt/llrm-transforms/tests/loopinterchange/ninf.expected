== -loop-interchange-profitabilities=ignore
@reduction_reassoc_ninf
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v12, %B7 ], [ 0, %B1 ]
  %v1 = phi float [ %v11, %B7 ], [ fp(0000000000000000), %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v2 = phi i64 [ %v9, %B6 ], [ 0, %B3 ]
  %v3 = phi float [ %v1, %B3 ], [ %v6, %B6 ]
  br label %B5
B5:
  %v4 = getelementptr [2 x float], ptr %A, i64 %v2, i64 %v0
  %v5 = load float, ptr %v4
  %v6 = fadd reassoc float %v3, %v5
  %v7 = add i64 %v0, 1
  %v8 = icmp eq i64 %v7, 2
  br label %B6
B6:
  %v9 = add i64 %v2, 1
  %v10 = icmp eq i64 %v9, 2
  br i1 %v10, label %B7, label %B4
B7:
  %v11 = phi float [ %v6, %B6 ]
  %v12 = add i64 %v0, 1
  %v13 = icmp eq i64 %v12, 2
  br i1 %v13, label %B8, label %B2
B8:
  %v14 = phi float [ %v11, %B7 ]
  ret float %v14
@non_reduction_ninf
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v12, %B7 ], [ 0, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v1 = phi i64 [ %v10, %B6 ], [ 0, %B3 ]
  br label %B5
B5:
  %v2 = getelementptr [2 x float], ptr %A, i64 %v1, i64 %v0
  %v3 = load float, ptr %v2
  %v4 = getelementptr [2 x float], ptr %B, i64 %v1, i64 %v0
  %v5 = load float, ptr %v4
  %v6 = fadd ninf float %v3, %v5
  %v7 = getelementptr [2 x float], ptr %C, i64 %v1, i64 %v0
  store float %v6, ptr %v7
  %v8 = add i64 %v0, 1
  %v9 = icmp eq i64 %v8, 2
  br label %B6
B6:
  %v10 = add i64 %v1, 1
  %v11 = icmp eq i64 %v10, 2
  br i1 %v11, label %B7, label %B4
B7:
  %v12 = add i64 %v0, 1
  %v13 = icmp eq i64 %v12, 2
  br i1 %v13, label %B8, label %B2
B8:
  ret void
