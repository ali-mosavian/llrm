  %v20 = getelementptr inbounds nuw [256 x float], ptr @A, i64 %v0, i64 %v1
  store float %v19, ptr %v20
  %v21 = add nuw nsw i64 %v0, 1
  %v22 = icmp eq i64 %v21, 256
  br label %B6
