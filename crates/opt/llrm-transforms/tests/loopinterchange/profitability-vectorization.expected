== -loop-interchange-profitabilities=instorder
@f
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v23, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v21, %B2 ], [ 1, %B1 ]
  %v2 = add nsw i64 %v1, -1
  %v3 = getelementptr inbounds nuw [256 x [256 x float]], ptr @A, i64 0, i64 %v2, i64 %v0
  %v4 = getelementptr inbounds nuw [256 x [256 x float]], ptr @B, i64 0, i64 %v1, i64 %v0
  %v5 = getelementptr inbounds nuw [256 x [256 x float]], ptr @C, i64 0, i64 %v0, i64 %v1
  %v6 = getelementptr inbounds nuw [256 x [256 x float]], ptr @D, i64 0, i64 %v0, i64 %v1
  %v7 = getelementptr inbounds nuw [256 x [256 x float]], ptr @E, i64 0, i64 %v0, i64 %v1
  %v8 = getelementptr inbounds nuw [256 x [256 x float]], ptr @F, i64 0, i64 %v0, i64 %v1
  %v9 = load float, ptr %v3
  %v10 = load float, ptr %v4
  %v11 = load float, ptr %v5
  %v12 = load float, ptr %v6
  %v13 = load float, ptr %v7
  %v14 = load float, ptr %v8
  %v15 = fadd float %v9, %v10
  %v16 = fadd float %v15, %v11
  %v17 = fadd float %v16, %v12
  %v18 = fadd float %v17, %v13
  %v19 = fadd float %v18, %v14
  %v20 = getelementptr inbounds nuw [256 x float], ptr @A, i64 %v1, i64 %v0
  store float %v19, ptr %v20
  %v21 = add nuw nsw i64 %v1, 1
  %v22 = icmp eq i64 %v21, 256
  br i1 %v22, label %B3, label %B2
B3:
  %v23 = add nuw nsw i64 %v0, 1
  %v24 = icmp eq i64 %v23, 256
  br i1 %v24, label %B4, label %B1
B4:
  ret void
== -loop-interchange-profitabilities=vectorize,cache,instorder
