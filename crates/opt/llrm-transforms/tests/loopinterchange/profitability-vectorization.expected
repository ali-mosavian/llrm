  %v2 = add nsw i64 %v0, -1
  %v3 = getelementptr inbounds nuw [256 x [256 x float]], ptr @A, i64 0, i64 %v2, i64 %v1
  %v4 = getelementptr inbounds nuw [256 x [256 x float]], ptr @B, i64 0, i64 %v0, i64 %v1
