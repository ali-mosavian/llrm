== 
@interchange_01
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v7, %B4 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v5, %B2 ], [ 1, %B1 ]
  call void @foo(i64 %v0)
  %v2 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i64 0, i64 %v1, i64 %v0
  %v3 = load i32, ptr %v2
  %v4 = add nsw i32 %v3, %k
  store i32 %v4, ptr %v2
  %v5 = add nuw nsw i64 %v1, 1
  %v6 = icmp eq i64 %v1, 99
  br i1 %v6, label %B3, label %B2
B3:
  br label %B4
B4:
  %v7 = add nuw nsw i64 %v0, 1
  %v8 = icmp eq i64 %v0, 99
  br i1 %v8, label %B5, label %B1
B5:
  br label %B6
B6:
  ret void
