== -loop-interchange-profitabilities=ignore
@test_padding_nontrivial_direction
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v20, %B9 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v14, %B5 ], [ 0, %B1 ]
  %v2 = getelementptr i32, ptr %S, i64 %v1
  br label %B3
B3:
  %v3 = phi i64 [ %v7, %B4 ], [ 0, %B2 ]
  %v4 = phi i32 [ %v6, %B4 ], [ 0, %B2 ]
  %v5 = trunc i64 %v3 to i32
  %v6 = add nsw i32 %v4, %v5
  br label %B4
B4:
  %v7 = add nuw nsw i64 %v3, 1
  %v8 = icmp eq i64 %v7, 32
  br i1 %v8, label %B5, label %B3
B5:
  %v9 = phi i32 [ %v6, %B4 ]
  %v10 = add i64 %v1, -1
  %v11 = getelementptr i32, ptr %S, i64 %v10
  %v12 = load i32, ptr %v11
  %v13 = add nsw i32 %v9, %v12
  store i32 %v13, ptr %v2
  %v14 = add nuw nsw i64 %v1, 1
  %v15 = icmp eq i64 %v14, 32
  br i1 %v15, label %B6, label %B2
B6:
  br label %B7
B7:
  %v16 = phi i64 [ %v18, %B8 ], [ 0, %B6 ]
  %v17 = getelementptr i8, ptr %D, i64 %v16
  store i8 0, ptr %v17
  br label %B8
B8:
  %v18 = add nuw nsw i64 %v16, 1
  %v19 = icmp eq i64 %v18, 32
  br i1 %v19, label %B9, label %B7
B9:
  %v20 = add nuw nsw i64 %v0, 1
  %v21 = icmp eq i64 %v20, 32
  br i1 %v21, label %B10, label %B1
B10:
  ret void
