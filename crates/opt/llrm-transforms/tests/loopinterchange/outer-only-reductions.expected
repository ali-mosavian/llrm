== 
@reduction_01
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v10, %B3 ], [ 1, %B0 ]
  %v1 = phi i32 [ %v9, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v2 = phi i64 [ %v3, %B2 ], [ 1, %B1 ]
  %v3 = add nuw nsw i64 %v2, 1
  %v4 = trunc i64 %v3 to i32
  %v5 = icmp eq i32 %v4, %N
  br i1 %v5, label %B3, label %B2
B3:
  %v6 = phi i64 [ %v2, %B2 ]
  %v7 = getelementptr inbounds [500 x [500 x i32]], ptr @A, i64 0, i64 %v6, i64 %v0
  %v8 = load i32, ptr %v7
  %v9 = add nsw i32 %v1, %v8
  %v10 = add nuw nsw i64 %v0, 1
  %v11 = trunc i64 %v10 to i32
  %v12 = icmp eq i32 %v11, %N
  br i1 %v12, label %B4, label %B1
B4:
  %v13 = phi i32 [ %v9, %B3 ]
  ret i32 %v13
