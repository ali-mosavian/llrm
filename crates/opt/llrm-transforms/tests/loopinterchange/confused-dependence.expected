== 
@may_alias
B0:
  br label %B1
B1:
  %v0 = phi i32 [ %v7, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i32 [ %v5, %B2 ], [ 0, %B1 ]
  %v2 = getelementptr inbounds [4 x [4 x float]], ptr %p0, i32 0, i32 %v1, i32 %v0
  %v3 = getelementptr inbounds [4 x [4 x float]], ptr %p1, i32 0, i32 %v0, i32 %v1
  %v4 = load float, ptr %v2
  store float %v4, ptr %v3
  %v5 = add nuw nsw i32 %v1, 1
  %v6 = icmp slt i32 %v5, 4
  br i1 %v6, label %B2, label %B3
B3:
  %v7 = add nuw nsw i32 %v0, 1
  %v8 = icmp slt i32 %v7, 4
  br i1 %v8, label %B1, label %B4
B4:
  ret void
