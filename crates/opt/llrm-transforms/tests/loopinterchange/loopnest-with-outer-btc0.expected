== 
@interchange_i_and_j
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v12, %B9 ], [ 0, %B0 ]
  br label %B2
B2:
  br label %B3
B3:
  %v1 = phi i64 [ %v10, %B8 ], [ 0, %B2 ]
  br label %B4
B4:
  br label %B5
B5:
  %v2 = phi i64 [ %v8, %B7 ], [ 0, %B4 ]
  br label %B6
B6:
  %v3 = getelementptr inbounds [100 x [100 x i32]], ptr @D, i64 %v0, i64 %v1, i64 %v2
  %v4 = load i32, ptr %v3
  %v5 = add nsw i32 %v4, %t
  store i32 %v5, ptr %v3
  %v6 = add nuw nsw i64 %v1, 1
  %v7 = icmp eq i64 %v6, 100
  br label %B7
B7:
  %v8 = add nuw nsw i64 %v2, 1
  %v9 = icmp eq i64 %v8, 100
  br i1 %v9, label %B8, label %B5
B8:
  %v10 = add nuw nsw i64 %v1, 1
  %v11 = icmp eq i64 %v10, 100
  br i1 %v11, label %B9, label %B3
B9:
  %v12 = add nuw nsw i64 %v0, 1
  %v13 = icmp eq i64 %v12, 1
  br i1 %v13, label %B10, label %B1
B10:
  ret void
