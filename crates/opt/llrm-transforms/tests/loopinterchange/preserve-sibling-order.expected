== -loop-interchange-profitabilities=ignore
@f
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v16, %B13 ], [ 0, %B0 ]
  br label %B2
B2:
  br label %B3
B3:
  %v1 = phi i64 [ %v8, %B8 ], [ 0, %B2 ]
  br label %B4
B4:
  br label %B5
B5:
  %v2 = phi i64 [ %v6, %B7 ], [ 0, %B4 ]
  br label %B6
B6:
  %v3 = getelementptr [64 x i8], ptr %A, i64 %v1, i64 %v2
  store i8 0, ptr %v3
  %v4 = add i64 %v1, 1
  %v5 = icmp eq i64 %v4, 64
  br label %B7
B7:
  %v6 = add i64 %v2, 1
  %v7 = icmp eq i64 %v6, 64
  br i1 %v7, label %B8, label %B5
B8:
  %v8 = add i64 %v1, 1
  %v9 = icmp eq i64 %v8, 64
  br i1 %v9, label %B9, label %B3
B9:
  br label %B10
B10:
  %v10 = phi i64 [ %v11, %B10 ], [ 0, %B9 ]
  %v11 = add i64 %v10, 1
  %v12 = icmp eq i64 %v11, 4
  br i1 %v12, label %B11, label %B10
B11:
  br label %B12
B12:
  %v13 = phi i64 [ %v14, %B12 ], [ 0, %B11 ]
  %v14 = add i64 %v13, 1
  %v15 = icmp eq i64 %v14, 4
  br i1 %v15, label %B13, label %B12
B13:
  %v16 = add i64 %v0, 1
  %v17 = icmp eq i64 %v16, 64
  br i1 %v17, label %B14, label %B1
B14:
  ret void
