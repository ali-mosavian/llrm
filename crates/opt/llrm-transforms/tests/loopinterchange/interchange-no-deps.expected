== 
@no_deps_interchange
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v7, %B7 ], [ 0, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v1 = phi i64 [ %v5, %B6 ], [ 0, %B3 ]
  br label %B5
B5:
  %v2 = getelementptr inbounds [1024 x i32], ptr %Arr, i64 %v0, i64 %v1
  store i32 0, ptr %v2
  %v3 = add nuw nsw i64 %v0, 1
  %v4 = icmp ne i64 %v3, 1024
  br label %B6
B6:
  %v5 = add nuw nsw i64 %v1, 1
  %v6 = icmp ne i64 %v5, 1024
  br i1 %v6, label %B4, label %B7
B7:
  %v7 = add nuw nsw i64 %v0, 1
  %v8 = icmp ne i64 %v7, 1024
  br i1 %v8, label %B2, label %B8
B8:
  ret i32 0
@no_mem_instrs
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v4, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v2, %B2 ], [ 0, %B1 ]
  store i64 %v1, ptr %ptr
  %v2 = add nuw nsw i64 %v1, 1
  %v3 = icmp ne i64 %v2, 1024
  br i1 %v3, label %B2, label %B3
B3:
  %v4 = add nuw nsw i64 %v0, 1
  %v5 = icmp ne i64 %v4, 1024
  br i1 %v5, label %B1, label %B4
B4:
  ret i32 0
