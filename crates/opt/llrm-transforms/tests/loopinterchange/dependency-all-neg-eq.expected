== -loop-interchange-profitabilities=ignore
@all_neg_eq
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v11, %B5 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v2, %B4 ], [ 0, %B1 ]
  %v2 = add i64 %v1, 1
  br label %B3
B3:
  %v3 = phi i64 [ %v8, %B3 ], [ 0, %B2 ]
  %v4 = getelementptr [256 x i8], ptr %A, i64 %v1, i64 %v3
  %v5 = load i8, ptr %v4
  %v6 = add i8 %v5, 1
  %v7 = getelementptr [256 x i8], ptr %A, i64 %v2, i64 %v3
  store i8 %v6, ptr %v7
  %v8 = add i64 %v3, 1
  %v9 = icmp eq i64 %v8, 256
  br i1 %v9, label %B4, label %B3
B4:
  %v10 = icmp eq i64 %v2, 255
  br i1 %v10, label %B5, label %B2
B5:
  %v11 = add i64 %v0, 1
  %v12 = icmp eq i64 %v11, 100
  br i1 %v12, label %B6, label %B1
B6:
  ret void
