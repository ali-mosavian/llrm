@test3
B0:
  %v0 = load i32, ptr @a
  br label %B1
B1:
  br label %B2
B2:
  %v1 = phi i64 [ %v18, %B7 ], [ 5, %B1 ]
  %v2 = phi i32 [ %v0, %B1 ], [ %v17, %B7 ]
  br label %B3
B3:
  br label %B4
B4:
  %v3 = phi i64 [ %v13, %B6 ], [ 0, %B3 ]
  %v4 = phi i64 [ %v14, %B6 ], [ 1, %B3 ]
  %v5 = phi i32 [ %v10, %B6 ], [ %v2, %B3 ]
