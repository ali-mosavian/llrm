== 
@reduction_smax_store
B0:
  br label %B1
B1:
  %v0 = phi i32 [ %v10, %B3 ], [ 0, %B0 ]
  %v1 = phi i32 [ %v9, %B3 ], [ 0, %B0 ]
  br label %B2
B2:
  %v2 = phi i32 [ %v7, %B2 ], [ 0, %B1 ]
  %v3 = phi i32 [ %v1, %B1 ], [ %v6, %B2 ]
  %v4 = getelementptr inbounds [2 x [2 x i32]], ptr %A, i32 0, i32 %v2, i32 %v0
  %v5 = load i32, ptr %v4
  %v6 = tail call i32 @llvm.smax.i32(i32 %v3, i32 %v5)
  store i32 %v6, ptr %v4
  %v7 = add i32 %v2, 1
  %v8 = icmp slt i32 %v7, 2
  br i1 %v8, label %B2, label %B3
B3:
  %v9 = phi i32 [ %v6, %B2 ]
  %v10 = add i32 %v0, 1
  %v11 = icmp slt i32 %v10, 2
  br i1 %v11, label %B1, label %B4
B4:
  ret void
