== -loop-interchange-profitabilities=ignore
@f
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v6, %B8 ], [ 0, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v1 = phi i64 [ %v4, %B7 ], [ 0, %B3 ]
  br label %B5
B5:
  %v2 = add i64 %v0, 1
  %v3 = icmp eq i64 %v2, 10
  br label %B6
B6:
  br label %B7
B7:
  %v4 = add i64 %v1, 1
  %v5 = icmp eq i64 %v4, 10
  br i1 %v5, label %B8, label %B4
B8:
  %v6 = add i64 %v0, 1
  %v7 = icmp eq i64 %v6, 10
  br i1 %v7, label %B9, label %B2
B9:
  ret void
