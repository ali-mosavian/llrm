== -loop-interchange-threshold=0
@test
B0:
  br label %B1
B1:
  %v0 = phi i32 [ %v15, %B5 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i32 [ %v13, %B4 ], [ 0, %B1 ]
  %v2 = getelementptr inbounds [90 x i32], ptr %C, i32 %v0, i32 %v1
  %v3 = load i32, ptr %v2
  br label %B3
B3:
  %v4 = phi i32 [ %v3, %B2 ], [ %v9, %B3 ]
  %v5 = phi i32 [ %v10, %B3 ], [ 1, %B2 ]
  %v6 = getelementptr inbounds [90 x i16], ptr %A, i32 %v0, i32 %v5
  %v7 = load i16, ptr %v6
  %v8 = sext i16 %v7 to i32
  %v9 = add nsw i32 %v8, %v4
  %v10 = add nuw nsw i32 %v5, 1
  %v11 = icmp eq i32 %v10, 90
  br i1 %v11, label %B4, label %B3
B4:
  %v12 = phi i32 [ %v4, %B3 ]
  store i32 %v12, ptr %v2
  %v13 = add nuw nsw i32 %v1, 1
  %v14 = icmp eq i32 %v13, 90
  br i1 %v14, label %B5, label %B2
B5:
  %v15 = add nuw nsw i32 %v0, 1
  %v16 = icmp eq i32 %v15, 90
  br i1 %v16, label %B6, label %B1
B6:
  br label %B7
B7:
  ret void
