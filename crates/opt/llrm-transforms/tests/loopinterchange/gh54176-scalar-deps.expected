== 
@test1
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v7, %B5 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v5, %B4 ], [ 0, %B1 ]
  %v2 = getelementptr inbounds [4 x [9 x i32]], ptr @f, i64 0, i64 %v1, i64 %v0
  %v3 = load i32, ptr %v2
  %v4 = icmp eq i32 %v3, 0
  br i1 %v4, label %B3, label %B8
B3:
  br i1 %cond, label %B4, label %B7
B4:
  %v5 = add nuw nsw i64 %v1, 1
  %v6 = icmp eq i64 %v5, 3
  br i1 %v6, label %B5, label %B2
B5:
  %v7 = add nsw i64 %v0, 1
  %v8 = icmp slt i64 %v0, 2
  br i1 %v8, label %B1, label %B6
B6:
  %v9 = load i32, ptr @g
  ret i32 %v9
B7:
  %v10 = load i32, ptr @g
  %v11 = add i32 %v10, 1
  store i32 %v11, ptr @g
  br label %B4
B8:
  store i32 3, ptr @g
  br label %B3
@test2
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v7, %B5 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v5, %B4 ], [ 0, %B1 ]
  %v2 = getelementptr inbounds [4 x [9 x i32]], ptr @f, i64 0, i64 %v1, i64 %v0
  %v3 = load i32, ptr %v2
  %v4 = icmp eq i32 %v3, 0
  store i32 3, ptr @g
  br i1 %v4, label %B3, label %B8
B3:
  br i1 %cond, label %B4, label %B7
B4:
  %v5 = add nuw nsw i64 %v1, 1
  %v6 = icmp eq i64 %v5, 3
  br i1 %v6, label %B5, label %B2
B5:
  %v7 = add nsw i64 %v0, 1
  %v8 = icmp slt i64 %v0, 2
  br i1 %v8, label %B1, label %B6
B6:
  %v9 = load i32, ptr @g
  ret i32 %v9
B7:
  %v10 = load i32, ptr @g
  %v11 = add i32 %v10, 1
  store i32 %v11, ptr @g
  br label %B4
B8:
  br label %B3
