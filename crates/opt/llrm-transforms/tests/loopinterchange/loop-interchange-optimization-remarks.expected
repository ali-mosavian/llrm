== 
@test01
B0:
  %v0 = icmp sgt i32 %N, 1
  br i1 %v0, label %B1, label %B6
B1:
  %v1 = add i32 %N, -1
  br label %B2
B2:
  %v2 = phi i64 [ %v14, %B4 ], [ 1, %B1 ]
  %v3 = add nsw i64 %v2, -1
  br label %B3
B3:
  %v4 = phi i64 [ %v11, %B3 ], [ 1, %B2 ]
  %v5 = add nsw i64 %v4, -1
  %v6 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i64 0, i64 %v3, i64 %v5
  %v7 = load i32, ptr %v6
  %v8 = getelementptr inbounds [100 x [100 x i32]], ptr @B, i64 0, i64 %v2, i64 %v4
  %v9 = load i32, ptr %v8
  %v10 = add nsw i32 %v9, %v7
  store i32 %v10, ptr %v6
  %v11 = add nuw nsw i64 %v4, 1
  %v12 = trunc i64 %v4 to i32
  %v13 = icmp eq i32 %v12, %v1
  br i1 %v13, label %B4, label %B3
B4:
  %v14 = add nuw nsw i64 %v2, 1
  %v15 = trunc i64 %v2 to i32
  %v16 = icmp eq i32 %v15, %v1
  br i1 %v16, label %B5, label %B2
B5:
  br label %B6
B6:
  ret void
@test02
B0:
  %v0 = add nsw i32 %N, -1
  %v1 = icmp sgt i32 %N, 1
  br i1 %v1, label %B1, label %B8
B1:
  %v2 = icmp sgt i32 %v0, 1
  %v3 = add i32 %N, -2
  %v4 = sext i32 %v0 to i64
  br label %B2
B2:
  %v5 = phi i64 [ %v6, %B6 ], [ 0, %B1 ]
  %v6 = add nuw nsw i64 %v5, 1
  br i1 %v2, label %B3, label %B6
B3:
  br label %B4
B4:
  %v7 = phi i64 [ %v8, %B4 ], [ 1, %B3 ]
  %v8 = add nuw nsw i64 %v7, 1
  %v9 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i64 0, i64 %v8, i64 %v6
  %v10 = load i32, ptr %v9
  %v11 = add nsw i32 %v10, %k
  store i32 %v11, ptr %v9
  %v12 = trunc i64 %v7 to i32
  %v13 = icmp eq i32 %v12, %v3
  br i1 %v13, label %B5, label %B4
B5:
  br label %B6
B6:
  %v14 = icmp slt i64 %v6, %v4
  br i1 %v14, label %B2, label %B7
B7:
  br label %B8
B8:
  ret void
@test03
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v10, %B7 ], [ 0, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v1 = phi i64 [ %v2, %B6 ], [ 0, %B3 ]
  %v2 = add nuw nsw i64 %v1, 1
  br label %B5
B5:
  %v3 = getelementptr inbounds [3 x [3 x i32]], ptr @A10, i64 0, i64 %v0, i64 %v1
  %v4 = trunc i64 %v1 to i32
  store i32 %v4, ptr %v3
  %v5 = getelementptr inbounds [3 x [3 x i32]], ptr @A10, i64 0, i64 %v0, i64 %v2
  %v6 = trunc i64 %v0 to i32
  store i32 %v6, ptr %v5
  %v7 = add nuw nsw i64 %v0, 1
  %v8 = icmp ne i64 %v7, 3
  br label %B6
B6:
  %v9 = icmp ne i64 %v2, 2
  br i1 %v9, label %B4, label %B7
B7:
  %v10 = add nuw nsw i64 %v0, 1
  %v11 = icmp ne i64 %v10, 3
  br i1 %v11, label %B2, label %B8
B8:
  ret void
@test04
