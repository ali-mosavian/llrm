  %v4 = add nsw i64 %v3, %v2
  %v5 = getelementptr inbounds [100 x i32], ptr @C, i64 0, i64 %v3
  %v6 = trunc i64 %v4 to i32
  store i32 %v6, ptr %v5
  br label %B3
B3:
  %v7 = phi i64 [ %v11, %B3 ], [ 0, %B2 ]
  %v8 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i64 0, i64 %v3, i64 %v7
  %v9 = load i32, ptr %v8
  %v10 = add nsw i32 %v6, %v9
  store i32 %v10, ptr %v8
  %v11 = add nuw nsw i64 %v7, 1
  %v12 = trunc i64 %v7 to i32
  %v13 = icmp eq i32 %v12, %v1
  br i1 %v13, label %B4, label %B3
B4:
  %v14 = add nuw nsw i64 %v3, 1
  %v15 = trunc i64 %v3 to i32
  %v16 = icmp eq i32 %v15, %v1
  br i1 %v16, label %B5, label %B2
B5:
  br label %B6
B6:
  ret void
