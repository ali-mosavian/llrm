== 
@f
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v2, %B2 ], [ 0, %B0 ]
  br i1 %cond, label %B2, label %B4
B2:
  %v1 = phi i64 [ %v0, %B1 ], [ %v7, %B6 ]
  %v2 = add i64 %v0, 1
  %v3 = icmp eq i64 %v2, 10
  br i1 %v3, label %B3, label %B1
B3:
  ret void
B4:
  br label %B5
B5:
  %v4 = phi i64 [ %v5, %B5 ], [ 0, %B4 ]
  %v5 = add i64 %v4, 1
  %v6 = icmp eq i64 %v5, 10
  br i1 %v6, label %B6, label %B5
B6:
  %v7 = phi i64 [ %v4, %B5 ]
  br label %B2
