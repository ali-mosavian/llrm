== -loop-interchange-profitabilities=ignore
@f
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v6, %B4 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v4, %B3 ], [ 0, %B1 ]
  %v2 = add i64 %v1, 1
  %v3 = getelementptr [256 x i8], ptr %A, i64 %v1, i64 %v0
  store i8 0, ptr %v3
  br label %B3
B3:
  %v4 = phi i64 [ %v2, %B2 ]
  %v5 = icmp eq i64 %v2, 256
  br i1 %v5, label %B4, label %B2
B4:
  %v6 = add i64 %v0, 1
  %v7 = icmp eq i64 %v6, 256
  br i1 %v7, label %B5, label %B1
B5:
  ret void
