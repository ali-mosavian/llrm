== -loop-interchange-profitabilities=ignore
@f
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v8, %B7 ], [ 0, %B1 ]
  %v1 = phi i64 [ %v0, %B7 ], [ -1, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v2 = phi i64 [ %v6, %B6 ], [ 0, %B3 ]
  br label %B5
B5:
  %v3 = getelementptr [10 x i64], ptr %A, i64 %v2, i64 %v0
  store i64 %v1, ptr %v3
  %v4 = add i64 %v0, 1
  %v5 = icmp eq i64 %v4, 10
  br label %B6
B6:
  %v6 = add i64 %v2, 1
  %v7 = icmp eq i64 %v6, 10
  br i1 %v7, label %B7, label %B4
B7:
  %v8 = add i64 %v0, 1
  %v9 = icmp eq i64 %v8, 10
  br i1 %v9, label %B8, label %B2
B8:
  ret void
