  %v3 = getelementptr inbounds [100 x [100 x i32]], ptr @A, i32 0, i32 %v1, i32 %v2
  %v4 = load i32, ptr %v3
  %v5 = add nsw i32 %v4, %k
  store i32 %v5, ptr %v3
  %v6 = add nuw nsw i32 %v1, 1
  %v7 = icmp ne i32 %v0, %v1
