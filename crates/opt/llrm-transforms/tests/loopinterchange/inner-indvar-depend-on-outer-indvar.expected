== -da-enable-dependence-test=all
@interchange_04
B0:
  %v0 = load i32, ptr @N
  br label %B1
B1:
  br label %B2
B2:
  %v1 = phi i32 [ %v10, %B7 ], [ 0, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v2 = phi i32 [ %v8, %B6 ], [ 0, %B3 ]
  br label %B5
