== 
@test1
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v7, %B3 ], [ undef, %B0 ]
  %v1 = getelementptr inbounds double, ptr undef, i64 %v0
  br label %B2
B2:
  %v2 = phi i64 [ %v4, %B2 ], [ 0, %B1 ]
  %v3 = load double, ptr %v1
  store double undef, ptr %v1
  %v4 = add nuw nsw i64 %v2, 1
  br i1 %arg, label %B2, label %B3
B3:
  %v5 = phi i64 [ %v4, %B2 ]
  %v6 = trunc i64 %v5 to i32
  %v7 = add nsw i64 %v0, 1
  br i1 %arg, label %B1, label %B4
B4:
  ret void
@test2
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v7, %B4 ], [ undef, %B0 ]
  %v1 = getelementptr inbounds double, ptr undef, i64 %v0
  br label %B2
