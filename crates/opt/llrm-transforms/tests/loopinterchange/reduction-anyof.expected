== -loop-interchange-profitabilities=ignore
@reduce_anyof
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v13, %B3 ], [ 0, %B0 ]
  %v1 = phi i8 [ %v12, %B3 ], [ 0, %B0 ]
  %v2 = add i64 %v0, 1
  %v3 = trunc i64 %v2 to i8
  br label %B2
B2:
  %v4 = phi i64 [ %v10, %B2 ], [ 0, %B1 ]
  %v5 = phi i8 [ %v1, %B1 ], [ %v9, %B2 ]
  %v6 = getelementptr inbounds [2 x i8], ptr %A, i64 %v4, i64 %v0
  %v7 = load i8, ptr %v6
  %v8 = icmp eq i8 %v7, 0
  %v9 = select i1 %v8, i8 %v3, i8 %v5
  %v10 = add i64 %v4, 1
  %v11 = icmp eq i64 %v10, 2
  br i1 %v11, label %B3, label %B2
B3:
  %v12 = phi i8 [ %v9, %B2 ]
  %v13 = add i64 %v0, 1
  %v14 = icmp eq i64 %v13, 2
  br i1 %v14, label %B4, label %B1
B4:
  %v15 = phi i8 [ %v12, %B3 ]
  ret i8 %v15
