== -loop-interchange-profitabilities=ignore -loop-interchange-threshold=-100
@test_lcssa_indvars1
B0:
  br label %B1
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v8, %B7 ], [ 5, %B1 ]
  br label %B3
B3:
  br label %B4
B4:
  %v1 = phi i64 [ %v5, %B6 ], [ 0, %B3 ]
  br label %B5
B5:
  %v2 = getelementptr inbounds [10 x [10 x i32]], ptr @c, i64 0, i64 %v0, i64 %v1
  store i32 0, ptr %v2
  %v3 = add nsw i64 %v0, -1
  %v4 = icmp eq i64 %v0, 0
  br label %B6
B6:
  %v5 = add nuw nsw i64 %v1, 1
  %v6 = icmp ult i64 %v1, 2
  br i1 %v6, label %B4, label %B7
B7:
  %v7 = phi i64 [ %v5, %B6 ]
  %v8 = add nsw i64 %v0, -1
  %v9 = icmp eq i64 %v0, 0
  br i1 %v9, label %B8, label %B2
B8:
  %v10 = phi i64 [ %v7, %B7 ]
  %v11 = phi i64 [ %v8, %B7 ]
  store i64 %v11, ptr @b
  store i64 %v10, ptr @a
  ret void
