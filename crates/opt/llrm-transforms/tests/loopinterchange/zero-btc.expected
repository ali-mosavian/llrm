== -loop-interchange-profitabilities=ignore
@test
B0:
  br label %B1
B1:
  %v0 = phi i8 [ %v5, %B5 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v4, %B4 ], [ 0, %B1 ]
  %v2 = phi i8 [ %v0, %B1 ], [ %v3, %B4 ]
  br label %B3
B3:
  br i1 true, label %B4, label %B3
B4:
  %v3 = or i8 %v2, 0
  %v4 = add i64 %v1, 1
  br i1 true, label %B5, label %B2
B5:
  %v5 = phi i8 [ %v3, %B4 ]
  br i1 true, label %B6, label %B1
B6:
  ret void
