  %v9 = getelementptr inbounds nuw [100 x double], ptr %v3, i64 %v5
  %v10 = load double, ptr %v9
  %v11 = fmul fast double %v10, %v8
  %v12 = fadd fast double %v11, %v6
  %v13 = add nuw nsw i64 %v5, 1
  %v14 = icmp eq i64 %v13, 100
  br i1 %v14, label %B3, label %B2
B3:
  %v15 = phi double [ %v12, %B2 ]
  store double %v15, ptr %v1
  %v16 = add nuw nsw i64 %v0, 1
  %v17 = icmp eq i64 %v16, 100
  br i1 %v17, label %B4, label %B1
B4:
  ret void
