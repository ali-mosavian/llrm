== 
@test1
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v6, %B5 ], [ 0, %B0 ]
  %v1 = getelementptr inbounds [5 x [5 x double]], ptr @wdtdr, i64 0, i64 0, i64 %v0
  br label %B2
B2:
  %v2 = phi i64 [ %v4, %B3 ], [ 0, %B1 ]
  %v3 = load double, ptr %v1
  store double undef, ptr %v1
  br label %B3
B3:
  %v4 = add nsw i64 %v2, 1
  br i1 false, label %B2, label %B4
B4:
  %v5 = add nsw i64 %v0, 1
  br label %B5
B5:
  %v6 = add nsw i64 %v0, 1
  br i1 false, label %B1, label %B6
B6:
  %v7 = phi i64 [ %v5, %B5 ]
  %v8 = phi i64 [ %v6, %B5 ]
  ret void
@test2
B0:
  br i1 %cond, label %B1, label %B8
B1:
  br label %B2
B2:
  %v0 = phi i64 [ %v6, %B6 ], [ 0, %B1 ]
  %v1 = getelementptr inbounds [5 x [5 x double]], ptr @wdtdr, i64 0, i64 0, i64 %v0
  br label %B3
B3:
  %v2 = phi i64 [ %v4, %B4 ], [ 0, %B2 ]
  %v3 = load double, ptr %v1
  store double undef, ptr %v1
  br label %B4
B4:
  %v4 = add nsw i64 %v2, 1
  br i1 false, label %B3, label %B5
B5:
  %v5 = add nsw i64 %v0, 1
  br label %B6
B6:
  %v6 = add nsw i64 %v0, 1
  br i1 false, label %B2, label %B7
B7:
  %v7 = phi i64 [ %v6, %B6 ]
  %v8 = phi i64 [ %v5, %B6 ]
  br label %B8
B8:
  %v9 = phi i64 [ %v8, %B7 ], [ 0, %B0 ]
  %v10 = phi i64 [ %v7, %B7 ], [ 0, %B0 ]
