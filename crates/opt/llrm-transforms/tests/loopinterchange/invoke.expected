== -loop-interchange-profitabilities=ignore
@invoke_may_rw
B0:
  br label %B1
B1:
  %v0 = phi i64 [ %v4, %B4 ], [ 0, %B0 ]
  br label %B2
B2:
  %v1 = phi i64 [ %v2, %B3 ], [ 0, %B1 ]
  invoke void @rd(ptr @g)
  to label %B3 unwind label %B6
B3:
  %v2 = add i64 %v1, 1
  %v3 = icmp eq i64 %v2, 8
  br i1 %v3, label %B4, label %B2
B4:
  %v4 = add i64 %v0, 1
  %v5 = icmp eq i64 %v4, 8
  br i1 %v5, label %B5, label %B1
B5:
  ret void
B6:
  %v6 = landingpad { ptr, i32 }
  cleanup
  br label %B3
