# Source this before `cargo test --release --workspace --tests` where the debug-information tests must run:
# a test whose tool is missing then fails instead of skipping (it prints "SKIPPED: why" either way).
# Needs on the host: gdb, as, ld (binutils), llvm-dwarfdump (llvm-20), an x86 Linux that runs i386
# programs, Turbo C++ 3.0 and Turbo Debugger 3.00 (not in the repository), and the DOSBox-X the build bootstraps.
export LLRM_REQUIRE_DWARF=1
export LLRM_REQUIRE_TURBO=1
export LLRM_REQUIRE_CODEVIEW=1
export LLRM_REQUIRE_NIBRUN=1
export VBDOS_DIR="${VBDOS_DIR:-$HOME/work/other/d32x/toolchains/vbdos}"
export TCPP30_DIR="${TCPP30_DIR:-$HOME/scratch/toolchains/tcpp30}"
export TD_DIR="${TD_DIR:-$HOME/scratch/toolchains/td}"
# DOSBox-X's debug socket is on a free private port the test picks itself: no port to reserve.
