DEFINT A-Z
DECLARE FUNCTION BenchZ& ()
DIM SHARED a(0 TO 9) AS INTEGER
DIM SHARED k AS INTEGER
DIM SHARED w(0 TO 199) AS LONG
PRINT LTRIM$(STR$(a(7)))
PRINT LTRIM$(STR$(w(1)))
a(3) = 5
k = 7
w(150) = 9
CLEAR
PRINT LTRIM$(STR$(a(3)))
PRINT LTRIM$(STR$(k))
PRINT LTRIM$(STR$(w(150)))
a(4) = 9
ERASE a
PRINT LTRIM$(STR$(a(4)))
PRINT LTRIM$(STR$(BenchZ&))
END

FUNCTION BenchZ&
    DIM i AS INTEGER, s AS LONG
    FOR i = 1 TO 100
        s = s + i
    NEXT i
    BenchZ& = s
END FUNCTION
