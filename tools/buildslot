#!/usr/bin/env bash
# buildslot CMD...: run CMD (a cargo build/check/test) holding one of 2 shared slots at nice 10; waits for a free slot.
# CARGO_BUILD_JOBS defaults to 8 (cargo's own default is every core: four slots of 32 rustc at 1-1.7 GB each ran the host out of memory and
# systemd-oomd killed whole sessions); set it to override. Installed to ~/.local/bin/buildslot from this file.
# Usage: buildslot cargo build --release   (the parity merge loop does NOT use it)
N=${BUILDSLOTS:-2}; D=${BUILDSLOT_DIR:-/tmp/buildslots}; mkdir -p $D
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-8}
# every test/bench binary cargo runs goes through testcap (a per-process memory cap); a caller's own runner wins
here=$(dirname "$(readlink -f "$0")")
triple=$(rustc -vV | sed -n 's/^host: //p' | tr 'a-z-' 'A-Z_')
runner=CARGO_TARGET_${triple}_RUNNER
[ -n "${!runner}" ] || export "$runner=$here/testcap"
while true; do
  for i in $(seq 1 $N); do
    exec {fd}>$D/slot$i
    if flock -n $fd; then exec nice -n 10 "$@"; fi
    exec {fd}>&-
  done
  sleep 5
done
