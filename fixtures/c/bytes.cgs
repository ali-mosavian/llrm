INIT sw=0x808000 target=0xec size=50 rev=0x23
SEG 1 attr=0x7 name="_TEXT" align=1
SEG 2 attr=0x1c name="CONST" align=2
SEG 3 attr=0xc name="CONST2" align=2
SEG 4 attr=0x6 name="_DATA" align=2
START
f1 DBSrcFile "bytes.c"
- DBSrcCue f1 1 1
SYM y1 name="bytes" base="bytes" pattern="_*" attr=0x7 seg=1
CALLCONV y1 class=0x80 target=0x716 parms=[] ret=0:0
- CGProcDecl y1 TY_UNSIGNED
SYM y2 name="a" base="a" pattern="_*" attr=0x0 seg=2
- CGParmDecl y2 TY_POINTER
SYM y3 name="b" base="b" pattern="_*" attr=0x0 seg=2
- CGParmDecl y3 TY_POINTER
SYM y4 name="n" base="n" pattern="_*" attr=0x0 seg=2
- CGParmDecl y4 TY_INTEGER
l2 CGLastParm
t3 CGTemp TY_UNSIGNED
SYM y5 name="total" base="total" pattern="_*" attr=0x0 seg=2
- CGAutoDecl y5 TY_UNSIGNED
SYM y6 name="i" base="i" pattern="_*" attr=0x0 seg=2
- CGAutoDecl y6 TY_INTEGER
l4 BENewLabel
l5 BENewLabel
- DBSrcCue f1 3 1
n6 CGFEName y5 TY_UNSIGNED
n7 CGInteger 0 TY_INTEGER
n8 CGAssign n6 n7 TY_UNSIGNED
- CGDone n8
- DBSrcCue f1 5 1
n9 CGFEName y6 TY_INTEGER
n10 CGInteger 0 TY_INTEGER
n11 CGAssign n9 n10 TY_INTEGER
- CGDone n11
- CGControl O_LABEL n0 l4
n12 CGFEName y6 TY_INTEGER
n13 CGUnary O_POINTS n12 TY_INTEGER
n14 CGFEName y4 TY_INTEGER
n15 CGUnary O_POINTS n14 TY_INTEGER
n16 CGCompare O_LT n13 n15 TY_INTEGER
- CGControl O_IF_FALSE n16 l5
- DBSrcCue f1 6 1
n17 CGFEName y5 TY_UNSIGNED
n18 CGFEName y2 TY_POINTER
n19 CGUnary O_POINTS n18 TY_POINTER
n20 CGFEName y6 TY_INTEGER
n21 CGUnary O_POINTS n20 TY_INTEGER
n22 CGBinary O_PLUS n19 n21 TY_POINTER
n23 CGUnary O_POINTS n22 TY_UINT_1
n24 CGFEName y3 TY_POINTER
n25 CGUnary O_POINTS n24 TY_POINTER
n26 CGFEName y6 TY_INTEGER
n27 CGUnary O_POINTS n26 TY_INTEGER
n28 CGBinary O_PLUS n25 n27 TY_POINTER
n29 CGUnary O_POINTS n28 TY_UINT_1
n30 CGBinary O_AND n23 n29 TY_INTEGER
n31 CGPreGets O_PLUS n17 n30 TY_UNSIGNED
- CGDone n31
n32 CGFEName y6 TY_INTEGER
n33 CGInteger 1 TY_INTEGER
n34 CGPostGets O_PLUS n32 n33 TY_INTEGER
- CGDone n34
- CGControl O_GOTO n0 l4
- CGControl O_LABEL n0 l5
- DBSrcCue f1 7 1
n35 CGFEName y5 TY_UNSIGNED
n36 CGUnary O_POINTS n35 TY_UNSIGNED
n37 CGUnary O_CONVERT n36 TY_UNSIGNED
n38 CGTempName t3 TY_UNSIGNED
n39 CGAssign n38 n37 TY_UNSIGNED
- CGDone n39
- DBSrcCue f1 8 1
n40 CGTempName t3 TY_UNSIGNED
n41 CGUnary O_POINTS n40 TY_UNSIGNED
- CGReturn n41 TY_UNSIGNED
STOP
FINI
