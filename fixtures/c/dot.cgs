INIT sw=0x808000 target=0xec size=50 rev=0x23
SEG 1 attr=0x7 name="_TEXT" align=1
SEG 2 attr=0x1c name="CONST" align=2
SEG 3 attr=0xc name="CONST2" align=2
SEG 4 attr=0x6 name="_DATA" align=2
START
f1 DBSrcFile "dot.c"
- DBSrcCue f1 1 1
SYM y1 name="dot" base="dot" pattern="_*" attr=0x7 seg=1
CALLCONV y1 class=0x80 target=0x716 parms=[] ret=0:0
- CGProcDecl y1 TY_INT_4
SYM y2 name="a" base="a" pattern="_*" attr=0x0 seg=2
- CGParmDecl y2 TY_POINTER
SYM y3 name="b" base="b" pattern="_*" attr=0x0 seg=2
- CGParmDecl y3 TY_POINTER
SYM y4 name="n" base="n" pattern="_*" attr=0x0 seg=2
- CGParmDecl y4 TY_INTEGER
l2 CGLastParm
t3 CGTemp TY_INT_4
SYM y5 name="total" base="total" pattern="_*" attr=0x0 seg=2
- CGAutoDecl y5 TY_INT_4
SYM y6 name="i" base="i" pattern="_*" attr=0x0 seg=2
- CGAutoDecl y6 TY_INTEGER
l4 BENewLabel
l5 BENewLabel
- DBSrcCue f1 3 1
n6 CGFEName y5 TY_INT_4
n7 CGInteger 0 TY_INTEGER
n8 CGAssign n6 n7 TY_INT_4
- CGDone n8
- DBSrcCue f1 5 1
n9 CGFEName y6 TY_INTEGER
n10 CGInteger 0 TY_INTEGER
n11 CGAssign n9 n10 TY_INTEGER
- CGDone n11
- CGControl O_LABEL n0 l4
n12 CGFEName y6 TY_INTEGER
n13 CGUnary O_POINTS n12 TY_INTEGER
n14 CGFEName y4 TY_INTEGER
n15 CGUnary O_POINTS n14 TY_INTEGER
n16 CGCompare O_LT n13 n15 TY_INTEGER
- CGControl O_IF_FALSE n16 l5
- DBSrcCue f1 6 1
n17 CGFEName y5 TY_INT_4
n18 CGFEName y2 TY_POINTER
n19 CGUnary O_POINTS n18 TY_POINTER
n20 CGFEName y6 TY_INTEGER
n21 CGUnary O_POINTS n20 TY_INTEGER
n22 CGInteger 2 TY_INTEGER
n23 CGBinary O_TIMES n21 n22 TY_INTEGER
n24 CGBinary O_PLUS n19 n23 TY_POINTER
n25 CGUnary O_POINTS n24 TY_INTEGER
n26 CGUnary O_CONVERT n25 TY_INT_4
n27 CGFEName y3 TY_POINTER
n28 CGUnary O_POINTS n27 TY_POINTER
n29 CGFEName y6 TY_INTEGER
n30 CGUnary O_POINTS n29 TY_INTEGER
n31 CGInteger 2 TY_INTEGER
n32 CGBinary O_TIMES n30 n31 TY_INTEGER
n33 CGBinary O_PLUS n28 n32 TY_POINTER
n34 CGUnary O_POINTS n33 TY_INTEGER
n35 CGBinary O_TIMES n26 n34 TY_INT_4
n36 CGPreGets O_PLUS n17 n35 TY_INT_4
- CGDone n36
n37 CGFEName y6 TY_INTEGER
n38 CGInteger 1 TY_INTEGER
n39 CGPostGets O_PLUS n37 n38 TY_INTEGER
- CGDone n39
- CGControl O_GOTO n0 l4
- CGControl O_LABEL n0 l5
- DBSrcCue f1 7 1
n40 CGFEName y5 TY_INT_4
n41 CGUnary O_POINTS n40 TY_INT_4
n42 CGUnary O_CONVERT n41 TY_INT_4
n43 CGTempName t3 TY_INT_4
n44 CGAssign n43 n42 TY_INT_4
- CGDone n44
- DBSrcCue f1 8 1
n45 CGTempName t3 TY_INT_4
n46 CGUnary O_POINTS n45 TY_INT_4
- CGReturn n46 TY_INT_4
STOP
FINI
