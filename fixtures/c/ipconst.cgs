l2 CGLastParm
t3 CGTemp TY_INT_2
- DBSrcCue f1 4 1
n4 CGInteger 37 TY_INT_2
n5 CGTempName t3 TY_INT_2
n6 CGAssign n5 n4 TY_INT_2
- CGDone n6
- DBSrcCue f1 5 1
n7 CGTempName t3 TY_INT_2
n8 CGUnary O_POINTS n7 TY_INT_2
