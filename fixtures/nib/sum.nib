fn sum(values: &[i16]) -> i16:
    let mut total: i16 = 0
    for value in &values:
        total += value
    return total

fn main() -> i16:
    let values: i16[6] = [1, 2, 3, 4, 5, 6]
    let result = sum(&values)
    if result == 21:
        print("ok")
    else:
        print("bad")
    return result
