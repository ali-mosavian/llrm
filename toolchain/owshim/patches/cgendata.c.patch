+/*
+ * qbopt: `value` as the 8087's 80-bit extended real, little-endian: a 64-bit
+ * mantissa with its integer bit explicit, then sign and 15-bit exponent.
+ */
+static void ExtendedImage( double value, char *image )
+{
+    unsigned long long  bits;
+    unsigned long long  mantissa;
+    unsigned            exponent;
+    int                 i;
+
+    memcpy( &bits, &value, sizeof( bits ) );
+    exponent = (unsigned)( bits >> 52 ) & 0x7FF;
+    mantissa = ( bits & 0xFFFFFFFFFFFFFULL ) << 11;
+    if( exponent == 0x7FF ) {
+        exponent = 0x7FFF;
+        mantissa |= 1ULL << 63;
+    } else if( exponent != 0 ) {
+        exponent += 16383 - 1023;
+        mantissa |= 1ULL << 63;
+    } else if( mantissa != 0 ) {
+        exponent = 16383 - 1022;
+        while( ( mantissa >> 63 ) == 0 ) {
+            mantissa <<= 1;
+            exponent--;
+        }
+    }
+    for( i = 0; i < 8; i++ ) {
+        image[i] = (char)( mantissa >> ( 8 * i ) );
+    }
+    image[8] = (char)exponent;
+    image[9] = (char)( ( exponent >> 8 ) | ( ( bits >> 63 ) << 7 ) );
+}
