+/*
+ * llrm: `__declspec( ... )`, and gcc's `__attribute__(( ... ))` spelled as it by the target's header: the words of
+ * one list, separated by commas or not. Also read after a declarator (InitDeclarator).
+ */
+void DeclspecClause( decl_info *info )
+{
+    type_modifiers      modifier;
+    declspec_class      decl;
+    int                 how;
+
+    AdvanceToken();                   // declspec( dllimport naked ) or attribute(( noinline, unused ))
+    MustRecog( T_LEFT_PAREN );
+    while( CurToken != T_RIGHT_PAREN ) {
+        modifier = 0;
+        switch( CurToken ) {
+        case T___WATCALL:
+            modifier = FLAG_WATCALL;
+            break;
+        case T__CDECL:
+        case T___CDECL:
+            modifier = FLAG_CDECL;
+            break;
+        case T__PASCAL:
+        case T___PASCAL:
+            modifier = FLAG_PASCAL;
+            break;
+        case T___FORTRAN:
+            modifier = FLAG_FORTRAN;
+            break;
+        case T__SYSCALL:
+        case T___SYSCALL:
+        case T__SYSTEM:
+            modifier = FLAG_SYSCALL;
+            break;
+        case T___STDCALL:
+            modifier = FLAG_STDCALL;
+            break;
+        case T__FASTCALL:
+        case T___FASTCALL:
+            modifier = FLAG_FASTCALL;
+            break;
+        case T__OPTLINK:
+            modifier = FLAG_OPTLINK;
+            break;
+        case T_COMMA:
+            break;
+        case T_ID:
+            how = attributeWord( &modifier );
+            if( how != 0 ) {
+                NextToken();
+                skipAttributeArguments();
+                if( how == 2 )
+                    info->decl_mod |= modifier;
+                continue;
+            }
+            decl = DECLSPEC_NONE;
+            if( info->stg == SC_NONE ) {
+                CErr1( ERR_INVALID_DECLARATOR );
+                break;
+            }
+            if( strcmp( Buffer, "dllimport" ) == 0 ) {
+                decl = DECLSPEC_DLLIMPORT;
+            } else if( strcmp( Buffer, "overridable" ) == 0 ) {
+                decl = DECLSPEC_DLLIMPORT;
+            } else if( strcmp( Buffer, "dllexport" ) == 0 ) {
+                decl = DECLSPEC_DLLEXPORT;
+            } else if( strcmp( Buffer, "thread" ) == 0 ) {
+                decl = DECLSPEC_THREAD;
+            } else if( strcmp( Buffer, "naked" ) == 0 ) {
+                if( info->naked ) {
+                    CErr1( ERR_INVALID_DECLSPEC );
+                } else {
+                    info->naked = true;
+                }
+            } else if( strcmp( Buffer, "aborts" ) == 0
+              || strcmp( Buffer, "__aborts" ) == 0 ) {
+                modifier = FLAG_ABORTS;
+            } else if( strcmp( Buffer, "noreturn" ) == 0
+              || strcmp( Buffer, "__noreturn" ) == 0
+              || strcmp( Buffer, "_Noreturn" ) == 0 ) {
+                modifier = FLAG_NORETURN;
+            } else if( strcmp( Buffer, "farss" ) == 0 ) {
+                modifier = FLAG_FARSS;
+            } else {
+                CErr1( ERR_INVALID_DECLSPEC );
+            }
+            if( decl != DECLSPEC_NONE ) {
+                if( info->decl == DECLSPEC_NONE ) {
+                    info->decl = decl;
+                } else {
+                    CErr1( ERR_INVALID_DECLSPEC );
+                }
+            }
+            break;
+        default:
+            CErr1( ERR_INVALID_DECLSPEC );
+            goto done;
+        }
+        if( modifier & MASK_LANGUAGES ) {
+            if( info->decl_mod & MASK_LANGUAGES ) {
+                CErr1( ERR_INVALID_DECLSPEC );
+            } else {
+                info->decl_mod |= modifier;
+            }
+        }
+        if( modifier & FLAG_ABORTS ) {
+            if( info->decl_mod & FLAG_ABORTS ) {
+                CErr1( ERR_INVALID_DECLSPEC );
+            } else {
+                info->decl_mod |= modifier;
+            }
+        }
+        if( modifier & FLAG_NORETURN ) {
+            info->decl_mod |= modifier;
+        }
+        if( modifier & FLAG_FARSS ) {
+            if( info->decl_mod & FLAG_FARSS ) {
+                CErr1( ERR_INVALID_DECLSPEC );
+            } else {
+                info->decl_mod |= modifier;
+            }
+        }
+        NextToken();
+    }
+ done:
+    MustRecog( T_RIGHT_PAREN );
+}
