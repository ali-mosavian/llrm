+/*
+ * llrm: skip the arguments of an attribute that has any: `format(printf,1,2)`, `aligned(16)`.
+ */
+static void skipAttributeArguments( void )
+{
+    unsigned    depth;
+
+    if( CurToken != T_LEFT_PAREN )
+        return;
+    depth = 0;
+    do {
+        if( CurToken == T_LEFT_PAREN ) {
+            ++depth;
+        } else if( CurToken == T_RIGHT_PAREN ) {
+            --depth;
+        } else if( CurToken == T_EOF ) {
+            return;
+        }
+        NextToken();
+    } while( depth != 0 );
+}
