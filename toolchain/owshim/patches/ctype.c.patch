+/*
+ * llrm: gcc's attributes that state what a routine does and what it is not to be (spelled with or without the
+ * underscores gcc allows around a name). noinline and always_inline are facts; the others change no meaning if left out. 0 for a name
+ * that is not one of these, 1 for one that states nothing llrm uses, 2 for one that sets `*modifier`.
+ * An attribute that changes the program (packed, aligned, section, weak, alias...) is none of these, so it is an error.
+ */
+static int attributeWord( type_modifiers *modifier )
+{
+    static const char * const harmless[] = {
+        "unused", "used", "cold", "hot", "flatten", "noclone", "noipa", "noplt", "nothrow", "leaf", "pure", "const",
+        "malloc", "warn_unused_result", "deprecated", "format", "format_arg", "nonnull", "returns_nonnull", "sentinel",
+        "visibility", "artificial", "no_instrument_function", "no_sanitize", "no_sanitize_address",
+        "no_stack_protector", "optimize", "target", "externally_visible", "no_reorder", "fallthrough", "alloc_size"
+    };
+    char        name[64];
+    size_t      len;
+    size_t      i;
+
+    len = strlen( Buffer );
+    if( len > 4 && Buffer[0] == '_' && Buffer[1] == '_' && Buffer[len - 1] == '_' && Buffer[len - 2] == '_' ) {
+        len -= 4;
+        if( len >= sizeof( name ) )
+            return( 0 );
+        memcpy( name, Buffer + 2, len );
+        name[len] = '\0';
+    } else {
+        if( len >= sizeof( name ) )
+            return( 0 );
+        memcpy( name, Buffer, len + 1 );
+    }
+    if( strcmp( name, "noinline" ) == 0 ) {
+        *modifier = LLRM_FLAG_NOINLINE;
+        return( 2 );
+    }
+    if( strcmp( name, "always_inline" ) == 0 ) {
+        *modifier = LLRM_FLAG_ALWAYSINLINE;
+        return( 2 );
+    }
+    if( strcmp( name, "noreturn" ) == 0 ) {
+        *modifier = FLAG_NORETURN;
+        return( 2 );
+    }
+    for( i = 0; i < sizeof( harmless ) / sizeof( harmless[0] ); ++i ) {
+        if( strcmp( name, harmless[i] ) == 0 ) {
+            return( 1 );
+        }
+    }
+    return( 0 );
+}
